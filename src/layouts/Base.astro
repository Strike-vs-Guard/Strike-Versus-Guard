---
import '../styles/global.css';
import { getEntry, getCollection } from 'astro:content';
import { widePlate } from '../lib/logo';
import { url, isPreview, previewPr } from '../lib/url';
import Wordmark from '../components/Wordmark.astro';
import PartnersMenu from '../components/PartnersMenu.astro';

interface Props {
  title?: string;
  description?: string;
}

const site = (await getEntry('site', 'main'))!.data;
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title}: ${site.tagline}`;
const path = Astro.url.pathname;
const navBefore = [
  { href: url('updates/'), label: 'Updates' },
  { href: url('research/'), label: 'Research' },
];
const navAfter = [
  { href: url('flights/'), label: 'Flights' },
  { href: url('publications/'), label: 'Publications' },
];
/* A page is current when its path starts with the nav link's path (anchors on the home page never are). */
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
const funder = partners.find((p) => p.data.role === 'Funding sponsor');
const logoPartners = partners.filter((p) => p !== funder);
/* The partner's own file, e.g. content/partners/NUS.md, and its edit link on GitHub (development branch). */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Both themes are ours: stops phone browsers from force-darkening the light theme. -->
    <meta name="color-scheme" content="light dark" />
    <!-- Browser-bar colour: follows the system until a theme is stored, then follows the site (script below). -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1622" media="(prefers-color-scheme: dark)" />
    <!-- Apply the stored theme before first paint; with nothing stored the CSS follows the system. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
            document.querySelectorAll('meta[name=theme-color]').forEach(function (m) {
              m.removeAttribute('media');
              m.content = t === 'dark' ? '#0b1622' : '#ffffff';
            });
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@700&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;600&display=swap"
    />
  </head>
  <body>
    {
      isPreview && (
        <div class="preview-banner" role="note">
          <strong>Test site{previewPr ? ` (pull request #${previewPr})` : ', built from the development branch'}.</strong>{' '}
          This is not the live site. Changes go live only when development is merged into main.
        </div>
      )
    }
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href={url()} class="site-header__brand" aria-label={`${site.title}, home`}>
          <Wordmark size="md" />
        </a>
        <nav aria-label="Main" class="site-header__nav">
          <ul class="site-nav">
            {
              navBefore.map((n) => (
                <li>
                  <a class="nav-link" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
            <PartnersMenu partners={partners} current={isCurrent(url('partners/'))} path={path} />
            {
              navAfter.map((n) => (
                <li>
                  <a class="nav-link" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
          <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
          </svg>
          <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="logo-strip">
          <ul class="logo-strip__row" aria-label="Partners">
            {
              logoPartners.map((p) => (
                <li>
                  <a href={p.data.page ? url(`partners/${p.id}/`) : p.data.website} title={p.data.institution} class="logo-well">
                    <img {...widePlate(p)} loading="lazy" decoding="async" />
                  </a>
                </li>
              ))
            }
          </ul>
          {
            funder && (
              <a class="logo-strip__funder" href={funder.data.website ?? url('partners/#funder')} title={funder.data.institution}>
                <span>Funded by</span>
                <span class="logo-well logo-strip__funder-well">
                  <img {...widePlate(funder)} loading="lazy" decoding="async" />
                </span>
              </a>
            )
          }
        </div>
        <div class="site-footer__cols">
          <p class="site-footer__note">{site.footerNote}</p>
          <div>
            <h2 class="site-footer__h" id="footer-site">Site</h2>
            <ul class="site-footer__links" aria-labelledby="footer-site">
              <li><a href={url('updates/')}>Updates</a></li>
              <li><a href={url('research/')}>Research</a></li>
              <li><a href={url('partners/')}>Partners</a></li>
              <li><a href={url('flights/')}>Flights</a></li>
              <li><a href={url('publications/')}>Publications</a></li>
              <li><a href={site.repository}>Source on GitHub</a></li>
            </ul>
          </div>
        </div>
        <p class="site-footer__small">© {new Date().getFullYear()} Strike vs Guard programme partners.</p>
      </div>
    </footer>

    <script>
      /* Theme toggle: flips data-theme, stores it, and keeps the label naming the theme it switches to. */
      const root = document.documentElement;
      const system = window.matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.getAttribute('data-theme') ?? (system.matches ? 'dark' : 'light');
      document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
        const label = () => btn.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        label();
        system.addEventListener('change', label);
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          document.querySelectorAll<HTMLMetaElement>('meta[name=theme-color]').forEach((m) => {
            m.removeAttribute('media');
            m.content = next === 'dark' ? '#0b1622' : '#ffffff';
          });
          try {
            localStorage.setItem('theme', next);
          } catch {
            /* private mode: the choice lasts for this page only */
          }
          document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.dispatchEvent(new Event('theme-change')));
        });
        btn.addEventListener('theme-change', label);
      });
    </script>
  </body>
</html>

<style>
  .preview-banner {
    background: var(--surface);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    font-size: var(--step-0);
    padding: 10px var(--gutter);
    text-align: center;
  }
  .skip:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    padding: 8px 12px;
    background: var(--surface);
    z-index: 100;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Solid, not translucent: the build keeps only the -webkit- form of backdrop-filter, which Chrome
       ignores, so a see-through header let page text ghost through it on Android. */
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    /* The Partners panel is positioned against this row. */
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
  }
  .site-header__brand {
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-header__nav {
    margin-left: auto;
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav :global(.nav-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-size: var(--step-0);
    font-weight: 600;
    text-decoration: none;
    color: var(--muted);
    white-space: nowrap;
  }
  .site-nav :global(.nav-link:hover),
  .site-nav :global(.nav-link[aria-current='page']) {
    color: var(--text);
  }
  /* the current page is marked by an underline as well as colour */
  .site-nav :global(.nav-link[aria-current='page']) {
    text-decoration: underline;
    text-decoration-color: var(--brand-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .theme-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--muted);
  }
  /* sun in light, moon in dark */
  .theme-toggle__moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__moon {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle__sun {
      display: none;
    }
  }
  /* narrower screens: wordmark and toggle on the first row, the nav wraps underneath */
  @media (max-width: 1000px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'brand toggle' 'nav nav';
      gap: 0 12px;
      padding-top: 10px;
    }
    .site-header__brand {
      grid-area: brand;
    }
    .theme-toggle {
      grid-area: toggle;
    }
    .site-header__nav {
      grid-area: nav;
      margin-left: -10px;
    }
  }
  @media (max-width: 480px) {
    .site-nav :global(.nav-link) {
      padding: 0 8px;
    }
  }

  /*
   * Footer: a brand-blue band in both themes (--band tokens, global.css), so its tokens are set here. The band is dark, so
   * logos are white 2:1 plates (src/lib/logo.ts) in both themes (ST, NUS, UPenn, CMU), then "Funded by" HTX, smaller and set apart.
   */
  .site-footer {
    --text: var(--band-text);
    --muted: var(--band-muted);
    --link: var(--band-text);
    --border: rgb(255 255 255 / 0.2);
    --well-border: transparent;
    --well-bg: var(--well);
    --brand-red: var(--band-accent);
    background: var(--band);
    color: var(--text);
    padding-block: 48px 32px;
    font-size: var(--step-0);
  }
  .logo-strip {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0 0 40px;
  }
  .logo-strip__row {
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* tiles 198 px wide at most (99 px tall), spread across the row */
    grid-template-columns: repeat(4, minmax(0, 198px));
    justify-content: space-between;
    gap: 12px;
  }
  .logo-strip__funder {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 24px;
    border-left: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step--1);
    text-decoration: none;
    white-space: nowrap;
  }
  .logo-strip__funder:hover {
    color: var(--text);
  }
  .logo-strip__funder-well {
    width: 132px;
  }
  @media (max-width: 900px) {
    .logo-strip {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }
    .logo-strip__row {
      grid-template-columns: repeat(2, minmax(0, 198px));
      justify-content: start;
    }
    .logo-strip__funder {
      align-self: flex-start;
      padding-left: 0;
      border-left: 0;
    }
  }
  .site-footer__cols {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 800px) {
    .site-footer__cols {
      grid-template-columns: 1.2fr 1fr;
      gap: 40px;
    }
  }
  .site-footer__note {
    color: var(--muted);
    max-width: 48ch;
  }
  .site-footer__h {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .site-footer__small {
    color: var(--muted);
    font-size: var(--step--1);
    margin: 32px 0 0;
  }
</style>
