---
import '../styles/global.css';
import { getEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url, isPreview, previewPr } from '../lib/url';
import Wordmark from '../components/Wordmark.astro';
import PartnersMenu from '../components/PartnersMenu.astro';

interface Props {
  title?: string;
  description?: string;
}

const site = (await getEntry('site', 'main'))!.data;
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title}: ${site.tagline}`;
const path = Astro.url.pathname;
const navBefore = [{ href: url('programme/'), label: 'Programme' }];
const navAfter = [
  { href: url('flights/'), label: 'Flights' },
  { href: url('updates/'), label: 'Updates' },
];
/* A page is current when its path starts with the nav link's path (anchors on the home page never are). */
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
const funder = partners.find((p) => p.data.role === 'Funding sponsor');
const logoPartners = partners.filter((p) => p !== funder);
/*
 * Footer logos are sized by visual weight (see .logo-well in global.css): height = 60 px × 1/√(width÷height),
 * 10 % less for square solid-colour tiles, capped at the well's 74 px inner height.
 */
const LOGO_BASE = 60;
const LOGO_MAX = 74;
const logoSize = (img: ImageMetadata) => {
  const ar = img.width / img.height;
  const k = (Math.abs(ar - 1) < 0.02 ? 0.9 : 1) / Math.sqrt(ar);
  return { style: `--logo-k:${k.toFixed(3)}`, height: Math.ceil(Math.min(LOGO_BASE * k, LOGO_MAX)) };
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans+Condensed:wght@400;700&family=IBM+Plex+Sans:wght@400;600&display=swap"
    />
  </head>
  <body>
    {
      isPreview && (
        <div class="preview-banner" role="note">
          <strong>Test site{previewPr ? ` (pull request #${previewPr})` : ', built from the development branch'}.</strong>{' '}
          This is not the live site. Changes go live only when development is merged into main.
        </div>
      )
    }
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href={url()} class="site-header__brand" aria-label={`${site.title}, home`}>
          <Wordmark size="sm" />
        </a>
        <nav aria-label="Main">
          <ul class="site-nav">
            {
              navBefore.map((n) => (
                <li>
                  <a class="nav-link" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
            <PartnersMenu partners={partners} current={isCurrent(url('partners/'))} path={path} />
            {
              navAfter.map((n) => (
                <li>
                  <a class="nav-link" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="logo-strip">
          {
            funder && (
              <div class="logo-strip__group">
                <p class="eyebrow" id="logo-strip-funder">Funded by</p>
                <ul class="logo-strip__row logo-strip__row--funder" aria-labelledby="logo-strip-funder">
                  <li>
                    <a href={funder.data.website ?? url('partners/#funder')} title={funder.data.institution} class="logo-well logo-strip__item">
                      <Image src={funder.data.logo} alt={funder.data.logoAlt ?? funder.data.institution} {...logoSize(funder.data.logo)} densities={[1, 2]} />
                    </a>
                  </li>
                </ul>
              </div>
            )
          }
          <span class="logo-strip__divider" aria-hidden="true"></span>
          <div class="logo-strip__group">
            <p class="eyebrow" id="logo-strip-partners">Partners</p>
            <ul class="logo-strip__row" aria-labelledby="logo-strip-partners">
              {
                logoPartners.map((p) => (
                  <li>
                    <a
                      href={p.data.page ? url(`partners/${p.id}/`) : p.data.website}
                      title={p.data.institution}
                      class="logo-well logo-strip__item logo-strip__item--pair"
                    >
                      <span class="logo-well__half">
                        <Image src={p.data.logo} alt={p.data.logoAlt ?? p.data.institution} {...logoSize(p.data.logo)} densities={[1, 2]} />
                      </span>
                      {p.data.labLogo && (
                        <>
                          <span class="logo-well__rule" aria-hidden="true"></span>
                          <span class="logo-well__half">
                            <Image src={p.data.labLogo} alt={p.data.lab ?? ''} {...logoSize(p.data.labLogo)} densities={[1, 2]} />
                          </span>
                        </>
                      )}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="site-footer__cols">
          <p class="site-footer__note">{site.footerNote}</p>
          <ul class="site-footer__links">
            <li><a href={url('programme/')}>Programme</a></li>
            <li><a href={url('flights/')}>Flights</a></li>
            <li><a href={url('partners/')}>Partners</a></li>
            {
              partners
                .filter((p) => p.data.page)
                .map((p) => (
                  <li>
                    <a href={url(`partners/${p.id}/`)}>{p.data.short}</a>
                  </li>
                ))
            }
            <li><a href={url('updates/')}>Updates</a></li>
            <li><a href={`${site.repository}/blob/main/CONTRIBUTING.md`}>Edit this site</a></li>
          </ul>
        </div>
        <p class="site-footer__small">© {new Date().getFullYear()} Strike vs Guard programme partners.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .preview-banner {
    background: var(--surface);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    font-size: var(--step-0);
    padding: 10px var(--gutter);
    text-align: center;
  }
  .skip:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    padding: 8px 12px;
    background: var(--surface);
    z-index: 100;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    /* The Partners panel is positioned against this row. */
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
  }
  .site-header__brand {
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav :global(.nav-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--muted);
    white-space: nowrap;
  }
  .site-nav :global(.nav-link:hover),
  .site-nav :global(.nav-link[aria-current='page']) {
    color: var(--text);
  }
  @media (max-width: 720px) {
    .site-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 10px;
    }
    .site-nav {
      margin-inline: -10px;
      gap: 0;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: 48px 32px;
    font-size: var(--step-0);
  }
  /*
   * Logos in colour, in equal white wells: the funder, a divider, then the partners in a 2 × 2 grid
   * (four 288 px wells never fit beside the funder inside --max). Each partner well holds the
   * institution and its lab. Heights per logo come from logoSize() above.
   */
  .logo-strip {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 24px;
    margin: 0 0 40px;
  }
  .logo-strip__group .eyebrow {
    margin-bottom: 10px;
  }
  .logo-strip__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 288px);
    gap: 12px;
  }
  .logo-strip__divider {
    width: 1px;
    background: var(--border);
  }
  .logo-strip__item {
    --logo-base: 60px;
    --logo-max: 74px;
    width: 220px;
    height: 100px;
    padding: 12px 16px;
  }
  .logo-strip__item--pair {
    width: 288px;
  }
  .logo-strip__row--funder {
    grid-template-columns: 220px;
  }
  @media (max-width: 1040px) {
    .logo-strip {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }
    .logo-strip__divider {
      width: 100%;
      height: 1px;
    }
    .logo-strip__group {
      text-align: center;
    }
  }
  /* Phones: one well per row, full width. */
  @media (max-width: 680px) {
    .logo-strip {
      align-items: stretch;
    }
    .logo-strip__group {
      text-align: left;
    }
    .logo-strip__row,
    .logo-strip__row--funder {
      grid-template-columns: 1fr;
    }
    .logo-strip__item,
    .logo-strip__item--pair {
      width: auto;
    }
  }
  .site-footer__cols {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 800px) {
    .site-footer__cols {
      grid-template-columns: 2fr 1fr;
    }
  }
  .site-footer__note {
    color: var(--muted);
    max-width: 60ch;
  }
  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-content: flex-start;
  }
  .site-footer__small {
    color: var(--muted);
    font-size: var(--step--1);
    margin: 32px 0 0;
  }
</style>
