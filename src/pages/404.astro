---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
/** Only the root site answers for unknown paths, so only that build carries the old-address redirect. */
const atRoot = import.meta.env.BASE_URL === '/';
---

<Base title="Page not found">
  {
    atRoot && (
      <script is:inline>
        /* The site used to live under /Strike-Versus-Guard/. Send old links to the same page at the root. */
        (function () {
          var old = '/strike-versus-guard';
          var p = location.pathname;
          var l = p.toLowerCase();
          if (l === old || l.indexOf(old + '/') === 0) location.replace((p.slice(old.length) || '/') + location.search + location.hash);
        })();
      </script>
    )
  }
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page has drifted out of the flight area.</h1>
      <p><a class="btn" href={url()}>Back to the home page</a></p>
    </div>
  </section>
</Base>
