---
/**
 * One update post. Posts may sit in per-partner folders (content/updates/<partner>/…), so the id can
 * contain a slash, hence the rest parameter. Shows the author and partner, the lead image, the body,
 * the `gallery:` as a photo strip with captions, and the optional `link:`.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { fmtDate } from '../../lib/text';

export async function getStaticPaths() {
  const updates = await getCollection('updates', (u) => !u.data.draft);
  return updates.map((u) => ({ params: { id: u.id }, props: { update: u } }));
}
const { update } = Astro.props;
const d = update.data;
const { Content } = await render(update);
const partners = await getCollection('partners');
const p = partners.find((x) => x.id === d.partner);
---

<Base title={d.title} description={d.summary}>
  <article class="section post">
    <div class="wrap">
      <header class="post-head">
        <p class="eyebrow">
          <a href={url('updates/')}>Updates</a> / <time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date, 'long')}</time>
        </p>
        <h1>{d.title}</h1>
        <p class="muted post-by">
          {d.author && <>By {d.author}, </>}
          {p && p.data.page ? <a href={url(`partners/${p.id}/`)}>{p.data.short}</a> : p?.data.short}
        </p>
      </header>
      {d.image && <Image class="post-image" src={d.image} alt={d.imageAlt ?? ''} widths={[600, 1000]} sizes="(min-width: 760px) 720px, 100vw" />}
      <div class="md prose"><Content /></div>
      {
        d.gallery.length > 0 && (
          <ul class="post-gallery" aria-label="Photos">
            {d.gallery.map((g) => (
              <li>
                <figure>
                  <Image src={g.src} alt={g.alt} widths={[400, 800]} sizes="(min-width: 760px) 360px, 80vw" />
                  {g.caption && <figcaption>{g.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        )
      }
      {
        d.link && (
          <p class="post-link">
            <a class="arrow-link" href={d.link}>
              {d.linkLabel ?? 'Read more'} →
            </a>
          </p>
        )
      }
      <p class="post-back"><a href={url(`updates/?partner=${d.partner}`)}>More from {p?.data.short ?? d.partner} →</a></p>
    </div>
  </article>
</Base>

<style>
  .post-head {
    max-width: 68ch;
    margin-bottom: 32px;
  }
  .post-head h1 {
    font-size: var(--step-5);
  }
  .eyebrow a {
    text-decoration: none;
  }
  .post :global(.post-image) {
    display: block;
    border-radius: var(--radius);
    margin-bottom: 32px;
    max-width: 45rem;
    width: 100%;
    height: auto;
  }
  .post-gallery {
    list-style: none;
    margin: 40px 0 0;
    padding: 0 0 8px;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .post-gallery li {
    flex: 0 0 min(360px, 80%);
    scroll-snap-align: start;
  }
  .post-gallery figure {
    margin: 0;
  }
  .post-gallery :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .post-gallery figcaption {
    margin-top: 8px;
    font-size: var(--step-0);
    color: var(--muted);
  }
  .post-link {
    margin: 32px 0 0;
  }
  .post-back {
    margin: 32px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    max-width: 68ch;
    font-size: var(--step-0);
  }
</style>
