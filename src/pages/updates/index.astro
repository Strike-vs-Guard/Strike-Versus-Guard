---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import UpdateLog from '../../components/UpdateLog.astro';

const updates = (await getCollection('updates', (u) => !u.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Updates" description="News and progress from the Strike vs Guard programme partners.">
  <section class="section">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Updates</p>
        <h1 class="h1">News and progress</h1>
        <p class="lede muted">Short posts from the programme partners on flights, results and publications.</p>
      </header>
      <UpdateLog updates={updates} heading="h2" />
    </div>
  </section>
</Base>

<style>
  .h1 {
    font-family: var(--font-display);
    font-size: var(--step-hero);
  }
</style>
