---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const updates = await getCollection('updates', (u) => !u.data.draft);
  return updates.map((u) => ({ params: { id: u.id }, props: { update: u } }));
}
const { update } = Astro.props;
const { Content } = await render(update);
const partners = await getCollection('partners');
const p = partners.find((x) => x.id === update.data.partner);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={update.data.title} description={update.data.summary}>
  <article class="section">
    <div class="wrap">
      <header class="post-head">
        <p class="eyebrow">
          <a href={url('updates/')}>Updates</a> / <time datetime={update.data.date.toISOString().slice(0, 10)}>{fmt(update.data.date)}</time>
        </p>
        <h1>{update.data.title}</h1>
        <p class="muted post-by">
          {update.data.author && `By ${update.data.author}, `}
          {p && p.data.page ? <a href={url(`partners/${p.id}/`)}>{p.data.short}</a> : p?.data.short}
        </p>
      </header>
      {
        update.data.image && (
          <Image class="post-image" src={update.data.image} alt={update.data.imageAlt ?? ''} widths={[600, 1000]} sizes="(min-width: 760px) 720px, 100vw" />
        )
      }
      <div class="md prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .post-head {
    max-width: 68ch;
    margin-bottom: 32px;
  }
  .post-head h1 {
    font-family: var(--font-display);
    font-size: var(--step-5);
  }
  .eyebrow a {
    text-decoration: none;
  }
  :global(.post-image) {
    border-radius: var(--radius);
    margin-bottom: 32px;
    max-width: 720px;
    width: 100%;
  }
</style>
