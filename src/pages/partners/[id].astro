---
/**
 * One page per partner, built from content/partners/<PARTNER>.md.
 * The layout is shared; each partner only edits their own Markdown file. The top line names that file
 * with an Edit link; then the head, people, the partner's own text, "Updates from <Short>" (always shown;
 * empty → "No posts yet. Post one →") and its publications. The layer drawing lives on the home page.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { logoSize } from '../../lib/logo';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { fmtDate } from '../../lib/text';
import PubList from '../../components/sections/PubList.astro';
import { allUpdates, fileName, peopleGroups } from '../../components/sections/data';

export async function getStaticPaths() {
  const partners = await getCollection('partners', (p) => p.data.page);
  return partners.map((p) => ({ params: { id: p.id }, props: { partner: p } }));
}

const { partner } = Astro.props;
const d = partner.data;
const { Content } = await render(partner);
const all = (await getCollection('partners', (p) => p.data.page)).sort((a, b) => a.data.order - b.data.order);
const updates = (await allUpdates()).filter((u) => u.data.partner === partner.id);
const site = (await getEntry('site', 'main'))!.data;
const repo = site.repository.replace(/\/$/, '');
const filePath = `content/partners/${fileName(partner)}`;
const editUrl = `${repo}/edit/development/${filePath}`;
const pubs = [...d.publications].sort((a, b) => b.year - a.year);
/* Head logos: base 106 px, capped at the well's 132 px inner height (src/lib/logo.ts). */
const logo = (img: ImageMetadata) => logoSize(img, 106, 132);
const people = d.people ?? [];
const initials = (name: string) =>
  name
    .replace(/^(Prof|Dr|Mr|Ms|Mrs|Assoc Prof|Asst Prof)\.?\s+/i, '')
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .filter((c) => /[A-Za-z]/.test(c))
    .slice(0, 2)
    .join('')
    .toUpperCase();
const layerNames: Record<string, string> = {
  strategy: 'Strategy',
  safety: 'Safety',
  flight: 'Flight',
  localisation: 'Localisation',
  drones: 'Drones',
  integration: 'Integration',
};
---

<Base title={`${d.short}${d.lab ? ' ' + d.lab : ''}`} description={d.summary}>
  <article class="partner-page">
    <p class="pp-own">
      <span class="wrap pp-own__in">
        <span>
          This is {d.short}'s own page and file: <code>{filePath}</code>
        </span>
        <a href={editUrl}>Edit<span class="visually-hidden"> {d.short}'s file</span></a>
      </span>
    </p>
    <header class="pp-head">
      <div class="wrap pp-head__grid">
        <div>
          <p class="eyebrow"><a href={url('partners/')}>Partners</a> / {d.institution}</p>
          <h1>{d.lab ? `${d.short} ${d.lab}` : d.short}</h1>
          <p class="pp-inst">{d.labFull ? `${d.labFull}, ${d.institution}` : d.institution}</p>
          <p class="lede">{d.summary}</p>
          <div class="logo-well pp-logos">
            <span class="logo-well__half">
              <Image src={d.logo} alt={d.logoAlt ?? d.institution} {...logo(d.logo)} densities={[1, 2]} />
            </span>
            {
              d.labLogo && (
                <>
                  <span class="logo-well__rule" aria-hidden="true"></span>
                  <span class="logo-well__half">
                    <Image src={d.labLogo} alt={d.lab ?? ''} {...logo(d.labLogo)} densities={[1, 2]} />
                  </span>
                </>
              )
            }
          </div>
        </div>
        <aside class="card pp-meta" aria-label="At a glance">
          <dl>
            {d.lead && (<div><dt>Lead</dt><dd>{d.lead}</dd></div>)}
            <div><dt>Contribution</dt><dd>{d.contribution}</dd></div>
            {
              Object.keys(d.work).length > 0 && (
                <div>
                  <dt>Works on</dt>
                  <dd>
                    <ul class="pp-work">
                      {Object.entries(d.work).map(([k, v]) => (
                        <li>
                          <strong>{layerNames[k]}:</strong> {v}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
            {d.website && (<div><dt>Website</dt><dd><a href={d.website}>{new URL(d.website).hostname.replace(/^www\./, '')}</a></dd></div>)}
            {d.contact && (<div><dt>Contact</dt><dd><a href={`mailto:${d.contact}`}>{d.contact}</a></dd></div>)}
            <div>
              <dt>Page</dt>
              <dd>
                Maintained by {d.short} · updated {fmtDate(d.updated, 'long')} ·{' '}
                <a href={editUrl}>Edit this page</a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </header>

    {
      people.length > 0 && (
        <section class="pp-people" aria-labelledby="pp-people-h">
          <div class="wrap">
            <h2 id="pp-people-h" class="eyebrow">People</h2>
            {peopleGroups(people).map(({ group, people: row }) => (
              <>
                {group && <h3 class="pp-people__group">{group}</h3>}
                <ul class="pp-people__row">
                  {row.map((m) => (
                    <li class="pp-person">
                      {m.photo ? (
                        <Image class="pp-person__face" src={m.photo} alt={m.name} width={72} height={72} densities={[1, 2]} />
                      ) : (
                        <span class="pp-person__face pp-person__initials" aria-hidden="true">
                          {initials(m.name)}
                        </span>
                      )}
                      <span class="pp-person__name">{m.name}</span>
                      {m.role && <span class="pp-person__role">{m.role}</span>}
                      {m.lead && <span class="pp-person__tag">Lead</span>}
                    </li>
                  ))}
                </ul>
              </>
            ))}
          </div>
        </section>
      )
    }

    <div class="wrap pp-body">
      <div class="md prose"><Content /></div>

      <section class="pp-updates" id="updates" aria-labelledby="pp-updates-h">
        <h2 id="pp-updates-h">Updates from {d.short}</h2>
        {
          updates.length > 0 ? (
            <ul>
              {updates.map((u) => (
                <li>
                  <time datetime={u.data.date.toISOString().slice(0, 10)}>{fmtDate(u.data.date, 'short')}</time>
                  <span class="pp-updates__main">
                    <a href={url(`updates/${u.id}/`)}>{u.data.title}</a>
                    {u.data.author && <span class="muted"> · {u.data.author}</span>}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="pp-none">
              No posts yet. <a href={url('contribute/#update')}>Post one →</a>
            </p>
          )
        }
      </section>

      <section class="pp-pubs" id="publications" aria-labelledby="pp-pubs-h">
        <h2 id="pp-pubs-h">Publications</h2>
        {
          pubs.length > 0 ? (
            <PubList pubs={pubs.map((pub) => ({ pub }))} images />
          ) : (
            <p class="pp-none">
              None yet. <a href={url('contribute/#publication')}>Add one →</a>
            </p>
          )
        }
      </section>

      <footer class="pp-foot">
        <nav aria-label="Other partners" class="pp-others">
          {
            all
              .filter((p) => p.id !== partner.id)
              .map((p) => (
                <a class="chip" href={url(`partners/${p.id}/`)}>
                  {p.data.short}
                </a>
              ))
          }
        </nav>
      </footer>
    </div>
  </article>
</Base>

<style>
  .pp-own {
    margin: 0;
    background: var(--band);
    color: var(--band-text);
    font-size: var(--step-0);
  }
  .pp-own__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 16px;
    min-height: 44px;
    padding-block: 4px;
  }
  .pp-own code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }
  .pp-own a {
    color: #fff;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .pp-head {
    padding-block: clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .pp-head__grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .pp-head__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
  }
  .pp-head h1 {
    font-family: var(--font-display);
    font-size: var(--step-hero);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .pp-inst {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .eyebrow a {
    text-decoration: none;
  }
  .pp-meta {
    padding: 20px;
    background: var(--bg);
    box-shadow: none;
  }
  /* One wide well under the lede: institution left, hairline, lab right. */
  .pp-logos {
    --logo-base: 106px;
    --logo-max: 132px;
    width: fit-content;
    min-width: min(100%, 440px);
    max-width: 100%;
    height: 164px;
    margin-top: 28px;
    padding: 16px 40px;
    gap: 28px;
  }
  @media (max-width: 520px) {
    .pp-logos {
      --logo-max: 96px;
      height: 128px;
      padding: 16px 14px;
      gap: 14px;
    }
  }
  .pp-meta dl {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .pp-meta dt {
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .pp-meta dd {
    margin: 2px 0 0;
    font-size: var(--step-0);
  }
  .pp-work {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .pp-people {
    padding-block: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--border);
  }
  .pp-people h2 {
    margin: 0 0 20px;
  }
  .pp-people__row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 28px 24px;
  }
  .pp-person {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }
  .pp-people__group {
    margin: 32px 0 16px;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--muted);
  }
  .pp-person :global(.pp-person__face) {
    flex: none;
    width: 72px;
    height: 72px;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .pp-person__initials {
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--muted);
    font: 500 var(--step-0) var(--font-mono);
    letter-spacing: 0.06em;
  }
  .pp-person__name {
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .pp-person__role {
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    line-height: 1.4;
  }
  .pp-person__tag {
    margin-top: 4px;
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1px 8px;
    border: 1px solid var(--text);
    border-radius: 999px;
  }
  .pp-body {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .pp-updates,
  .pp-pubs {
    margin-top: 48px;
    max-width: 880px;
    scroll-margin-top: 80px;
  }
  .pp-none {
    font-size: var(--step-1);
    margin: 0;
  }
  .pp-updates__main {
    flex: 1;
    min-width: 0;
  }
  .pp-updates h2,
  .pp-pubs h2 {
    font-size: var(--step-4);
  }
  .pp-updates ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pp-updates li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .pp-updates time {
    font: 500 var(--step--1) var(--font-mono);
    color: var(--muted);
    min-width: 12ch;
    padding-top: 3px;
  }
  .pp-foot {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 16px;
    font-size: var(--step-0);
  }
  .pp-others {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
