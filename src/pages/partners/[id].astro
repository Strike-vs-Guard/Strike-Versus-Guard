---
/**
 * One page per partner, built from content/partners/<PARTNER>.md.
 * The layout is shared; each partner only edits their own Markdown file.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { logoSize } from '../../lib/logo';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { getSystemData } from '../../lib/system';
import DroneDiagram from '../../components/DroneDiagram.astro';

export async function getStaticPaths() {
  const partners = await getCollection('partners', (p) => p.data.page);
  return partners.map((p) => ({ params: { id: p.id }, props: { partner: p } }));
}

const { partner } = Astro.props;
const d = partner.data;
const { Content } = await render(partner);
const system = await getSystemData();
const worksOn = system.layers.filter((l) => (d.work as Record<string, string | undefined>)[l.id]);
const listWords = (a: string[]) => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`);
const all = (await getCollection('partners', (p) => p.data.page)).sort((a, b) => a.data.order - b.data.order);
const updates = (await getCollection('updates', (u) => !u.data.draft && u.data.partner === partner.id)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const repo = 'https://github.com/Strike-vs-Guard/Strike-Versus-Guard';
const fileName = partner.filePath?.split('/').pop();
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
/* Head logos: base 76 px, capped at the well's 94 px inner height (src/lib/logo.ts). */
const logo = (img: ImageMetadata) => logoSize(img, 76, 94);
const people = d.people ?? [];
const initials = (name: string) =>
  name
    .replace(/^(Prof|Dr|Mr|Ms|Mrs|Assoc Prof|Asst Prof)\.?\s+/i, '')
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .filter((c) => /[A-Za-z]/.test(c))
    .slice(0, 2)
    .join('')
    .toUpperCase();
const layerNames: Record<string, string> = {
  strategy: 'Strategy',
  safety: 'Safety',
  flight: 'Flight',
  localisation: 'Localisation',
  drones: 'Drones',
  integration: 'Integration',
};
---

<Base title={`${d.short}${d.lab ? ' ' + d.lab : ''}`} description={d.summary}>
  <article class="partner-page">
    <header class="pp-head">
      <div class="wrap pp-head__grid">
        <div>
          <p class="eyebrow"><a href={url('partners/')}>Partners</a> / {d.institution}</p>
          <h1>{d.lab ? `${d.short} ${d.lab}` : d.short}</h1>
          <p class="pp-inst">{d.labFull ? `${d.labFull}, ${d.institution}` : d.institution}</p>
          <p class="lede">{d.summary}</p>
          <div class="logo-well pp-logos">
            <span class="logo-well__half">
              <Image src={d.logo} alt={d.logoAlt ?? d.institution} {...logo(d.logo)} densities={[1, 2]} />
            </span>
            {
              d.labLogo && (
                <>
                  <span class="logo-well__rule" aria-hidden="true"></span>
                  <span class="logo-well__half">
                    <Image src={d.labLogo} alt={d.lab ?? ''} {...logo(d.labLogo)} densities={[1, 2]} />
                  </span>
                </>
              )
            }
          </div>
        </div>
        <aside class="card pp-meta" aria-label="At a glance">
          <dl>
            {d.lead && (<div><dt>Lead</dt><dd>{d.lead}</dd></div>)}
            <div><dt>Contribution</dt><dd>{d.contribution}</dd></div>
            {
              Object.keys(d.work).length > 0 && (
                <div>
                  <dt>Works on</dt>
                  <dd>
                    <ul class="pp-work">
                      {Object.entries(d.work).map(([k, v]) => (
                        <li>
                          <strong>{layerNames[k]}:</strong> {v}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
            {d.website && (<div><dt>Website</dt><dd><a href={d.website}>{new URL(d.website).hostname.replace(/^www\./, '')}</a></dd></div>)}
            {d.contact && (<div><dt>Contact</dt><dd><a href={`mailto:${d.contact}`}>{d.contact}</a></dd></div>)}
            <div>
              <dt>Page</dt>
              <dd>
                Maintained by {d.short} · updated {fmt(d.updated)} ·{' '}
                <a href={`${repo}/edit/development/content/partners/${fileName}`}>Edit this page</a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </header>

    {
      people.length > 0 && (
        <section class="pp-people" aria-labelledby="pp-people-h">
          <div class="wrap">
            <h2 id="pp-people-h" class="eyebrow">People</h2>
            <ul class="pp-people__row">
              {people.map((m) => (
                <li class="pp-person">
                  {m.photo ? (
                    <Image class="pp-person__face" src={m.photo} alt={m.name} width={72} height={72} densities={[1, 2]} />
                  ) : (
                    <span class="pp-person__face pp-person__initials" aria-hidden="true">
                      {initials(m.name)}
                    </span>
                  )}
                  <span class="pp-person__name">{m.name}</span>
                  {m.role && <span class="pp-person__role">{m.role}</span>}
                  {m.lead && <span class="pp-person__tag">Lead</span>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      worksOn.length > 0 && (
        <section class="pp-system" aria-labelledby="pp-system-h">
          <div class="wrap">
            <p class="eyebrow">In the system</p>
            <h2 id="pp-system-h" class="pp-system__h">
              {d.lab ? `${d.short} ${d.lab}` : d.short} works on {worksOn.length} of the {system.layers.length} layers:{' '}
              {listWords(worksOn.map((l) => l.title))}.
            </h2>
            <DroneDiagram data={system} mode="partner" partner={partner.id} />
          </div>
        </section>
      )
    }

    <div class="wrap pp-body">
      <div class="md prose"><Content /></div>

      {
        updates.length > 0 && (
          <section class="pp-updates">
            <h2>Updates from {d.short}</h2>
            <ul>
              {updates.map((u) => (
                <li>
                  <time datetime={u.data.date.toISOString().slice(0, 10)}>{fmt(u.data.date)}</time>
                  <a href={url(`updates/${u.id}/`)}>{u.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <footer class="pp-foot">
        <nav aria-label="Other partners" class="pp-others">
          {
            all
              .filter((p) => p.id !== partner.id)
              .map((p) => (
                <a class="chip" href={url(`partners/${p.id}/`)}>
                  {p.data.short}
                </a>
              ))
          }
        </nav>
      </footer>
    </div>
  </article>
</Base>

<style>
  .pp-head {
    padding-block: clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .pp-head__grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .pp-head__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }
  }
  .pp-head h1 {
    font-family: var(--font-display);
    font-size: var(--step-hero);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .pp-inst {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .eyebrow a {
    text-decoration: none;
  }
  .pp-meta {
    padding: 20px;
    background: var(--bg);
    box-shadow: none;
  }
  /* One wide well under the lede: institution left, hairline, lab right. */
  .pp-logos {
    --logo-base: 76px;
    --logo-max: 94px;
    width: fit-content;
    min-width: min(100%, 440px);
    max-width: 100%;
    height: 128px;
    margin-top: 28px;
    padding: 16px 40px;
    gap: 28px;
  }
  @media (max-width: 520px) {
    .pp-logos {
      padding: 16px 14px;
      gap: 14px;
    }
  }
  .pp-meta dl {
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .pp-meta dt {
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .pp-meta dd {
    margin: 2px 0 0;
    font-size: var(--step-0);
  }
  .pp-work {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .pp-people {
    padding-block: clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--border);
  }
  .pp-people h2 {
    margin: 0 0 20px;
  }
  .pp-people__row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 28px 24px;
  }
  .pp-person {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }
  .pp-person :global(.pp-person__face) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .pp-person__initials {
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--muted);
    font: 500 var(--step-0) var(--font-mono);
    letter-spacing: 0.06em;
  }
  .pp-person__name {
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .pp-person__role {
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
    line-height: 1.4;
  }
  .pp-person__tag {
    margin-top: 4px;
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1px 8px;
    border: 1px solid var(--text);
    border-radius: 999px;
  }
  .pp-system {
    padding-block: clamp(36px, 5vw, 56px) 8px;
  }
  .pp-system__h {
    font-family: var(--font-display);
    font-size: var(--step-3);
    max-width: 40ch;
    margin: 0 0 18px;
  }
  .pp-body {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .pp-updates {
    margin-top: 48px;
    max-width: 68ch;
  }
  .pp-updates h2 {
    font-size: var(--step-4);
  }
  .pp-updates ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pp-updates li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .pp-updates time {
    font: 500 var(--step--1) var(--font-mono);
    color: var(--muted);
    min-width: 12ch;
    padding-top: 3px;
  }
  .pp-foot {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 16px;
    font-size: var(--step-0);
  }
  .pp-others {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
