---
/** Partners page: the five layers, the partner cards, who works on each layer, proof so far. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/sections/PageHead.astro';
import PartnerCards from '../../components/sections/PartnerCards.astro';
import Progress from '../../components/sections/Progress.astro';
import DroneDiagram from '../../components/DroneDiagram.astro';
import ConnectionDiagram from '../../components/ConnectionDiagram.astro';
import { getSystemData } from '../../lib/system';
import { section } from '../../components/sections/content';

const stack = await section('stack');
const system = await getSystemData();
---

<Base title="Partners" description="ST Engineering, NUS, UPenn and CMU work across the five layers of one system, funded by HTX.">
  <PageHead eyebrow="Partners" title="Who does what">
    <stack.Content />
  </PageHead>
  <PartnerCards />
  <section class="section section--alt">
    <div class="wrap">
      <div class="sys-part sys-part--layers">
        {stack.droneTitle && <h2 class="sys-part__h">{stack.droneTitle}</h2>}
        {stack.droneHint && <p class="sys-part__hint">{stack.droneHint}</p>}
      </div>
      <DroneDiagram data={system} mode="explain" target="#who-links" scrollTo="#who" />
      <div class="sys-part sys-part--who" id="who">
        <h2 class="sys-part__h">Who works on each layer</h2>
        <p class="sys-part__hint">Select a partner or a layer to trace the links.</p>
      </div>
      <div id="who-links">
        <ConnectionDiagram data={system} />
      </div>
    </div>
  </section>
  <Progress />
</Base>

<style>
  .sys-part {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 0 0 18px;
  }
  .sys-part--who {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .sys-part__h {
    font-size: var(--step-3);
    margin: 0;
  }
  .sys-part__hint {
    margin: 0;
    color: var(--muted);
    font-size: var(--step-0);
  }
</style>
