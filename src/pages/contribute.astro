---
/**
 * Contribute: which file each partner edits (with GitHub edit links), how to add a person or photo, how
 * to post an update, how to add a publication, and a link to CONTRIBUTING.md. File paths, folders and
 * field names are read from the partner files and the schema rules, so the page stays in step with them.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/sections/PageHead.astro';
import { url } from '../lib/url';
import { partnersInOrder, fileName } from '../components/sections/data';

const site = (await getEntry('site', 'main'))!.data;
const repo = site.repository.replace(/\/$/, '');
const branch = 'development';
const { partners, funder } = await partnersInOrder();
const edit = (path: string) => `${repo}/edit/${branch}/${path}`;
const newFile = (dir: string) => `${repo}/new/${branch}/${dir}`;
const folder = (p: (typeof partners)[number]) => fileName(p).replace(/\.md$/, '');
const example = partners.find((p) => p.id === 'nus') ?? partners[0];
const exFolder = folder(example);
const today = new Date().toISOString().slice(0, 10);
---

<Base title="Contribute" description="Which file each partner edits, and how to add people, photos, updates and publications.">
  <PageHead eyebrow="Strike vs Guard" title="Contribute">
    <p>
      Each partner writes its own page and its own updates. Edit your file on GitHub; the site checks it when it
      builds and shows you any mistake by file and field.
    </p>
  </PageHead>

  <div class="wrap ct">
    <section id="files" aria-labelledby="files-h">
      <h2 id="files-h">Which file is mine?</h2>
      <div class="ct__scroll">
        <table class="ct__table">
          <thead>
            <tr>
              <th scope="col">Partner</th>
              <th scope="col">Your page</th>
              <th scope="col">Your updates folder</th>
            </tr>
          </thead>
          <tbody>
            {
              partners.map((p) => (
                <tr>
                  <th scope="row">
                    {p.data.page ? <a href={url(`partners/${p.id}/`)}>{p.data.short}</a> : p.data.short}
                  </th>
                  <td>
                    <code>content/partners/{fileName(p)}</code>
                    <a class="ct__act" href={edit(`content/partners/${fileName(p)}`)}>
                      Edit<span class="visually-hidden"> {p.data.short}'s file</span>
                    </a>
                  </td>
                  <td>
                    <code>content/updates/{p.id}/</code>
                    <a class="ct__act" href={newFile(`content/updates/${p.id}/`)}>
                      New post<span class="visually-hidden"> for {p.data.short}</span>
                    </a>
                  </td>
                </tr>
              ))
            }
            {
              funder && (
                <tr>
                  <th scope="row">{funder.data.short} (funder)</th>
                  <td>
                    <code>content/partners/{fileName(funder)}</code>
                    <a class="ct__act" href={edit(`content/partners/${fileName(funder)}`)}>
                      Edit<span class="visually-hidden"> {funder.data.short}'s file</span>
                    </a>
                  </td>
                  <td class="muted">Edited by {partners.find((p) => p.data.role === 'Lead partner')?.data.short ?? 'the lead partner'}</td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
      <p>
        Images for your page go in the folder next to your file, e.g. <code>content/partners/{exFolder}/</code>, and are
        written relative to it (<code>./{exFolder}/photo.jpg</code>). Images 5 MB or less.
      </p>
    </section>

    <section id="people" aria-labelledby="people-h">
      <h2 id="people-h">Add a person or a photo</h2>
      <ol>
        <li>
          Save a square photo, 400 × 400 px and 80 KB or less, in <code>content/partners/{exFolder}/people/</code>.
        </li>
        <li>
          In your file, add the person under <code>people:</code>. <code>role</code>, <code>photo</code> and{' '}
          <code>lead</code> are optional; without a photo the page shows initials.
        </li>
      </ol>
      <pre><code>{`people:
  - name: Your Name
    role: PhD student
    photo: ./${exFolder}/people/your-name.jpg
  - name: Prof Lead Name
    lead: true`}</code></pre>
    </section>

    <section id="update" aria-labelledby="update-h">
      <h2 id="update-h">Post an update</h2>
      <ol>
        <li>
          Add a file to your folder, <code>content/updates/&lt;partner&gt;/</code>, named{' '}
          <code>YYYY-MM-DD-short-title.md</code> (e.g. <code>content/updates/{example.id}/{today}-first-flight.md</code>).
        </li>
        <li>
          Fill in the fields, then write the post in Markdown under the second <code>---</code>. Photos go in an
          <code>images/</code> folder beside it. <code>draft: true</code> keeps it off the site while you work on it.
        </li>
      </ol>
      <pre><code>{`---
title: First flight in our lab
date: ${today}
partner: ${example.id}
author: Your Name
summary: One or two sentences for the updates list.
gallery:            # optional photo strip
  - src: ./images/first-flight.jpg
    alt: Two drones hovering over the start pads
    caption: Who flew it, and when.
link: https://arxiv.org/abs/0000.00000   # optional
linkLabel: Read the paper                # optional
---

What we did, what worked and what didn't.`}</code></pre>
    </section>

    <section id="publication" aria-labelledby="pub-h">
      <h2 id="pub-h">Add a publication</h2>
      <p>
        Add it under <code>publications:</code> in your file. <code>status</code> is one of <code>published</code>,{' '}
        <code>accepted</code>, <code>preprint</code> or <code>workshop</code>; <code>link</code>, <code>pdf</code> and{' '}
        <code>image</code> (a first page or poster, next to your file) are optional. Work under review is added once
        it is published.
      </p>
      <pre><code>{`publications:
  - title: Paper title
    authors: Y. Name, L. Name
    venue: IROS 2026
    year: 2026
    status: accepted
    link: https://arxiv.org/abs/0000.00000
    image: ./${exFolder}/pubs/paper.jpg`}</code></pre>
    </section>

    <section id="more" aria-labelledby="more-h">
      <h2 id="more-h">More detail</h2>
      <p>
        The full guide, including how a change reaches the live site: <a href={`${repo}/blob/${branch}/CONTRIBUTING.md`}>CONTRIBUTING.md</a>.
        The source is on <a href={repo}>GitHub</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .ct {
    padding-block: clamp(32px, 5vw, 56px) var(--section);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(48px, 6vw, 72px);
  }
  .ct section {
    min-width: 0;
    scroll-margin-top: 80px;
    max-width: 880px;
  }
  .ct h2 {
    font-size: var(--step-4);
    margin: 0 0 16px;
  }
  .ct p,
  .ct li {
    font-size: var(--step-1);
  }
  .ct ol {
    padding-left: 1.3em;
    margin: 0 0 16px;
  }
  .ct li + li {
    margin-top: 6px;
  }
  .ct code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .ct pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    overflow-x: auto;
    margin: 0;
    font-size: var(--step-0);
    line-height: 1.55;
  }
  .ct pre code {
    font-size: 1em;
    overflow-wrap: normal;
  }
  .ct__scroll {
    overflow-x: auto;
    margin-bottom: 16px;
  }
  .ct__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-0);
  }
  .ct__table th,
  .ct__table td {
    text-align: left;
    vertical-align: middle;
    padding: 10px 16px 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .ct__table thead th {
    font-weight: 600;
    color: var(--muted);
    border-bottom-color: var(--text);
  }
  .ct__table td code {
    margin-right: 10px;
  }
  .ct__act {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--brand-red);
    text-decoration: none;
    white-space: nowrap;
  }
  .ct__act:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .ct__table thead {
      display: none;
    }
    .ct__table,
    .ct__table tbody,
    .ct__table tr,
    .ct__table th,
    .ct__table td {
      display: block;
      width: 100%;
    }
    .ct__table tr {
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
    }
    .ct__table th,
    .ct__table td {
      border: 0;
      padding: 2px 0;
    }
  }
</style>
