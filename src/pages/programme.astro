---
/** Programme page: positioning statement, the two tracks, localisation, research directions. */
import Base from '../layouts/Base.astro';
import PageHead from '../components/sections/PageHead.astro';
import Tracks from '../components/sections/Tracks.astro';
import Localisation from '../components/sections/Localisation.astro';
import Directions from '../components/sections/Directions.astro';
import { section } from '../components/sections/content';

const overview = await section('overview');
---

<Base title="Programme" description="Two strategy tracks on one shared stack, camera-only localisation, and the research directions the programme opens up.">
  <PageHead eyebrow={overview.pageEyebrow ?? overview.eyebrow} title={overview.pageTitle ?? overview.title}>
    <overview.Content />
  </PageHead>
  <Tracks />
  <Localisation />
  <Directions alt />
</Base>
