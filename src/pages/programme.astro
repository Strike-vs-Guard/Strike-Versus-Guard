---
/** The old Programme page moved to Research: send visitors there, keeping any #anchor. */
import { url } from '../lib/url';
const to = url('research/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Research · Strike vs Guard</title>
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
  </head>
  <body>
    <p>This page has moved to <a href={to}>Research</a>.</p>
  </body>
</html>
