---
/** Home page: hero, benchmark, the five layers, the clips, milestones, updates, team photo. */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { url } from '../lib/url';
import { section } from '../components/sections/content';
import Benchmark from '../components/sections/Benchmark.astro';
import Layers from '../components/sections/Layers.astro';
import Clips from '../components/sections/Clips.astro';
import Milestones from '../components/sections/Milestones.astro';
import UpdatesTeaser from '../components/sections/UpdatesTeaser.astro';
import TeamPhoto from '../components/sections/TeamPhoto.astro';

const overview = await section('overview');
---

<Base>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">{overview.eyebrow} · Decentralised multi-drone autonomy</p>
        <Wordmark as="h1" />
        <span class="hero__rule" aria-hidden="true"></span>
        <p class="hero__title">{overview.title}</p>
        <div class="prose hero__body"><overview.Content /></div>
        <div class="hero__actions">
          <a class="btn" href={url('programme/')}>How it works</a>
          <a class="btn btn--ghost" href={url('partners/')}>Meet the partners</a>
        </div>
      </div>
      <div class="hero__side">
        {
          overview.image && (
            <figure class="hero__figure">
              <Image
                src={overview.image}
                alt={overview.imageAlt ?? ''}
                widths={[560, 900, 1400]}
                sizes="(min-width: 960px) 560px, 100vw"
                loading="eager"
                fetchpriority="high"
              />
              {overview.caption && <figcaption>{overview.caption}</figcaption>}
            </figure>
          )
        }
        {
          overview.decisions.length > 0 && (
            <div class="hero__decide">
              <p class="eyebrow">{overview.decisionsLabel}</p>
              <ul>
                {overview.decisions.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
    <div class="wrap">
      <dl class="facts">
        <div><dt>Funded by</dt><dd>HTX</dd></div>
        <div><dt>Partners</dt><dd>ST Engineering · NUS · UPenn · CMU</dd></div>
        <div><dt>Hardware</dt><dd>Starling 2 Max · AirStack</dd></div>
        <div><dt>Timeline</dt><dd>2026 to 2029</dd></div>
      </dl>
    </div>
  </section>

  <div class="home">
    <Benchmark />
    <Layers partnersHref={url('partners/')} />
    <Clips size="compact" />
    <Milestones />
    <UpdatesTeaser limit={3} />
    <TeamPhoto />
  </div>
</Base>

<style>
  /* The home page is a summary: tighter section spacing than the sub-pages. */
  .home > :global(.section) {
    padding-block: clamp(44px, 6vw, 64px);
  }
  /* Hero */
  .hero {
    padding-block: clamp(40px, 7vw, 88px) clamp(32px, 5vw, 56px);
  }
  .hero__grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 40px;
    }
    .hero__side {
      /* eyebrow line + wordmark margin: puts the photo top level with the wordmark */
      margin-top: 37px;
    }
  }
  .hero__figure {
    margin: 0;
  }
  .hero__decide {
    margin-top: 22px;
  }
  .hero__decide .eyebrow {
    margin-bottom: 8px;
  }
  .hero__decide ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--border);
    display: grid;
    gap: 6px;
    font-size: var(--step-0);
    color: var(--text);
  }
  .hero__text :global(.wordmark) {
    margin-top: 4px;
  }
  .hero__rule {
    display: block;
    width: 32px;
    height: 3px;
    background: var(--accent);
    margin: 22px 0 20px;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 1.15;
    max-width: 22ch;
    margin-bottom: 18px;
  }
  .hero__body :global(p) {
    color: var(--muted);
  }
  .hero__body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .hero__figure :global(img) {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 40%;
  }
  @media (max-width: 420px) {
    .hero :global(.wordmark--lg) {
      font-size: 2.35rem;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1px;
    margin: clamp(32px, 5vw, 56px) 0 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .facts div {
    background: var(--surface);
    padding: 14px 16px;
  }
  @media (max-width: 719px) {
    .facts div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .facts dt {
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
    font-weight: 600;
    font-size: var(--step-0);
  }
</style>
