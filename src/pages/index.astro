---
/**
 * Home (v3, spec 2026-11-03): title above a rounded 2:1 clip panel → logo row →
 * At a glance + Latest → partner cards → research themes → the annotated drone (Layers) → flights
 * (lead + 3) → publications → people. The footer is in Base.
 */
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { section } from '../components/sections/content';
import LogoRow from '../components/sections/LogoRow.astro';
import Glance from '../components/sections/Glance.astro';
import PartnerCards from '../components/sections/PartnerCards.astro';
import Themes from '../components/sections/Themes.astro';
import Layers from '../components/sections/Layers.astro';
import Clips from '../components/sections/Clips.astro';
import PublicationsTeaser from '../components/sections/PublicationsTeaser.astro';
import People from '../components/sections/People.astro';

const overview = await section('overview');
const flights = await section('flights');
/* the still photo: the clip's poster, and what reduced-motion visitors see instead of the clip */
const still = overview.image ? await getImage({ src: overview.image, width: 1600, format: 'webp' }) : undefined;
const clipTitle = flights.items.find((c) => c.video === overview.video)?.title ?? overview.imageAlt ?? overview.caption ?? '';
---

<Base>
  <!-- ───────────────────────── Hero: title above a rounded 16:9 clip panel ───────────────────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__text">
      <h1 id="hero-title">{overview.title}</h1>
      <div class="hero__sum"><overview.Content /></div>
      <div class="hero__btns">
        {overview.video && overview.film && (
          <button type="button" class="btn hero__filmlink" data-hero-film hidden>
            <svg width="12" height="12" viewBox="0 0 18 18" aria-hidden="true">
              <path d="M5 3l10 6-10 6z" fill="currentColor" />
            </svg>
            <span>{overview.filmLabel ?? 'Watch the film'}</span>
          </button>
        )}
        <a class:list={['btn', { 'btn--ghost': !!overview.film }]} href="#updates">Latest updates</a>
        <a class="btn btn--ghost" href={url('partners/')}>Meet the partners</a>
      </div>
    </div>
    {
      (overview.video || still) && (
        <figure class="wrap hero__fig">
          <div class:list={['hero__panel', { 'has-video': !!overview.video }]} data-hero-clip>
            {overview.video && (
              <video
                class="hero__video"
                src={url(`media/${overview.video}`)}
                poster={still?.src}
                muted
                loop
                playsinline
                preload="none"
                aria-label={overview.videoLabel ?? `Flight clip: ${clipTitle}`}
                data-teaser={url(`media/${overview.video}`)}
                data-film={overview.film ? url(`media/${overview.film}`) : undefined}
              />
            )}
            {still && (
              <img
                class="hero__still"
                src={still.src}
                alt={overview.imageAlt ?? ''}
                width={still.attributes.width}
                height={still.attributes.height}
                loading="eager"
                decoding="async"
              />
            )}
            {overview.video && overview.film && (
              <button type="button" class="hero__film" hidden>
                <svg width="14" height="14" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M5 3l10 6-10 6z" fill="currentColor" />
                </svg>
                <span>{overview.filmLabel ?? 'Watch the film'}</span>
              </button>
            )}
            {overview.video && overview.film && (
              <button type="button" class="hero__back" hidden>
                <svg width="12" height="12" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" />
                </svg>
                <span>Close the film</span>
              </button>
            )}
            {overview.video && (
              <button type="button" class="hero__toggle" aria-label="Play the clip" hidden>
                <svg class="hero__i-play" width="14" height="14" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M5 3l10 6-10 6z" fill="currentColor" />
                </svg>
                <svg class="hero__i-pause" width="14" height="14" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M5 3h3v12H5zM10 3h3v12h-3z" fill="currentColor" />
                </svg>
              </button>
            )}
          </div>
          {overview.caption && <figcaption>{overview.caption}</figcaption>}
        </figure>
      )
    }
  </section>

  <LogoRow />

  <div class="home">
    <Glance />
    <PartnerCards heading="Partners" funderLine={false} />
    <Themes />
    <Layers />
    <Clips id="flights" lead log limit={4} skip={overview.video ? [overview.video] : []} more={{ href: url('flights/'), label: 'All flights →' }} />
    <PublicationsTeaser />
    <People />
  </div>
</Base>

<script>
  /*
   * Hero clip: no autoplay attribute and preload="none", so nothing loads until the script starts it.
   * It plays muted on load unless the visitor prefers reduced motion; they get the still photo and a
   * play button instead. Shares the play/pause wiring (and one-clip-at-a-time) with Clip.astro.
   * It pauses while scrolled out of view or while the tab is hidden, and resumes only if it was playing
   * then: a visitor's pause, or another clip starting, keeps it paused.
   */
  import { bindToggle } from '../lib/clip-player';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const panel of document.querySelectorAll<HTMLElement>('[data-hero-clip]')) {
    const video = panel.querySelector('video');
    const button = panel.querySelector<HTMLButtonElement>('.hero__toggle');
    if (!video || !button) continue;
    video.addEventListener('playing', () => video.classList.add('is-started'));
    bindToggle({
      root: panel,
      video,
      button,
      pressed: false,
      label: (on) => (on ? 'Pause the clip' : 'Play the clip'),
      beforePlay: () => panel.classList.add('is-on'),
    });
    button.hidden = false;

    /* `wanted`: should the clip play whenever it is visible? Pausing it off screen or in a hidden tab keeps it. */
    let wanted = !reduce;
    let inView = true;
    const apply = () => {
      const run = wanted && inView && !document.hidden;
      if (run && video.paused) video.play().catch(() => {});
      else if (!run && !video.paused) {
        video.pause();
        /* the film has sound: once paused by scrolling away or a hidden tab it stays paused */
        if (panel.classList.contains('is-film')) wanted = false;
      }
    };
    /* a pause while the clip is on screen and the tab is shown came from the visitor or another clip */
    video.addEventListener('pause', () => {
      if (inView && !document.hidden) wanted = false;
    });
    video.addEventListener('play', () => (wanted = true));
    document.addEventListener('visibilitychange', apply);
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        apply();
      },
      { threshold: 0.1 },
    ).observe(panel);
    if (!reduce) {
      panel.classList.add('is-on');
      apply();
    }

    /*
     * The film: the button swaps the silent loop for the full film in the same panel, with sound and the
     * browser's own controls, from the start. When it ends (or on a second visit to the button after it
     * ends) the silent loop comes back. Nothing of the film is fetched before the click.
     */
    const filmButton = panel.querySelector<HTMLButtonElement>('.hero__film');
    const backButton = panel.querySelector<HTMLButtonElement>('.hero__back');
    const rowButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-film]')];
    const film = video.dataset.film;
    const teaser = video.dataset.teaser;
    if (filmButton && backButton && film && teaser) {
      filmButton.hidden = false;
      let opener: HTMLElement | null = null;
      const toTeaser = () => {
        if (!panel.classList.contains('is-film')) return;
        if (document.fullscreenElement === video) document.exitFullscreen().catch(() => {});
        panel.classList.remove('is-film');
        backButton.hidden = true;
        video.controls = false;
        video.muted = true;
        video.loop = true;
        video.src = teaser;
        video.load();
        wanted = !reduce;
        if (reduce) panel.classList.remove('is-on');
        apply();
        /* focus goes back to the button that opened the film */
        (opener && opener.offsetParent ? opener : rowButtons[0] ?? filmButton).focus({ preventScroll: true });
      };
      const playFilm = (event: Event) => {
        opener = event.currentTarget as HTMLElement;
        panel.classList.add('is-on', 'is-film');
        backButton.hidden = false;
        video.pause();
        video.loop = false;
        video.muted = false;
        video.controls = true;
        video.src = film;
        video.load();
        wanted = true;
        video.play().catch(() => {});
        panel.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
        video.focus({ preventScroll: true });
        /* on a phone the panel is too small for the film's captions: open it full screen */
        if (window.matchMedia('(max-width: 720px)').matches) {
          const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
          if (v.requestFullscreen) v.requestFullscreen().catch(() => v.webkitEnterFullscreen?.());
          else v.webkitEnterFullscreen?.();
        }
      };
      filmButton.addEventListener('click', playFilm);
      /* the same action from the button row under the title, which is on screen before the panel is */
      for (const b of rowButtons) {
        b.hidden = false;
        b.addEventListener('click', playFilm);
      }
      backButton.addEventListener('click', toTeaser);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel.classList.contains('is-film') && !document.fullscreenElement) toTeaser();
      });
      video.addEventListener('ended', toTeaser);
    }
  }
</script>

<style>
  /* Rules between the home sections, as in the draft */
  .home > :global(.section ~ .section) {
    border-top: 1px solid var(--border);
  }
  /* Hero: title, positioning statement and buttons above the panel */
  .hero__text {
    padding-top: clamp(44px, 6vw, 72px);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.06;
    max-width: 14em;
    margin: 0;
  }
  .hero__sum {
    margin-top: 18px;
    max-width: 47.5rem;
  }
  .hero__sum :global(p) {
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }
  .hero__sum :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__fig {
    margin: 40px auto 0;
  }
  .hero__panel {
    position: relative;
    aspect-ratio: 16 / 9;
    /* the film button scrolls the panel to the top of the window: stay clear of the sticky header */
    scroll-margin-top: 5.5rem;
    border-radius: 12px;
    overflow: hidden;
    background: var(--media);
  }
  .hero__panel video,
  .hero__panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  /* the loop and the film are both 16:9, the panel's own shape */
  .hero__panel video {
    object-position: 50% 50%;
  }
  .hero__panel.has-video .hero__still {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__panel.has-video:not(.is-on) .hero__video {
      display: none;
    }
    .hero__panel.has-video:not(.is-on) .hero__still {
      display: block;
    }
  }
  .hero__toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    border: 1px solid rgb(255 255 255 / 0.45);
    background: color-mix(in srgb, var(--media) 45%, transparent);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
  }
  @media (hover: hover) {
    .hero__toggle:hover {
      background: color-mix(in srgb, var(--media) 70%, transparent);
    }
  }
  .hero__toggle[hidden] {
    display: none;
  }
  .hero__filmlink {
    cursor: pointer;
  }
  .hero__filmlink[hidden] {
    display: none;
  }
  /* "Watch the film": bottom left of the panel; hidden while the film itself is playing */
  .hero__film {
    position: absolute;
    left: 16px;
    bottom: 16px;
    min-height: 44px;
    padding: 0 18px 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius);
    border: 1px solid rgb(255 255 255 / 0.55);
    background: color-mix(in srgb, var(--media) 72%, transparent);
    color: #fff;
    font: inherit;
    font-size: var(--step-0);
    font-weight: 600;
    cursor: pointer;
  }
  @media (hover: hover) {
    .hero__film:hover {
      background: color-mix(in srgb, var(--media) 90%, transparent);
    }
  }
  .hero__film[hidden],
  .is-film .hero__film,
  .is-film .hero__toggle {
    display: none;
  }
  /* film mode: a way back to the loop, top right, clear of the player's own controls */
  .hero__back {
    position: absolute;
    right: 16px;
    top: 16px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--radius);
    border: 1px solid rgb(255 255 255 / 0.55);
    background: color-mix(in srgb, var(--media) 72%, transparent);
    color: #fff;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }
  .hero__back[hidden] {
    display: none;
  }
  .is-film .hero__video {
    object-fit: contain;
  }
  .hero__i-pause,
  .is-playing .hero__i-play {
    display: none;
  }
  .is-playing .hero__i-pause {
    display: block;
  }
  .hero__fig figcaption {
    margin-top: 10px;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    /* on a phone the button would sit on the footage's captions; the same button is in the row above the panel */
    .hero__film {
      display: none;
    }
    .hero__back {
      right: 10px;
      top: 10px;
    }
    .hero__toggle {
      right: 10px;
      bottom: 10px;
    }
  }
</style>
