---
/**
 * Home (v3, spec 2026-11-03): title above a rounded 2:1 clip panel → logo row → updates strip →
 * At a glance + Latest → partner cards → research themes → the annotated drone (Layers) → flights
 * (lead + 3) → publications → people. The footer is in Base.
 */
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { section } from '../components/sections/content';
import LogoRow from '../components/sections/LogoRow.astro';
import UpdatesStrip from '../components/sections/UpdatesStrip.astro';
import Glance from '../components/sections/Glance.astro';
import PartnerCards from '../components/sections/PartnerCards.astro';
import Themes from '../components/sections/Themes.astro';
import Layers from '../components/sections/Layers.astro';
import Clips from '../components/sections/Clips.astro';
import PublicationsTeaser from '../components/sections/PublicationsTeaser.astro';
import People from '../components/sections/People.astro';

const overview = await section('overview');
const flights = await section('flights');
/* the still photo: the clip's poster, and what reduced-motion visitors see instead of the clip */
const still = overview.image ? await getImage({ src: overview.image, width: 1600, format: 'webp' }) : undefined;
const clipTitle = flights.items.find((c) => c.video === overview.video)?.title ?? overview.caption ?? '';
---

<Base>
  <!-- ───────────────────────── Hero: title above a rounded 2:1 clip panel ───────────────────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__text">
      <h1 id="hero-title">{overview.title}</h1>
      <div class="hero__sum"><overview.Content /></div>
      <div class="hero__btns">
        <a class="btn" href="#updates">Latest updates</a>
        <a class="btn btn--ghost" href={url('partners/')}>Meet the partners</a>
      </div>
    </div>
    {
      (overview.video || still) && (
        <figure class="wrap hero__fig">
          <div class:list={['hero__panel', { 'has-video': !!overview.video }]} data-hero-clip>
            {overview.video && (
              <video
                class="hero__video"
                src={url(`media/${overview.video}`)}
                poster={still?.src}
                muted
                loop
                playsinline
                preload="none"
                aria-label={`Flight clip: ${clipTitle}`}
              />
            )}
            {still && (
              <img
                class="hero__still"
                src={still.src}
                alt={overview.imageAlt ?? ''}
                width={still.attributes.width}
                height={still.attributes.height}
                loading="eager"
                decoding="async"
              />
            )}
            {overview.video && (
              <button type="button" class="hero__toggle" aria-label="Play the flight clip" hidden>
                <svg class="hero__i-play" width="14" height="14" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M5 3l10 6-10 6z" fill="currentColor" />
                </svg>
                <svg class="hero__i-pause" width="14" height="14" viewBox="0 0 18 18" aria-hidden="true">
                  <path d="M5 3h3v12H5zM10 3h3v12h-3z" fill="currentColor" />
                </svg>
              </button>
            )}
          </div>
          {overview.caption && <figcaption>{overview.caption}</figcaption>}
        </figure>
      )
    }
  </section>

  <LogoRow />
  <UpdatesStrip />

  <div class="home">
    <Glance />
    <PartnerCards heading="Partners" funderLine={false} />
    <Themes />
    <Layers />
    <Clips id="flights" lead log limit={4} skip={overview.video ? [overview.video] : []} more={{ href: url('flights/'), label: 'All flights →' }} />
    <PublicationsTeaser />
    <People />
  </div>
</Base>

<script>
  /*
   * Hero clip: no autoplay attribute and preload="none", so nothing loads until the script starts it.
   * It plays muted on load unless the visitor prefers reduced motion; they get the still photo and a
   * play button instead. Shares the play/pause wiring (and one-clip-at-a-time) with Clip.astro.
   */
  import { bindToggle } from '../lib/clip-player';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const panel of document.querySelectorAll<HTMLElement>('[data-hero-clip]')) {
    const video = panel.querySelector('video');
    const button = panel.querySelector<HTMLButtonElement>('.hero__toggle');
    if (!video || !button) continue;
    video.addEventListener('playing', () => video.classList.add('is-started'));
    bindToggle({
      root: panel,
      video,
      button,
      pressed: false,
      label: (on) => (on ? 'Pause the flight clip' : 'Play the flight clip'),
      beforePlay: () => panel.classList.add('is-on'),
    });
    button.hidden = false;
    if (!reduce) {
      panel.classList.add('is-on');
      video.play().catch(() => {});
    }
  }
</script>

<style>
  /* Rules between the home sections, as in the draft */
  .home > :global(.section ~ .section) {
    border-top: 1px solid var(--border);
  }
  /* Hero: title, positioning statement and buttons above the panel */
  .hero__text {
    padding-top: clamp(44px, 6vw, 72px);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.06;
    max-width: 14em;
    margin: 0;
  }
  .hero__sum {
    margin-top: 18px;
    max-width: 760px;
  }
  .hero__sum :global(p) {
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
  }
  .hero__sum :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__fig {
    margin: 40px auto 0;
  }
  .hero__panel {
    position: relative;
    aspect-ratio: 2 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: #0b1622;
  }
  .hero__panel video,
  .hero__panel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  /* each clip stacks the ground station (top) over the flight (bottom): show the flight */
  .hero__panel video.is-started {
    object-position: 50% 100%;
  }
  .hero__panel.has-video .hero__still {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__panel.has-video:not(.is-on) .hero__video {
      display: none;
    }
    .hero__panel.has-video:not(.is-on) .hero__still {
      display: block;
    }
  }
  .hero__toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    border: 1px solid rgb(255 255 255 / 0.45);
    background: rgb(11 22 34 / 0.45);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
  }
  .hero__toggle:hover {
    background: rgb(11 22 34 / 0.7);
  }
  .hero__toggle[hidden] {
    display: none;
  }
  .hero__i-pause,
  .is-playing .hero__i-play {
    display: none;
  }
  .is-playing .hero__i-pause {
    display: block;
  }
  .hero__fig figcaption {
    margin-top: 10px;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    /* 16:9 shows exactly the flight half of a stacked clip */
    .hero__panel {
      aspect-ratio: 16 / 9;
    }
  }
</style>
