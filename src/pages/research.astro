---
/**
 * Research: the five themes, each with an anchor the home page links to: #learning and #formal (the two
 * tracks), #safety (how a command travels, through the safety filter), #localisation and #simulation.
 * #safety also shows the safety-filter clip from themes.md (small, click to play). Then the research directions. Larger, standardised type: h2 step-4, body step-1, no mono prose.
 * The head comes from content/programme/themes.md (`pageEyebrow`, `pageTitle`, body) when it exists.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/sections/PageHead.astro';
import Tracks from '../components/sections/Tracks.astro';
import CommandPath from '../components/sections/CommandPath.astro';
import Simulation from '../components/sections/Simulation.astro';
import Localisation from '../components/sections/Localisation.astro';
import Directions from '../components/sections/Directions.astro';
import Clip from '../components/Clip.astro';
import { optionalSection } from '../components/sections/data';

const site = (await getEntry('site', 'main'))!.data;
const themes = await optionalSection('themes');
/* the safety-filter clip (themes.md, the `icon: safety` row), shown under "how a command travels" */
const safety = themes?.items.find((t) => t.icon === 'safety' && t.video);
---

<Base title="Research" description="Two strategy tracks on one shared stack, the safety filter, camera-only localisation and the shared simulator.">
  <PageHead eyebrow={themes?.pageEyebrow ?? site.tagline} title={themes?.pageTitle ?? 'Research'}>
    {themes?.hasBody && <themes.Content />}
  </PageHead>
  <div class="research">
    <Tracks />
    <div id="safety" class="research__anchor">
      <CommandPath>
        {
          safety?.video && (
            <figure class="research__clip">
              <Clip video={safety.video} poster={safety.poster} title={safety.title} variant="button" aspect="16 / 9" media />
              <figcaption>
                {safety.caption} {safety.credit}
              </figcaption>
            </figure>
          )
        }
      </CommandPath>
    </div>
    <Localisation />
    <Simulation alt />
    <Directions />
  </div>
</Base>

<style>
  /* One type scale on this page: h2 step-4, h3 step-2, body step-1; mono only for small labels. */
  .research :global(h2) {
    font-size: var(--step-4);
  }
  .research :global(h3) {
    font-size: var(--step-2);
  }
  .research :global(:is(p, li, figcaption, dd)) {
    font-size: var(--step-1);
  }
  .research :global(.card .eyebrow) {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--step-0);
  }
  .research :global(.clip-card__stamp) {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
  }
  .research__clip {
    margin: clamp(28px, 4vw, 40px) 0 0;
    max-width: 640px;
  }
  .research__clip figcaption {
    margin-top: 10px;
    color: var(--muted);
  }
  .research :global(:is(#learning, #formal, #localisation, #simulation)),
  .research__anchor {
    scroll-margin-top: 80px;
  }
</style>
