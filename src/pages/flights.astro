---
/**
 * Flights page: the head with the cage-floor photo (flights.md `image:`), the October 2026 clips (one lead
 * clip, then three to a row, each with a stamp line), CMU's outdoor flights (stamped too), the test ladder with an
 * annotated photo of the Singapore lab, localisation status, milestones.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/sections/PageHead.astro';
import Clips from '../components/sections/Clips.astro';
import TestLadder from '../components/sections/TestLadder.astro';
import Localisation from '../components/sections/Localisation.astro';
import Milestones from '../components/sections/Milestones.astro';
import AnnotatedPhoto from '../components/AnnotatedPhoto.astro';
import { section } from '../components/sections/content';

const flights = await section('flights');
/* the annotated lab photo under the test ladder: image, alt, caption and points from ladder.md */
const ladder = await section('ladder');
---

<Base title="Flights" description="Three Starling 2 Max drones flying with no pilot in CMU's flight cage, and what comes next.">
  <PageHead eyebrow={flights.pageEyebrow ?? flights.eyebrow} title={flights.pageTitle ?? flights.title}>
    <flights.Content />
  </PageHead>
  {
    flights.image && (
      <div class="wrap fl-photo">
        <figure>
          <Image
            class="media-edge"
            src={flights.image}
            alt={flights.imageAlt ?? ''}
            widths={[600, 1000, 1400, 1800]}
            sizes="(min-width: 1320px) 1320px, 100vw"
          />
          {flights.caption && <figcaption>{flights.caption}</figcaption>}
        </figure>
      </div>
    )
  }
  <Clips id="flights" lead log />
  <Clips id="outdoor" body alt aspect="16 / 9" log />
  <TestLadder>
    {
      ladder.image && (
        <div class="fl-lab">
          <AnnotatedPhoto src={ladder.image} alt={ladder.imageAlt ?? ''} points={ladder.points} caption={ladder.caption} />
        </div>
      )
    }
  </TestLadder>
  <Localisation statusOnly />
  <Milestones id="" alt={false} />
</Base>

<style>
  .fl-photo {
    padding-top: clamp(24px, 4vw, 40px);
  }
  .fl-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  @media (min-width: 760px) {
    .fl-photo :global(img) {
      aspect-ratio: 21 / 9;
      object-fit: cover;
      object-position: center 62%;
    }
  }
  .fl-lab {
    margin-top: clamp(32px, 4vw, 48px);
  }
</style>
