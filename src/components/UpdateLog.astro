---
/**
 * Updates as a dated log: one row per post, newest first as given. Each row: date (mono) · author (or the
 * partner's short name) · title link · summary. `compact` keeps the summary to one line from 760 px
 * (home-page teaser); `heading` sets the title's heading level.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  updates: CollectionEntry<'updates'>[];
  compact?: boolean;
  heading?: 'h2' | 'h3';
}
const { updates, compact = false, heading = 'h3' } = Astro.props;
const partners = await getCollection('partners');
const short = (id: string) => partners.find((p) => p.id === id)?.data.short ?? id;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const H = heading;
---

{
  updates.length > 0 && (
    <ol class:list={['ulog', { 'ulog--compact': compact }]}>
      {updates.map((u) => (
        <li class="ulog__row">
          <time class="ulog__date" datetime={u.data.date.toISOString().slice(0, 10)}>
            {fmt(u.data.date)}
          </time>
          <span class="ulog__who">
            {u.data.author ? `${u.data.author}, ${short(u.data.partner)}` : short(u.data.partner)}
          </span>
          <div class="ulog__main">
            <H class="ulog__title">
              <a href={url(`updates/${u.id}/`)}>{u.data.title}</a>
            </H>
            <p class="ulog__sum muted">{u.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .ulog {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  .ulog__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 14px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
  }
  .ulog__date,
  .ulog__who {
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .ulog__date {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ulog__main {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .ulog__title {
    font-family: var(--font-body);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 2px;
  }
  .ulog__title a {
    text-decoration: none;
  }
  .ulog__title a:hover,
  .ulog__title a:focus-visible {
    text-decoration: underline;
  }
  .ulog__sum {
    margin: 0;
    font-size: var(--step-0);
    max-width: 80ch;
  }
  @media (min-width: 760px) {
    .ulog__row {
      grid-template-columns: 13ch 26ch minmax(0, 1fr);
      gap: 0 24px;
      align-items: baseline;
    }
    .ulog__main {
      grid-column: auto;
    }
    .ulog--compact .ulog__sum {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
