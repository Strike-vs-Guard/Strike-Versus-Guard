---
/**
 * A photo with a few labelled points. Each point is `{ x, y, label }` in percent of the photo (0 to 100,
 * from the top left); optional `lx`/`ly` place the label (default: 12 % above the point, or below it
 * near the top edge). A thin --text leader line (with a --halo edge, so it flips with the theme) runs from a small ring
 * on the point to the label.
 * Below 640 px the labels become numbers on the photo and the text stacks in a list under it.
 * More than one per page is fine (no ids, no script).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Point {
  x: number;
  y: number;
  label: string;
  lx?: number;
  ly?: number;
}
interface Props {
  src: ImageMetadata;
  alt: string;
  points: Point[];
  caption?: string;
}
const { src, alt, points, caption } = Astro.props;
const pts = points.map((p, i) => {
  const lx = p.lx ?? p.x;
  const ly = p.ly ?? (p.y < 30 ? p.y + 12 : p.y - 12);
  const above = ly < p.y;
  const align = lx < 15 ? 'start' : lx > 85 ? 'end' : 'mid';
  return { ...p, n: i + 1, lx, ly, above, align };
});
---

<figure class="ap">
  <div class="ap__frame">
    <Image class="ap__img" src={src} alt={alt} widths={[600, 1000, 1400]} sizes="(min-width: 1320px) 1320px, 100vw" />
    <svg class="ap__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {pts.map((p) => <line class="ap__halo" x1={p.x} y1={p.y} x2={p.lx} y2={p.ly} vector-effect="non-scaling-stroke" />)}
      {pts.map((p) => <line x1={p.x} y1={p.y} x2={p.lx} y2={p.ly} vector-effect="non-scaling-stroke" />)}
    </svg>
    {pts.map((p) => <span class="ap__ring" style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true"></span>)}
    {
      pts.map((p) => (
        <span
          class:list={['ap__label', `ap__label--${p.align}`, p.above ? 'ap__label--above' : 'ap__label--below']}
          style={`left:${p.lx}%;top:${p.ly}%`}
          aria-hidden="true">
          <span class="ap__n">{p.n}</span>
          <span class="ap__t">{p.label}</span>
        </span>
      ))
    }
  </div>
  <ol class="ap__key">
    {pts.map((p) => <li><span class="ap__n" aria-hidden="true">{p.n}</span>{p.label}</li>)}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ap__frame {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ap :global(.ap__img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ap__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ap__lines line {
    stroke: var(--text);
    stroke-width: 1;
  }
  /* an edge in the opposite tone under each leader line (dark in dark mode, white in light) */
  .ap__lines .ap__halo {
    stroke: var(--halo);
    stroke-width: 3;
  }
  .ap__ring {
    position: absolute;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border: 1.5px solid var(--text);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--halo);
  }
  .ap__label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 9px;
    background: var(--bg);
    border: 1px solid var(--text);
    border-radius: var(--radius);
    font: 600 var(--step-0) var(--font-body);
    color: var(--text);
    white-space: nowrap;
    line-height: 1.3;
  }
  .ap__label--mid.ap__label--above {
    transform: translate(-50%, -100%);
  }
  .ap__label--mid.ap__label--below {
    transform: translate(-50%, 0);
  }
  .ap__label--start.ap__label--above {
    transform: translate(0, -100%);
  }
  .ap__label--end.ap__label--above {
    transform: translate(-100%, -100%);
  }
  .ap__label--end.ap__label--below {
    transform: translate(-100%, 0);
  }
  /* numbers are shown only on phones, where the words move to the list below the photo */
  .ap__n {
    display: none;
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0;
  }
  .ap__key {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* phones: numbers on the photo, the words in a list below it */
  @media (max-width: 639px) {
    .ap__label,
    .ap__label[class] {
      padding: 1px 2px;
      transform: translate(-50%, -50%);
    }
    .ap__n {
      display: inline-grid;
      place-items: center;
      min-width: 1.6em;
      height: 1.6em;
    }
    .ap__t {
      display: none;
    }
    .ap__key {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      list-style: none;
      margin: 12px 0 0;
      padding: 0;
      display: grid;
      gap: 6px;
      font-size: var(--step-0);
    }
    .ap__key li {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ap__key .ap__n {
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
  }
</style>
