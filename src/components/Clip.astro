---
/**
 * A short muted, looping clip that loads only when played (no autoplay).
 * `variant`: "controls" (default) uses the browser's controls; "button" shows the poster with one
 * round play/pause button over the whole frame (the home page "Proof so far" clips).
 * `aspect` sets the frame (CSS aspect-ratio); the default fits the flight clips, which stack the
 * ground station above the flight. `natural` uses the video's own shape (read from the file at build
 * time) and caps the height, so a lead clip can run at full width without filling the screen.
 * `flight` fills the frame and shows the bottom (flight) half of a stacked clip.
 * `media` puts the frame on the dark --media backdrop (the Flights grid, where every cell shares one frame).
 * Starting any clip pauses the others (src/lib/clip-player.ts).
 */
import { url } from '../lib/url';
import { videoSize } from '../lib/media';
interface Props {
  video: string;
  poster?: string;
  title: string;
  variant?: 'controls' | 'button';
  aspect?: string;
  natural?: boolean;
  /** fill the frame and show the flight (bottom) half of a clip that stacks the ground station above it */
  flight?: boolean;
  /** letterbox on the dark --media backdrop instead of --surface */
  media?: boolean;
}
const {
  video,
  poster,
  title,
  variant = 'controls',
  aspect = '960 / 1080',
  natural = false,
  flight = false,
  media = false,
} = Astro.props;
const size = natural ? videoSize(video) : null;
const frame = size ? `${size.width} / ${size.height}` : aspect;
const button = variant === 'button';
---

<div
  class:list={['clip', `clip--${variant}`, { 'clip--natural': natural, 'clip--flight': flight, 'clip--media': media }]}
  style={button ? `aspect-ratio: ${frame}` : undefined}
  data-clip={variant}
  data-title={title}>
  <video
    src={url(`media/${video}`)}
    poster={poster ? url(`media/${poster}`) : undefined}
    preload="none"
    muted
    loop
    playsinline
    controls={!button}
    style={button ? undefined : `aspect-ratio: ${frame}`}
    aria-label={`Flight clip: ${title}`}></video>
  {
    button && (
      <button type="button" class="clip__btn" aria-pressed="false" aria-label={`Play: ${title}`}>
        <span class="clip__icon" aria-hidden="true">
          <svg class="clip__play" width="18" height="18" viewBox="0 0 18 18">
            <path d="M5 3l10 6-10 6z" fill="currentColor" />
          </svg>
          <svg class="clip__pause" width="18" height="18" viewBox="0 0 18 18">
            <path d="M5 3h3v12H5zM10 3h3v12h-3z" fill="currentColor" />
          </svg>
        </span>
      </button>
    )
  }
</div>

<script>
  import { bindToggle, exclusive } from '../lib/clip-player';

  for (const root of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const video = root.querySelector('video');
    if (!video) continue;
    const button = root.querySelector<HTMLButtonElement>('.clip__btn');
    if (button) {
      const title = root.dataset.title ?? '';
      bindToggle({ root, video, button, label: (on) => `${on ? 'Pause' : 'Play'}: ${title}` });
    } else {
      exclusive(video);
    }
  }
</script>

<style>
  .clip {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  video {
    display: block;
    width: 100%;
    object-fit: contain;
    background: var(--surface);
  }
  .clip--media,
  .clip--media video {
    background: var(--media);
  }
  /* full-width lead clip: tall clips letterbox inside a capped height instead of filling the screen */
  .clip--natural video {
    max-height: min(72vh, 680px);
  }
  .clip--button video {
    height: 100%;
  }
  .clip--flight video {
    object-fit: cover;
    /* each clip stacks the ground station (top) over the flight (bottom): show the flight */
    object-position: 50% 100%;
  }
  .clip__btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .clip__btn:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -4px;
    border-radius: var(--radius);
  }
  .clip__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    /* sits on video, so it is the same in both themes: white glyph on a dark disc */
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.7);
    background: color-mix(in srgb, var(--media) 55%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }
  .clip__btn:hover .clip__icon {
    background: color-mix(in srgb, var(--media) 75%, transparent);
  }
  .clip__pause,
  .is-playing .clip__play {
    display: none;
  }
  .is-playing .clip__pause {
    display: block;
  }
  /* while playing, the pause icon shows only on hover or keyboard focus */
  .is-playing .clip__icon {
    opacity: 0;
  }
  .is-playing .clip__btn:hover .clip__icon,
  .is-playing .clip__btn:focus-visible .clip__icon {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .clip__icon {
      transition: none;
    }
  }
</style>
