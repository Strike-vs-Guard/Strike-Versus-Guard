---
/**
 * A short muted, looping clip that loads only when played (no autoplay).
 * `variant`: "controls" (default) uses the browser's controls; "button" shows the poster with one
 * round play/pause button over the whole frame (the home page "Proof so far" clips).
 * `aspect` sets the frame (CSS aspect-ratio); the default fits the flight clips, which stack the
 * ground station above the flight. `natural` uses the video's own shape (read from the file at build
 * time) and caps the height, so a lead clip can run at full width without filling the screen.
 * `flight` fills the frame and shows the bottom (flight) half of a stacked clip.
 * `media` puts the frame on the dark --media backdrop (the Flights grid, where every cell shares one frame).
 * `videoAlt`/`posterAlt` add a second run of the same scenario (the lights-off run): two buttons under the
 * frame ("Lit" / `altLabel`) swap the source and poster; a clip that was playing keeps playing from the start.
 * Starting any clip pauses the others (src/lib/clip-player.ts).
 */
import { url } from '../lib/url';
import { videoSize } from '../lib/media';
interface Props {
  video: string;
  poster?: string;
  title: string;
  variant?: 'controls' | 'button';
  aspect?: string;
  natural?: boolean;
  /** fill the frame and show the flight (bottom) half of a clip that stacks the ground station above it */
  flight?: boolean;
  /** letterbox on the dark --media backdrop instead of --surface */
  media?: boolean;
  /** a second run of the same scenario (file in public/media), e.g. the lights-off run */
  videoAlt?: string;
  posterAlt?: string;
  /** label for the second run's button; the first is "Lit" */
  altLabel?: string;
}
const {
  video,
  poster,
  title,
  variant = 'controls',
  aspect = '960 / 1080',
  natural = false,
  flight = false,
  media = false,
  videoAlt,
  posterAlt,
  altLabel = 'Lights off',
} = Astro.props;
const size = natural ? videoSize(video) : null;
const frame = size ? `${size.width} / ${size.height}` : aspect;
const button = variant === 'button';
const runs = videoAlt
  ? [
      { label: 'Lit', src: url(`media/${video}`), poster: poster ? url(`media/${poster}`) : '' },
      { label: altLabel, src: url(`media/${videoAlt}`), poster: posterAlt ? url(`media/${posterAlt}`) : '' },
    ]
  : [];
---

<div class="clip-wrap" data-clip={variant} data-title={title}>
<div
  class:list={['clip', `clip--${variant}`, { 'clip--natural': natural, 'clip--flight': flight, 'clip--media': media }]}
  style={button ? `aspect-ratio: ${frame}` : undefined}>
  <video
    src={url(`media/${video}`)}
    poster={poster ? url(`media/${poster}`) : undefined}
    preload="none"
    muted
    loop
    playsinline
    controls={!button}
    style={button ? undefined : `aspect-ratio: ${frame}`}
    aria-label={`Flight clip: ${title}`}></video>
  {
    button && (
      <button type="button" class="clip__btn" aria-pressed="false" aria-label={`Play: ${title}`}>
        <span class="clip__icon" aria-hidden="true">
          <svg class="clip__play" width="18" height="18" viewBox="0 0 18 18">
            <path d="M5 3l10 6-10 6z" fill="currentColor" />
          </svg>
          <svg class="clip__pause" width="18" height="18" viewBox="0 0 18 18">
            <path d="M5 3h3v12H5zM10 3h3v12h-3z" fill="currentColor" />
          </svg>
        </span>
      </button>
    )
  }
</div>
{
  runs.length > 0 && (
    <div class="clip__runs">
      <div class="clip__seg" role="group" aria-label={`Run shown: ${title}`}>
        {runs.map((r, i) => (
          <button
            type="button"
            class="clip__run"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-src={r.src}
            data-poster={r.poster}>
            {r.label}
          </button>
        ))}
      </div>
      <p class="clip__pair">Two runs of the same scenario, one with the lights on and one off.</p>
    </div>
  )
}
</div>

<script>
  import { bindRuns, bindToggle, exclusive } from '../lib/clip-player';

  for (const root of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const video = root.querySelector('video');
    if (!video) continue;
    const button = root.querySelector<HTMLButtonElement>('.clip__btn');
    if (button) {
      const title = root.dataset.title ?? '';
      bindToggle({ root, video, button, label: (on) => `${on ? 'Pause' : 'Play'}: ${title}` });
    } else {
      exclusive(video);
    }
    const runs = [...root.querySelectorAll<HTMLButtonElement>('.clip__run')];
    if (runs.length) bindRuns(video, runs);
  }
</script>

<style>
  .clip {
    position: relative;
    /* letterbox bars are the video backdrop (--media) in both themes, never a pale band */
    background: var(--media);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  video {
    display: block;
    width: 100%;
    object-fit: contain;
    background: var(--media);
  }
  .clip--media,
  .clip--media video {
    background: var(--media);
  }
  /* full-width lead clip: tall clips letterbox inside a capped height instead of filling the screen */
  .clip--natural video {
    max-height: min(72vh, 680px);
  }
  .clip--button video {
    height: 100%;
  }
  .clip--flight video {
    object-fit: cover;
    /* each clip stacks the ground station (top) over the flight (bottom): show the flight */
    object-position: 50% 100%;
  }
  .clip__btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .clip__btn:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -4px;
    border-radius: var(--radius);
  }
  .clip__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    /* sits on video, so it is the same in both themes: white glyph on a dark disc */
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.7);
    background: color-mix(in srgb, var(--media) 55%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }
  .clip__btn:hover .clip__icon {
    background: color-mix(in srgb, var(--media) 75%, transparent);
  }
  .clip__pause,
  .is-playing .clip__play {
    display: none;
  }
  .is-playing .clip__pause {
    display: block;
  }
  /* while playing, the pause icon shows only on hover or keyboard focus */
  .is-playing .clip__icon {
    opacity: 0;
  }
  .is-playing .clip__btn:focus-visible .clip__icon {
    opacity: 1;
  }
  /* hover only where there is a real pointer: on touch, :hover sticks after a tap */
  @media (hover: hover) {
    .is-playing .clip__btn:hover .clip__icon {
      opacity: 1;
    }
  }
  /* Lit / Lights off: a two-button switch under the frame, then one mono line */
  .clip__runs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 8px;
  }
  .clip__seg {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .clip__run {
    margin: 0;
    padding: 4px 12px;
    min-height: 32px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    font: 500 var(--step--1) var(--font-mono);
    cursor: pointer;
  }
  .clip__run + .clip__run {
    border-left: 1px solid var(--border);
  }
  .clip__run[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
  }
  .clip__run:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }
  .clip__pair {
    margin: 0;
    font: 400 var(--step--1) var(--font-mono);
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .clip__icon {
      transition: none;
    }
  }
</style>
