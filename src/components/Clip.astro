---
/**
 * A short flight clip. Shows the poster image with a play button; the video only
 * loads when someone clicks it. Muted, looping, no autoplay.
 * `aspect` sets the frame (CSS aspect-ratio); the default fits the flight clips, which stack the
 * ground station above the flight.
 */
import { url } from '../lib/url';
interface Props {
  video: string;
  poster?: string;
  title: string;
  aspect?: string;
}
const { video, poster, title, aspect = '960 / 1080' } = Astro.props;
---

<div class="clip">
  <video
    src={url(`media/${video}`)}
    poster={poster ? url(`media/${poster}`) : undefined}
    preload="none"
    muted
    loop
    playsinline
    controls
    style={`aspect-ratio: ${aspect}`}
    aria-label={`Flight clip: ${title}`}></video>
</div>

<style>
  .clip {
    position: relative;
    background: #0e1114;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  video {
    display: block;
    width: 100%;
    object-fit: contain;
    background: #0e1114;
  }
</style>
