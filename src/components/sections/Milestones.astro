---
/**
 * The three-year timeline (content/programme/milestones.md).
 * `id` defaults to "milestones"; pass id="" where a second copy appears so the anchor stays unique.
 */
import { section } from './content';

interface Props {
  id?: string;
  alt?: boolean;
}
const { id = 'milestones', alt = true } = Astro.props;
const milestones = await section('milestones');
---

<section id={id || undefined} class:list={['section', { 'section--alt': alt }]}>
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{milestones.eyebrow}</p>
      <h2>{milestones.title}</h2>
      <div class="prose"><milestones.Content /></div>
    </header>
    <ol class="timeline">
      {
        milestones.items.map((m) => (
          <li class:list={['timeline__item', { 'is-current': m.current }]}>
            <span class="timeline__dot" aria-hidden="true" />
            <p class="eyebrow">
              {m.label} · {m.when}
              {m.current && <span class="timeline__now">We are here</span>}
            </p>
            <h3>{m.title}</h3>
            <p class="muted">{m.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    position: relative;
  }
  .timeline__item {
    position: relative;
    padding: 0 0 32px 32px;
    border-left: 2px solid var(--border);
    margin-left: 7px;
  }
  .timeline__item:last-child {
    padding-bottom: 0;
  }
  .timeline__dot {
    position: absolute;
    left: -9px;
    top: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
  }
  .is-current .timeline__dot {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .timeline__now {
    display: inline-block;
    margin-left: 10px;
    padding: 1px 8px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .timeline h3 {
    margin-bottom: 4px;
  }
  @media (min-width: 860px) {
    .timeline {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .timeline__item {
      border-left: 0;
      margin-left: 0;
      padding: 36px 0 0;
      border-top: 2px solid var(--border);
    }
    .timeline__item:last-child {
      padding-bottom: 0;
    }
    .timeline__dot {
      left: 0;
      top: -9px;
    }
  }
</style>
