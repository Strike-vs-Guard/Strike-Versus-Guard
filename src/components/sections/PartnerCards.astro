---
/**
 * Partners page: one card per partner in `order:` (ST Engineering, NUS, UPenn, CMU),
 * then the funder card (HTX). Holds the #partners anchor.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../../lib/url';

const all = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const partners = all.filter((p) => p.data.role !== 'Funding sponsor');
const funders = all.filter((p) => p.data.role === 'Funding sponsor');
---

<section id="partners" class="section">
  <div class="wrap">
    <ul class="pcards">
      {
        partners.map((p) => {
          const d = p.data;
          const href = d.page ? url(`partners/${p.id}/`) : d.website;
          return (
            <li class="card pcard">
              <div class="pcard__logos">
                <div class="logo-well">
                  <Image src={d.logo} alt={d.logoAlt ?? d.institution} height={96} densities={[1, 2]} />
                </div>
                {d.labLogo && (
                  <div class="logo-well">
                    <Image src={d.labLogo} alt={d.lab ?? ''} height={96} densities={[1, 2]} />
                  </div>
                )}
              </div>
              <p class="eyebrow">{d.role}</p>
              <h2 class="pcard__name">{d.short}</h2>
              <p class="pcard__inst">{d.lab ? `${d.lab}, ${d.institution}` : d.institution}</p>
              <dl class="pcard__meta">
                {d.lead && (
                  <div>
                    <dt>Lead</dt>
                    <dd>{d.lead}</dd>
                  </div>
                )}
                <div>
                  <dt>Contribution</dt>
                  <dd>{d.contribution}</dd>
                </div>
              </dl>
              {href && (
                <a class="pcard__more" href={href}>
                  {d.short} page →
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
    {
      funders.map((f) => (
        <div class="card fcard" id="funder">
          <a class="logo-well fcard__logo" href={f.data.website} title={f.data.institution}>
            <Image src={f.data.logo} alt={f.data.logoAlt ?? f.data.institution} height={96} densities={[1, 2]} />
          </a>
          <div>
            <p class="eyebrow">Funded by</p>
            <p class="fcard__name">{f.data.institution} ({f.data.short})</p>
            <p class="muted fcard__text">{f.data.summary}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pcards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
  }
  .pcard__logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 8px;
    margin-bottom: 16px;
  }
  .pcard__logos .logo-well {
    height: 72px;
    border: 1px solid var(--border);
    padding: 8px 10px;
  }
  .pcard__logos :global(img) {
    max-height: 44px;
    max-width: 100%;
    height: auto;
  }
  .pcard .eyebrow {
    margin-bottom: 4px;
  }
  .pcard__name {
    font-size: var(--step-3);
    margin: 0 0 2px;
  }
  .pcard__inst {
    color: var(--muted);
    font-size: var(--step-0);
    margin-bottom: 14px;
  }
  .pcard__meta {
    margin: 0 0 16px;
    display: grid;
    gap: 10px;
    font-size: var(--step-0);
  }
  .pcard__meta dt {
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .pcard__meta dd {
    margin: 2px 0 0;
  }
  .pcard__more::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pcard:hover {
    border-color: var(--muted);
  }
  .pcard__more {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: var(--step-0);
  }
  .fcard {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 16px;
    padding: 20px;
  }
  .fcard__logo {
    height: 72px;
    min-width: 120px;
    border: 1px solid var(--border);
  }
  .fcard__logo :global(img) {
    max-height: 40px;
  }
  .fcard .eyebrow {
    margin-bottom: 2px;
  }
  .fcard__name {
    font-weight: 600;
    margin: 0;
  }
  .fcard__text {
    margin: 0;
    font-size: var(--step-0);
  }
</style>
