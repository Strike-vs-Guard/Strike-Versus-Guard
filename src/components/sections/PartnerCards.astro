---
/**
 * Partners page: one card per partner in `order:` (ST Engineering, NUS, UPenn, CMU),
 * then the funder card (HTX). Holds the #partners and #funder anchors.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../../lib/url';

const all = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const partners = all.filter((p) => p.data.role !== 'Funding sponsor');
const funders = all.filter((p) => p.data.role === 'Funding sponsor');
/*
 * Card logos are sized by visual weight (see .logo-well in global.css): height = 56 px × 1/√(width÷height),
 * 10 % less for square solid-colour tiles, capped at the well's 78 px inner height.
 */
const LOGO_BASE = 56;
const LOGO_MAX = 78;
const logoSize = (img: ImageMetadata) => {
  const ar = img.width / img.height;
  const k = (Math.abs(ar - 1) < 0.02 ? 0.9 : 1) / Math.sqrt(ar);
  return { style: `--logo-k:${k.toFixed(3)}`, height: Math.ceil(Math.min(LOGO_BASE * k, LOGO_MAX)) };
};
---

<section id="partners" class="section">
  <div class="wrap">
    <ul class="pcards">
      {
        partners.map((p) => {
          const d = p.data;
          const href = d.page ? url(`partners/${p.id}/`) : d.website;
          return (
            <li class="card pcard">
              <div class="logo-well pcard__logos">
                <span class="logo-well__half">
                  <Image src={d.logo} alt={d.logoAlt ?? d.institution} {...logoSize(d.logo)} densities={[1, 2]} />
                </span>
                {d.labLogo && (
                  <>
                    <span class="logo-well__rule" aria-hidden="true"></span>
                    <span class="logo-well__half">
                      <Image src={d.labLogo} alt={d.lab ?? ''} {...logoSize(d.labLogo)} densities={[1, 2]} />
                    </span>
                  </>
                )}
              </div>
              <p class="eyebrow">{d.role}</p>
              <h2 class="pcard__name">{d.short}</h2>
              <p class="pcard__inst">{d.lab ? `${d.lab}, ${d.institution}` : d.institution}</p>
              <dl class="pcard__meta">
                {d.lead && (
                  <div>
                    <dt>Lead</dt>
                    <dd>{d.lead}</dd>
                  </div>
                )}
                <div>
                  <dt>Contribution</dt>
                  <dd>{d.contribution}</dd>
                </div>
              </dl>
              {href && (
                <a class="pcard__more" href={href}>
                  {d.short} page →
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
    {
      funders.length > 0 && (
        <div id="funder">
          {funders.map((f) => (
            <div class="card fcard">
              <a class="logo-well fcard__logo" href={f.data.website} title={f.data.institution}>
                <Image src={f.data.logo} alt={f.data.logoAlt ?? f.data.institution} {...logoSize(f.data.logo)} densities={[1, 2]} />
              </a>
              <div>
                <p class="eyebrow">Funded by</p>
                <p class="fcard__name">{f.data.institution} ({f.data.short})</p>
                <p class="muted fcard__text">{f.data.summary}</p>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .pcards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
  }
  /* One full-width well: institution left, hairline, lab right. */
  .pcard__logos {
    --logo-base: 56px;
    --logo-max: 78px;
    height: 104px;
    padding: 12px 10px;
    gap: 8px;
    margin-bottom: 16px;
  }
  .pcard .eyebrow {
    margin-bottom: 4px;
  }
  .pcard__name {
    font-size: var(--step-3);
    margin: 0 0 2px;
  }
  .pcard__inst {
    color: var(--muted);
    font-size: var(--step-0);
    margin-bottom: 14px;
  }
  .pcard__meta {
    margin: 0 0 16px;
    display: grid;
    gap: 10px;
    font-size: var(--step-0);
  }
  .pcard__meta dt {
    font: 500 var(--step--1) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .pcard__meta dd {
    margin: 2px 0 0;
  }
  .pcard__more::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pcard:hover {
    border-color: var(--muted);
  }
  .pcard__more {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: var(--step-0);
  }
  .fcard {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 16px;
    padding: 20px;
  }
  .fcard__logo {
    --logo-base: 56px;
    --logo-max: 78px;
    flex: none;
    width: 200px;
    height: 104px;
  }
  .fcard .eyebrow {
    margin-bottom: 2px;
  }
  .fcard__name {
    font-weight: 600;
    margin: 0;
  }
  .fcard__text {
    margin: 0;
    font-size: var(--step-0);
  }
</style>
