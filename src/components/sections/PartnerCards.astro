---
/**
 * Partner cards (v2), in `order:` (ST Engineering, NUS, UPenn, CMU), then the funder line. Holds #partners
 * and #funder. Each card: the institution and lab logos as one white tile (LogoPair; invisible on the white page in light), name, lab (and "lead partner"),
 * lead, the one-line `contribution`, "Partner page →" and "Latest update · <date>" when the partner has
 * posted (from content/updates/); nothing when it hasn't. `heading` adds a section heading (home page); without it the card
 * names are h2 (Partners page, under its own page head).
 */
import LogoPair from '../LogoPair.astro';
import { widePlate } from '../../lib/logo';
import { url } from '../../lib/url';
import { fmtDate } from '../../lib/text';
import { allUpdates, isoDay, leadLine, partnersInOrder } from './data';

interface Props {
  heading?: string;
  /** Show the funder line under the cards (default true). */
  funderLine?: boolean;
}
const { heading, funderLine = true } = Astro.props;
const { partners, funder } = await partnersInOrder();
const updates = await allUpdates();
const lastPost = (id: string) => updates.find((u) => u.data.partner === id)?.data.date;
const H = heading ? 'h3' : 'h2';
---

<section id="partners" class="section pc-sec" aria-labelledby={heading ? 'partners-title' : undefined}>
  <div class="wrap">
    {
      heading && (
        <header class="section__head section__head--row">
          <h2 id="partners-title">{heading}</h2>
          <a class="arrow-link" href={url('partners/')}>All partners →</a>
        </header>
      )
    }
    <ul class="pc">
      {
        partners.map((p) => {
          const d = p.data;
          const last = lastPost(p.id);
          const lead = leadLine(p);
          return (
            <li class="pc__card">
              <LogoPair partner={p} class="pc__logos" />
              <H class="pc__name">{d.short}</H>
              <p class="pc__lab">
                {[d.lab, d.role === 'Lead partner' ? 'lead partner' : undefined].filter(Boolean).join(' · ') || d.institution}
              </p>
              <p class="pc__lead">{lead ?? ''}</p>
              <p class="pc__what">{d.contribution}</p>
              <div class="pc__links">
                {d.page && (
                  <a href={url(`partners/${p.id}/`)}>
                    Partner page<span class="visually-hidden">: {d.short}</span>{' '}→
                  </a>
                )}
                {last && (
                  <span class="muted">
                    Latest update · <time class="pc__date" datetime={isoDay(last)}>{fmtDate(last, 'short')}</time>
                  </span>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
    {
      funderLine && funder && (
        <div id="funder" class="pc__funder">
          <a class="logo-well pc__fwell" href={funder.data.website} title={funder.data.institution}>
            <img {...widePlate(funder, funder.data.logoAlt ?? funder.data.short)} loading="lazy" decoding="async" />
          </a>
          <p>
            <strong>Funded by {funder.data.short}</strong>, {funder.data.institution}.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .pc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 32px;
    row-gap: 10px;
  }
  .pc__card {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 10px;
    align-content: start;
    min-width: 0;
  }
  /* 3:1 tile, 270 px wide at most (90 px tall), so wide columns do not grow the logos */
  .pc__card :global(.pc__logos) {
    width: 100%;
    max-width: 270px;
    align-self: start;
  }
  .pc__name {
    font-size: var(--step-2);
    margin: 8px 0 0;
  }
  .pc__lab,
  .pc__lead,
  .pc__what {
    margin: 0;
  }
  .pc__lab {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .pc__lead {
    font-size: var(--step-0);
  }
  .pc__what {
    font-size: var(--step-0);
  }
  .pc__links {
    align-self: start;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-size: var(--step-0);
    display: grid;
    gap: 4px;
  }
  .pc__links a {
    font-weight: 600;
    color: var(--brand-red);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .pc__links a:hover,
  .pc__links a:focus-visible {
    text-decoration: underline;
  }
  .pc__date {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
  .pc__funder {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step-0);
  }
  .pc__funder p {
    margin: 0;
  }
  .pc__funder strong {
    color: var(--text);
    font-weight: 600;
  }
  .pc__fwell {
    flex: none;
    width: 118px;
  }
  @media (max-width: 1080px) {
    .pc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 32px;
    }
    .pc__card {
      display: flex;
      flex-direction: column;
      gap: 10px;
      grid-row: auto;
    }
    .pc__links {
      margin-top: auto;
    }
  }
  @media (max-width: 720px) {
    .pc {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
