---
/** Home: a band with the three latest updates, each as "date · partner" over the full title (wraps, at most two lines), then "All updates →". */
import { url } from '../../lib/url';
import { fmtDate } from '../../lib/text';
import { allUpdates, shortNames, isoDay } from './data';

const updates = (await allUpdates()).slice(0, 3);
const short = await shortNames();
---

{
  updates.length > 0 && (
    <div class="ustrip" role="region" aria-label="Latest updates">
      <div class="wrap ustrip__in">
        <ul>
          {updates.map((u) => (
            <li>
              <a href={url(`updates/${u.id}/`)}>
                <span class="ustrip__meta">
                  <time class="ustrip__dt" datetime={isoDay(u.data.date)}>{fmtDate(u.data.date, 'short')}</time>
                  <span class="ustrip__pt"> · {short(u.data.partner)}</span>
                </span>
                <span class="ustrip__hl">{u.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="arrow-link" href={url('updates/')}>All updates →</a>
      </div>
    </div>
  )
}

<style>
  .ustrip {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .ustrip__in {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-block: 6px;
  }
  .ustrip ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 28px;
    flex: 1;
    min-width: 0;
  }
  .ustrip li {
    flex: 1;
    min-width: 0;
    font-size: var(--step-0);
    line-height: 1.4;
  }
  .ustrip li + li {
    border-left: 1px solid var(--border);
    padding-left: 28px;
  }
  .ustrip li a {
    text-decoration: none;
    display: grid;
    gap: 2px;
    padding-block: 12px;
  }
  .ustrip__meta {
    display: block;
  }
  .ustrip__hl {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .ustrip li a:hover .ustrip__hl {
    text-decoration: underline;
  }
  .ustrip__dt {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--muted);
  }
  .ustrip__pt {
    color: var(--muted);
  }
  .ustrip__hl {
    font-weight: 600;
  }
  @media (max-width: 960px) {
    .ustrip__in {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-block: 6px;
    }
    .ustrip ul {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }
    .ustrip li {
      flex: none;
    }
    .ustrip li + li {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--border);
    }
    .ustrip li a {
      padding-block: 10px;
    }
    .ustrip__hl {
      display: block;
    }
  }
</style>
