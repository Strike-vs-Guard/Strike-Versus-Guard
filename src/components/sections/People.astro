---
/**
 * Home: the team photo (content/programme/stack.md `image:`, `caption:`), then everyone with a photo in a
 * partner file's `people:` list, grouped by partner in partner order. The row is left out when nobody has
 * a photo yet. Holds #people.
 */
import { Image } from 'astro:assets';
import { url } from '../../lib/url';
import { section } from './content';
import { partnersInOrder } from './data';

const stack = await section('stack');
const { partners } = await partnersInOrder();
const groups = partners
  .map((p) => ({ p, people: p.data.people.filter((m) => m.photo) }))
  .filter((g) => g.people.length > 0);
---

<section id="people" class="section" aria-labelledby="people-title">
  <div class="wrap">
    <header class="section__head">
      <h2 id="people-title">People</h2>
    </header>
    {
      stack.image && (
        <figure class="pe__team">
          <Image
            src={stack.image}
            alt={stack.imageAlt ?? ''}
            widths={[600, 1000, 1400, 1800]}
            sizes="(min-width: 1260px) 1200px, 100vw"
          />
          {stack.caption && <figcaption>{stack.caption}</figcaption>}
        </figure>
      )
    }
    {
      groups.length > 0 && (
        <div class="pe__groups">
          {groups.map(({ p, people }) => (
            <div class="pe__grp">
              <h3>
                <a href={url(`partners/${p.id}/`)}>{p.data.short}</a>
              </h3>
              <ul class="pe__row">
                {people.map((m) => (
                  <li>
                    <Image src={m.photo!} alt="" width={72} height={72} densities={[1, 2]} />
                    <span>
                      <b>{m.name}</b>
                      {m.role && <span class="muted">{m.role}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .pe__team {
    margin: 0;
  }
  .pe__team :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    aspect-ratio: 2.1 / 1;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .pe__team figcaption {
    margin-top: 12px;
    font-size: var(--step-0);
    color: var(--muted);
    max-width: 980px;
  }
  .pe__groups {
    margin-top: 44px;
    display: grid;
    gap: 32px;
  }
  .pe__grp h3 {
    font-size: var(--step-2);
    margin: 0 0 14px;
  }
  .pe__grp h3 a {
    text-decoration: none;
  }
  .pe__grp h3 a:hover {
    text-decoration: underline;
  }
  .pe__row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 20px 32px;
  }
  .pe__row li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }
  .pe__row :global(img) {
    width: 72px;
    height: 72px;
    border-radius: var(--radius);
    object-fit: cover;
  }
  .pe__row b {
    display: block;
    font-weight: 600;
    line-height: 1.3;
  }
  .pe__row .muted {
    font-size: var(--step--1);
  }
  @media (max-width: 720px) {
    .pe__team :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
