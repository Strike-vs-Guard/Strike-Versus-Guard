---
/**
 * A section of clips from one content/programme/<id>.md file: eyebrow and h2 from the file's
 * `eyebrow`/`title`, two clips per row with full captions, then the note. `id` names the file and is
 * the section anchor (#flights on the Flights page, #simulation on the Programme page).
 * `body` shows the file's Markdown body under the title; `alt` uses the alternate background;
 * `aspect` sets the clip frame (default: the tall flight clips).
 */
import Clip from '../Clip.astro';
import { section } from './content';

interface Props {
  id: string;
  body?: boolean;
  alt?: boolean;
  aspect?: string;
}
const { id, body = false, alt = false, aspect } = Astro.props;
const data = await section(id);
const { Content } = data;
const titleId = `${id}-title`;
---

<section id={id} class:list={['section', 'section--clips-large', { 'section--alt': alt }]} aria-labelledby={titleId}>
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{data.eyebrow}</p>
      <h2 id={titleId}>{data.title}</h2>
      {
        body && (
          <div class="prose">
            <Content />
          </div>
        )
      }
    </header>
    <div class="clips">
      {
        data.items.map((c) => (
          <figure class="clip-card">
            {c.video && <Clip video={c.video} poster={c.poster} title={c.title} aspect={aspect} />}
            <figcaption>
              <strong>{c.title}</strong>
              {c.text && <span>{c.text}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
    {data.note && <p class="section__note">{data.note}</p>}
  </div>
</section>

<style>
  .clips {
    display: grid;
    gap: 32px 28px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }
  .clip-card figcaption {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: 0;
    display: grid;
    gap: 2px;
  }
  .clip-card figcaption strong {
    color: var(--text);
  }
  @media (min-width: 760px) {
    .clips {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
