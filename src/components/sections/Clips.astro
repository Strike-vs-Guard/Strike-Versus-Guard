---
/**
 * The four flight clips (content/programme/flights.md) on the Flights page: eyebrow and h2 from the
 * file's `eyebrow`/`title`, two clips per row with full captions, then the note.
 * Holds #flights when given id="flights".
 */
import Clip from '../Clip.astro';
import { section } from './content';

interface Props {
  id?: string;
}
const { id } = Astro.props;
const flights = await section('flights');
---

<section id={id} class="section section--clips-large" aria-labelledby="clips-title">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{flights.eyebrow}</p>
      <h2 id="clips-title">{flights.title}</h2>
    </header>
    <div class="clips">
      {
        flights.items.map((c) => (
          <figure class="clip-card">
            {c.video && <Clip video={c.video} poster={c.poster} title={c.title} />}
            <figcaption>
              <strong>{c.title}</strong>
              {c.text && <span>{c.text}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
    {flights.note && <p class="section__note">{flights.note}</p>}
  </div>
</section>

<style>
  .clips {
    display: grid;
    gap: 32px 28px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }
  .clip-card figcaption {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: 0;
    display: grid;
    gap: 2px;
  }
  .clip-card figcaption strong {
    color: var(--text);
  }
  @media (min-width: 760px) {
    .clips {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
