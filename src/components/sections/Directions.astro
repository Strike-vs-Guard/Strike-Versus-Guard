---
/**
 * Research directions and applications (content/programme/directions.md). Holds #directions.
 * A plain numbered list (two columns from 900 px); the application tags read as one sentence.
 */
import { section } from './content';

interface Props {
  alt?: boolean;
}
const { alt = false } = Astro.props;
const directions = await section('directions');
/* Lower-case the first letter of each tag after the first, unless it looks like an acronym ("UAV"). */
const soft = (t: string) => (/^[A-Z][a-z]/.test(t) ? t[0].toLowerCase() + t.slice(1) : t);
const tags = directions.tags.map((t, i) => (i === 0 ? t : soft(t)));
const tagSentence =
  tags.length < 2 ? tags.join('') : `${tags.slice(0, -1).join(', ')} and ${tags[tags.length - 1]}`;
---

<section id="directions" class:list={['section', { 'section--alt': alt }]}>
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{directions.eyebrow}</p>
      <h2>{directions.title}</h2>
    </header>
    {
      directions.items.length > 0 && (
        <ol class="dir-list">
          {directions.items.map((d, i) => (
            <li>
              <span class="dir-list__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{d.title}</h3>
                {d.text && <p class="muted">{d.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      )
    }
    {
      tags.length > 0 && (
        <p class="dir-tags muted">
          {directions.tagsLabel ?? 'Applications'}: {tagSentence}.
        </p>
      )
    }
  </div>
</section>

<style>
  .dir-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 56px;
  }
  @media (min-width: 900px) {
    .dir-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .dir-list li {
    display: grid;
    grid-template-columns: 3.5ch minmax(0, 1fr);
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
    max-width: 68ch;
  }
  .dir-list__n {
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
    padding-top: 0.3em;
  }
  .dir-list h3 {
    margin: 0 0 2px;
  }
  .dir-list p {
    margin: 0;
  }
  .dir-tags {
    margin: 32px 0 0;
    max-width: 68ch;
  }
</style>
