---
/**
 * Home: the four partner logos, each a white 2:1 plate (src/lib/logo.ts; invisible on the white page in
 * light, a tile in dark) linking to its page, then "Funded by" and the funder's plate, set apart.
 */
import { widePlate } from '../../lib/logo';
import { url } from '../../lib/url';
import { partnersInOrder } from './data';

const { partners, funder } = await partnersInOrder();
---

<div class="wrap lr" role="group" aria-label="Partners and funder">
  <ul class="lr__four">
    {
      partners.map((p) => (
        <li>
          <a class="logo-well" href={p.data.page ? url(`partners/${p.id}/`) : p.data.website} title={p.data.institution}>
            <img {...widePlate(p)} loading="lazy" decoding="async" />
          </a>
        </li>
      ))
    }
  </ul>
  {
    funder && (
      <a class="lr__funded" href={funder.data.website} title={funder.data.institution}>
        <span>Funded by</span>
        <span class="logo-well lr__fwell">
          <img {...widePlate(funder, funder.data.logoAlt ?? funder.data.short)} loading="lazy" decoding="async" />
        </span>
      </a>
    )
  }
</div>

<style>
  .lr {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 28px;
  }
  .lr__four {
    flex: 1;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* tiles 170 px wide at most (85 px tall), spread across the row */
    grid-template-columns: repeat(4, minmax(0, 170px));
    justify-content: space-between;
    gap: 16px;
  }
  .lr__funded {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 72px;
    padding-left: 20px;
    border-left: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .lr__funded:hover span:first-child {
    text-decoration: underline;
  }
  .lr__fwell {
    width: 122px;
  }
  @media (max-width: 720px) {
    .lr {
      flex-direction: column;
      align-items: stretch;
    }
    .lr__four {
      grid-template-columns: repeat(2, minmax(0, 180px));
      justify-content: start;
      gap: 10px;
    }
    .lr__funded {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
