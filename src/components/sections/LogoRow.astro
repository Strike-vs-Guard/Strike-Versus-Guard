---
/** Home: the four partner logos in white wells (each links to its page), then "Funded by" and the funder's logo, set apart. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { logoSize } from '../../lib/logo';
import { url } from '../../lib/url';
import { partnersInOrder } from './data';

const { partners, funder } = await partnersInOrder();
/* Row logos: base 44 px, capped at the well's 48 px inner height (src/lib/logo.ts). */
const logo = (img: ImageMetadata) => logoSize(img, 44, 48);
---

<div class="wrap lr" role="group" aria-label="Partners and funder">
  <ul class="lr__four">
    {
      partners.map((p) => (
        <li>
          <a class="logo-well lr__well" href={p.data.page ? url(`partners/${p.id}/`) : p.data.website} title={p.data.institution}>
            <Image src={p.data.logo} alt={p.data.logoAlt ?? p.data.institution} {...logo(p.data.logo)} densities={[1, 2]} />
          </a>
        </li>
      ))
    }
  </ul>
  {
    funder && (
      <a class="lr__funded" href={funder.data.website} title={funder.data.institution}>
        <span>Funded by</span>
        <span class="logo-well lr__fwell">
          <Image src={funder.data.logo} alt={funder.data.logoAlt ?? funder.data.short} {...logoSize(funder.data.logo, 36, 40)} densities={[1, 2]} />
        </span>
      </a>
    )
  }
</div>

<style>
  .lr {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 28px;
  }
  .lr__four {
    flex: 1;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .lr__well {
    --logo-base: 44px;
    --logo-max: 48px;
    height: 76px;
    padding: 14px 18px;
  }
  .lr__well:hover {
    border-color: var(--muted);
  }
  .lr__funded {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding-left: 20px;
    border-left: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .lr__funded:hover span:first-child {
    text-decoration: underline;
  }
  .lr__fwell {
    --logo-base: 36px;
    --logo-max: 40px;
    width: 52px;
    height: 52px;
    padding: 6px;
  }
  @media (max-width: 720px) {
    .lr {
      flex-direction: column;
      align-items: stretch;
    }
    .lr__four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .lr__well {
      height: 64px;
      padding: 10px 14px;
    }
    .lr__funded {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
