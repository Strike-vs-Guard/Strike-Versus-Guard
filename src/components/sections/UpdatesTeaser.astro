---
/** The latest updates as a dated log (UpdateLog, one-line summaries), with "All updates". Holds #updates. */
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
import UpdateLog from '../UpdateLog.astro';

interface Props {
  limit?: number;
}
const { limit = 3 } = Astro.props;
const updates = (await getCollection('updates', (u) => !u.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);
---

{
  updates.length > 0 && (
    <section id="updates" class="section">
      <div class="wrap">
        <header class="section__head section__head--row">
          <div>
            <p class="eyebrow">Updates</p>
            <h2>Latest from the programme</h2>
          </div>
          <a class="arrow-link" href={url('updates/')}>All updates →</a>
        </header>
        <UpdateLog updates={updates} compact />
      </div>
    </section>
  )
}
