---
/**
 * The game (home page): title and intro (the body of content/programme/benchmark.md, with the
 * blue/red legend), then the animated arena on the left; on the right the four steps in a 2×2 grid,
 * the "What they decide" list (content/programme/overview.md `decisions`) and the note
 * (content/programme/benchmark.md). Holds #benchmark.
 */
import Arena from '../Arena.astro';
import { section } from './content';

const benchmark = await section('benchmark');
const overview = await section('overview');
---

<section id="benchmark" class="section">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{benchmark.eyebrow}</p>
      <h2>{benchmark.title}</h2>
      <div class="prose"><benchmark.Content /></div>
    </header>
    <Arena steps={benchmark.items} layout="grid">
      {
        overview.decisions.length > 0 && (
          <div class="decide">
            <h3>{overview.decisionsLabel}</h3>
            <ul>
              {overview.decisions.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </div>
        )
      }
      {benchmark.note && <p class="section__note game-note">{benchmark.note}</p>}
    </Arena>
  </div>
</section>

<style>
  .decide h3 {
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .decide ul {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    max-width: 68ch;
  }
  .decide li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 6px;
    font-size: var(--step-0);
  }
  .decide li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.75em;
    width: 8px;
    height: 1px;
    background: var(--muted);
  }
  .game-note {
    margin: 0;
  }
</style>
