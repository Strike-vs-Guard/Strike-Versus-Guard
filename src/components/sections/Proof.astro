---
/**
 * "Proof so far" (home page): eyebrow, title and note from content/programme/proof.md; a one-line
 * year bar from content/programme/milestones.md (the `current: true` item); the four flight clips
 * from content/programme/flights.md 4-across with titles and one-liners; then "All flights →".
 * Clips show the flight half of each video (the ground station half is shown on the Flights page).
 * A clip loads only when played (Clip, `button` variant).
 */
import { url } from '../../lib/url';
import Clip from '../Clip.astro';
import { section } from './content';

const proof = await section('proof');
const flights = await section('flights');
const milestones = await section('milestones');
const items = milestones.items;
const cur = items.findIndex((m) => m.current);
if (cur < 0) throw new Error('No milestone has `current: true` in content/programme/milestones.md');
const now = items[cur];
---

<section class="section proof" aria-labelledby="proof-title">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{proof.eyebrow}</p>
      <h2 id="proof-title">{proof.title}</h2>
    </header>

    <div class="yearbar">
      <p class="yearbar__text">
        <span>
          {now.label} of {items.length} · {now.when} ·
        </span>
        <span class="yearbar__here">We are here</span>
        <span class="yearbar__goal">{now.title}</span>
      </p>
      <div class="yearbar__line" aria-hidden="true" style={`--n: ${items.length}`}>
        {items.map((_, i) => (
          <span class:list={{ 'is-past': i < cur, 'is-now': i === cur }} />
        ))}
      </div>
    </div>

    <div class="pclips">
      {
        flights.items.slice(0, 4).map((c) => (
          <figure class="pclip">
            {c.video && (
              <Clip video={c.video} poster={c.poster} title={c.title} variant="button" aspect="16 / 9" flight />
            )}
            <figcaption>
              <h3>{c.title}</h3>
              {c.text && <p>{c.text}</p>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="proof__foot">
      {proof.note && <p class="section__note">{proof.note}</p>}
      <a class="arrow-link" href={url('flights/')}>All flights →</a>
    </div>
  </div>
</section>

<style>
  .yearbar {
    margin-bottom: 28px;
  }
  .yearbar__text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    font: 500 var(--step--1) var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .yearbar__here {
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 1px 8px;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  .yearbar__goal {
    color: var(--text);
    text-transform: none;
    letter-spacing: 0;
    font: 600 var(--step-0) var(--font-body);
  }
  .yearbar__line {
    display: grid;
    grid-template-columns: repeat(var(--n, 3), 1fr);
    gap: 4px;
    margin-top: 10px;
    max-width: 520px;
  }
  .yearbar__line span {
    height: 3px;
    border-radius: 2px;
    background: var(--border);
  }
  .yearbar__line .is-past {
    background: var(--muted);
  }
  .yearbar__line .is-now {
    background: var(--accent);
  }

  .pclips {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 1.6vw, 24px);
  }
  .pclip figcaption {
    margin: 0;
    font-family: var(--font-body);
    letter-spacing: 0;
    color: var(--text);
  }
  .pclip h3 {
    font-size: var(--step-1);
    margin: 12px 0 4px;
  }
  .pclip p {
    font-size: var(--step-0);
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }
  .proof__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    margin-top: 28px;
  }
  .proof__foot .section__note {
    margin: 0;
  }
  @media (max-width: 1100px) {
    .pclips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .pclips {
      grid-template-columns: 1fr;
    }
  }
</style>
