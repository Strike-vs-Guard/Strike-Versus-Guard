---
/**
 * "How a command travels" (content/programme/command.md) on the Programme page: one row of labelled
 * boxes, left to right, joined by arrows. An item's `passes:` labels the arrow after it. On phones the
 * row turns into a column with downward arrows. Holds #command-path.
 */
import PartnerChips from '../PartnerChips.astro';
import { section } from './content';

interface Props {
  alt?: boolean;
}
const { alt = false } = Astro.props;
const d = await section('command');
const { Content } = d;
---

<section id="command-path" class:list={['section', { 'section--alt': alt }]} aria-labelledby="command-path-title">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 id="command-path-title">{d.title}</h2>
      <div class="prose"><Content /></div>
    </header>
    <ol class="cp">
      {
        d.items.map((s, i) => (
          <li class="cp__step">
            <div class="card cp__box">
              {s.label && <p class="eyebrow">{s.label}</p>}
              <h3>{s.title}</h3>
              {s.partners.length > 0 && <PartnerChips ids={s.partners} />}
              {s.text && <p class="cp__text muted">{s.text}</p>}
            </div>
            {i < d.items.length - 1 && (
              <p class="cp__arrow">
                <span class="cp__glyph" aria-hidden="true" />
                {s.passes ? <span class="cp__label">{s.passes}</span> : <span class="visually-hidden">then</span>}
              </p>
            )}
          </li>
        ))
      }
    </ol>
    {d.note && <p class="section__note">{d.note}</p>}
  </div>
</section>

<style>
  .cp {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .cp__step {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .cp__box {
    padding: 18px 20px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .cp__box .eyebrow,
  .cp__box h3,
  .cp__text {
    margin: 0;
  }
  .cp__box h3 {
    font-size: var(--step-1);
  }
  .cp__text {
    font-size: var(--step-0);
  }
  .cp__arrow {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0 10px 24px;
    min-height: 48px;
  }
  .cp__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* A plain line with an arrowhead: down on phones, right on wide screens. */
  .cp__glyph {
    position: relative;
    flex: none;
    width: 2px;
    height: 32px;
    background: var(--muted);
  }
  .cp__glyph::after {
    content: '';
    position: absolute;
    left: -5px;
    bottom: -2px;
    border: 6px solid transparent;
    border-top: 8px solid var(--muted);
    border-bottom: 0;
  }
  @media (min-width: 1000px) {
    .cp {
      flex-direction: row;
      align-items: stretch;
    }
    .cp__step {
      flex-direction: row;
      flex: 1 1 0;
      min-width: 0;
    }
    .cp__step:last-child {
      flex: 0.78 1 0;
    }
    .cp__box {
      flex: 1 1 auto;
      min-width: 0;
    }
    .cp__arrow {
      flex: 0 0 112px;
      flex-direction: column-reverse;
      justify-content: center;
      gap: 8px;
      padding: 0 10px;
      text-align: center;
    }
    .cp__glyph {
      width: 100%;
      height: 2px;
    }
    .cp__glyph::after {
      left: auto;
      right: -2px;
      bottom: -5px;
      border: 6px solid transparent;
      border-left: 8px solid var(--muted);
      border-right: 0;
    }
  }
</style>
