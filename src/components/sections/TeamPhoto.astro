---
/** The team photo from content/programme/stack.md, at the content width. */
import { Image } from 'astro:assets';
import { section } from './content';

const stack = await section('stack');
---

<section class="section section--team">
  <div class="wrap">
    {
      stack.image && (
        <figure class="team-photo">
          <Image
            class="media-edge"
            src={stack.image}
            alt={stack.imageAlt ?? ''}
            widths={[600, 1000, 1400, 1800]}
            sizes="(min-width: 1320px) 1320px, 100vw"
          />
          {stack.caption && <figcaption>{stack.caption}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  .team-photo :global(img) {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: center 60%;
  }
</style>
