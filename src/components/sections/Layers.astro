---
/**
 * Home page: the five layers on the annotated drone (DroneDiagram, explain mode).
 * A click lights the layer here; each callout links to the connection diagram on
 * `partnersHref` (the Partners page), which selects that layer from the hash.
 */
import DroneDiagram from '../DroneDiagram.astro';
import { getSystemData } from '../../lib/system';
import { section } from './content';

interface Props {
  partnersHref: string;
}
const { partnersHref } = Astro.props;
const stack = await section('stack');
const system = await getSystemData();
---

<section class="section section--alt">
  <div class="wrap">
    <header class="section__head section__head--row">
      <div>
        <p class="eyebrow">{stack.eyebrow}</p>
        <h2>{stack.title}</h2>
        <p class="sys-hint">What each layer does, top to bottom. Select a layer to light it on the drone.</p>
      </div>
      <a class="btn btn--ghost" href={`${partnersHref}#who`}>Who works on each layer →</a>
    </header>
    <DroneDiagram data={system} mode="explain" partnersHref={partnersHref} />
  </div>
</section>

<style>
  .sys-hint {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: var(--step-0);
  }
</style>
