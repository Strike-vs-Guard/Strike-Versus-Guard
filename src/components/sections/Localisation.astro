---
/**
 * Localisation (content/programme/localisation.md).
 * Default: the full section (Programme page): the three questions as a row of cards (`items:`), the
 * rule (`note:`), the body (why, how, status, the plan as targets) and the figure (`image:`, `caption:`).
 * `statusOnly`: just the one-sentence `status:` line
 * (Flights page). A missing file fails the build, as for every other section. `alt` gives the full
 * section the alternate background.
 */
import { Image } from 'astro:assets';
import { url } from '../../lib/url';
import { section } from './content';

interface Props {
  statusOnly?: boolean;
  alt?: boolean;
}
const { statusOnly = false, alt = false } = Astro.props;
const d = await section('localisation');
const { Content } = d;
---

{
  !statusOnly && (
    <section id="localisation" class:list={['section', { 'section--alt': alt }]}>
      <div class="wrap">
        <header class="section__head">
          <p class="eyebrow">{d.eyebrow}</p>
          <h2>{d.title}</h2>
        </header>
        {d.items.length > 0 && (
          <ol class="loc-q">
            {d.items.map((q) => (
              <li class="card loc-q__card">
                {q.label && <p class="eyebrow">{q.label}</p>}
                <h3>{q.title}</h3>
                {q.text && <p class="muted">{q.text}</p>}
              </li>
            ))}
          </ol>
        )}
        {d.note && <p class="loc-rule">{d.note}</p>}
        <div class="prose md loc"><Content /></div>
        {d.image && (
          <figure class="loc-fig">
            <Image src={d.image} alt={d.imageAlt ?? ''} widths={[600, 1240]} sizes="(min-width: 900px) 820px, 100vw" />
            {d.caption && <figcaption>{d.caption}</figcaption>}
          </figure>
        )}
      </div>
    </section>
  )
}
{
  statusOnly && d.status && (
    <section class="section section--alt">
      <div class="wrap">
        <header class="section__head">
          <p class="eyebrow">{d.eyebrow}</p>
          <h2>{d.title}</h2>
          <div class="prose">
            <p>{d.status}</p>
          </div>
        </header>
        <a class="btn btn--ghost" href={url('programme/#localisation')}>How localisation works →</a>
      </div>
    </section>
  )
}

<style>
  .loc :global(strong) {
    font-weight: 600;
  }
  .loc :global(table) {
    max-width: 52ch;
    margin: 0 0 1em;
  }
  .loc-q {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  @media (min-width: 900px) {
    .loc-q {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .loc-q__card {
    padding: 20px 22px;
  }
  .loc-q__card .eyebrow {
    margin-bottom: 6px;
  }
  .loc-q__card h3 {
    margin: 0 0 6px;
  }
  .loc-q__card .muted {
    margin: 0;
    font-size: var(--step-0);
  }
  .loc-rule {
    max-width: 68ch;
    margin: 20px 0 clamp(24px, 4vw, 40px);
    padding: 14px 18px;
    border: 1px dashed var(--muted);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .loc-fig {
    max-width: 820px;
    margin-top: 8px;
  }
  .loc-fig :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
    border-radius: 8px;
  }
</style>
