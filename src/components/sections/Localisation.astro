---
/**
 * Localisation (content/programme/localisation.md).
 * Default: the full section (Programme page). `statusOnly`: just the one-sentence `status:` line
 * (Flights page). A missing file fails the build, as for every other section. `alt` gives the full
 * section the alternate background.
 */
import { url } from '../../lib/url';
import { section } from './content';

interface Props {
  statusOnly?: boolean;
  alt?: boolean;
}
const { statusOnly = false, alt = false } = Astro.props;
const d = await section('localisation');
const { Content } = d;
---

{
  !statusOnly && (
    <section id="localisation" class:list={['section', { 'section--alt': alt }]}>
      <div class="wrap">
        <header class="section__head">
          <p class="eyebrow">{d.eyebrow}</p>
          <h2>{d.title}</h2>
        </header>
        <div class="prose loc"><Content /></div>
      </div>
    </section>
  )
}
{
  statusOnly && d.status && (
    <section class="section section--alt">
      <div class="wrap">
        <header class="section__head">
          <p class="eyebrow">{d.eyebrow}</p>
          <h2>{d.title}</h2>
          <div class="prose">
            <p>{d.status}</p>
          </div>
        </header>
        <a class="btn btn--ghost" href={url('programme/#localisation')}>How localisation works →</a>
      </div>
    </section>
  )
}

<style>
  .loc :global(strong) {
    font-weight: 600;
  }
</style>
