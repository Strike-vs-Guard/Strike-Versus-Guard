---
/**
 * The annotated drone: a labelled line drawing that explains what each layer
 * of the system is. Used on the home page (mode "explain") and on partner pages
 * (mode "partner", with that partner's layers lit up).
 *
 * Content comes from content/programme/stack.md (layers) and each partner's
 * `work:` lines in content/partners/*.md. Styles are prefixed and global so the
 * script can build markup at runtime.
 */
import type { SystemData } from '../lib/system';
interface Props {
  data: SystemData;
  mode?: 'explain' | 'partner';
  /** explain mode: CSS selector of the connection diagram to drive */
  target?: string;
  /** explain mode: element to scroll to after a label is clicked */
  scrollTo?: string;
  /** partner mode: partner id to light up */
  partner?: string;
}
const { data, ...opts } = Astro.props;
const D = {
  section: data.section,
  layers: data.layers,
  partners_in_display_order: data.partners_in_display_order,
  sponsor: data.sponsor,
};
const LOGO = data.logos;
const LAB = data.labs;
const OPTS = opts;
---

<section class="pd" aria-labelledby="pd-title" data-opts={JSON.stringify(OPTS)}>
<header class="pd-head">
  <p class="pd-eyebrow" data-pd="eyebrow"></p>
  <h2 class="pd-title" id="pd-title" data-pd="title"></h2>
  <p class="pd-intro" data-pd="intro"></p>
  <p class="pd-fund" data-pd="fund"></p>
</header>

<div class="pd-stage">
  <svg class="pd-lines" aria-hidden="true"></svg>

  <figure class="pd-fig">
    <svg class="pd-ill" viewBox="0 0 420 440" role="img" aria-label="Line drawing of one quadcopter drone. A small planning graph above it links to two teammate drones (Strategy, 1). A dashed ring surrounds it (Safety, 2). A dotted flight path leads up to it (Flight, 3). The airframe itself is the Drones layer (4).">
      <defs>
        <g id="pd-mini">
          <line x1="-8" y1="-4" x2="-26" y2="-11"/><line x1="8" y1="-4" x2="26" y2="-11"/>
          <line x1="-8" y1="5" x2="-28" y2="12"/><line x1="8" y1="5" x2="28" y2="12"/>
          <rect x="-11" y="-7" width="22" height="14" rx="5" class="pd-solid"/>
          <ellipse cx="-26" cy="-12" rx="14" ry="4.5"/><ellipse cx="26" cy="-12" rx="14" ry="4.5"/>
          <ellipse cx="-28" cy="11" rx="15" ry="5" class="pd-solid"/><ellipse cx="28" cy="11" rx="15" ry="5" class="pd-solid"/>
        </g>
      </defs>

      <!-- integration frame (phones only; desktop draws it around the whole diagram) -->
      <g class="pd-svgframe pd-g" data-layer="integration">
        <path d="M4 24V4h20M396 4h20v20M416 416v20h-20M24 436H4v-20" class="pd-ink" stroke-width="1.6"/>
      </g>

      <!-- 2 Safety ring (drawn first, sits behind) -->
      <g class="pd-g" data-layer="safety">
        <ellipse class="pd-ring" cx="210" cy="268" rx="172" ry="80"/>
      </g>

      <!-- 1 Strategy: planner graph + teammates -->
      <g class="pd-g" data-layer="strategy">
        <line class="pd-link" x1="176" y1="70" x2="96" y2="134"/>
        <line class="pd-link" x1="244" y1="70" x2="324" y2="134"/>
        <line class="pd-link" x1="210" y1="78" x2="210" y2="238"/>
        <g class="pd-faint" transform="translate(74 146)"><use href="#pd-mini"/></g>
        <g class="pd-faint" transform="translate(346 146)"><use href="#pd-mini"/></g>
        <rect class="pd-bubble pd-solid pd-ink" x="170" y="22" width="80" height="56" rx="16"/>
        <g class="pd-ink">
          <line x1="210" y1="50" x2="189" y2="38"/><line x1="210" y1="50" x2="231" y2="38"/>
          <line x1="210" y1="50" x2="194" y2="64"/><line x1="210" y1="50" x2="227" y2="64"/>
          <line x1="189" y1="38" x2="194" y2="64"/><line x1="231" y1="38" x2="227" y2="64"/>
        </g>
        <circle class="pd-inkfill" cx="210" cy="50" r="4.6"/>
        <circle class="pd-solid pd-ink" cx="189" cy="38" r="3.4"/><circle class="pd-solid pd-ink" cx="231" cy="38" r="3.4"/>
        <circle class="pd-solid pd-ink" cx="194" cy="64" r="3.4"/><circle class="pd-solid pd-ink" cx="227" cy="64" r="3.4"/>
      </g>

      <!-- 3 Flight path -->
      <g class="pd-g" data-layer="flight">
        <ellipse class="pd-pad" cx="40" cy="414" rx="20" ry="6"/>
        <ellipse class="pd-pad" cx="40" cy="414" rx="9" ry="2.8"/>
        <path class="pd-path" d="M40 406C52 360 96 394 126 370S160 334 176 322"/>
        <path class="pd-ink" d="M164 321l13.5 0-6 12" stroke-width="1.8"/>
        <text class="pd-lbl" x="70" y="430">AirStack</text>
      </g>

      <!-- 4 Drone airframe -->
      <g class="pd-g" data-layer="drones">
        <!-- rear rotors -->
        <ellipse class="pd-disc" cx="140" cy="232" rx="46" ry="14"/>
        <ellipse class="pd-disc" cx="280" cy="232" rx="46" ry="14"/>
        <line class="pd-blade" x1="102" y1="226" x2="178" y2="238"/>
        <line class="pd-blade" x1="242" y1="238" x2="318" y2="226"/>
        <!-- arms -->
        <g>
          <line class="pd-tube-o" x1="194" y1="256" x2="140" y2="238"/><line class="pd-tube-o" x1="226" y1="256" x2="280" y2="238"/>
          <line class="pd-tube-o" x1="192" y1="276" x2="126" y2="298"/><line class="pd-tube-o" x1="228" y1="276" x2="294" y2="298"/>
          <line class="pd-tube-i" x1="194" y1="256" x2="140" y2="238"/><line class="pd-tube-i" x1="226" y1="256" x2="280" y2="238"/>
          <line class="pd-tube-i" x1="192" y1="276" x2="126" y2="298"/><line class="pd-tube-i" x1="228" y1="276" x2="294" y2="298"/>
        </g>
        <!-- rear motors -->
        <path class="pd-solid pd-ink" d="M133 232v6a7 3.4 0 0 0 14 0v-6"/><ellipse class="pd-solid pd-ink" cx="140" cy="232" rx="7" ry="3.4"/>
        <path class="pd-solid pd-ink" d="M273 232v6a7 3.4 0 0 0 14 0v-6"/><ellipse class="pd-solid pd-ink" cx="280" cy="232" rx="7" ry="3.4"/>
        <!-- legs -->
        <path class="pd-ink" d="M198 286l-7 28M184 314h14M222 286l7 28M222 314h14"/>
        <!-- body -->
        <rect class="pd-body pd-solid pd-ink" x="178" y="244" width="64" height="44" rx="14"/>
        <rect x="188" y="251" width="44" height="24" rx="7"/>
        <circle class="pd-ink" cx="210" cy="258" r="4"/>
        <rect class="pd-solid pd-ink" x="202" y="281" width="16" height="9" rx="3"/>
        <circle class="pd-inkfill" cx="210" cy="285.5" r="1.8"/>
        <!-- front rotors -->
        <ellipse class="pd-disc" cx="126" cy="292" rx="50" ry="15"/>
        <ellipse class="pd-disc" cx="294" cy="292" rx="50" ry="15"/>
        <path class="pd-solid pd-ink" d="M118 292v7a8 3.8 0 0 0 16 0v-7"/>
        <path class="pd-solid pd-ink" d="M286 292v7a8 3.8 0 0 0 16 0v-7"/>
        <line class="pd-blade" x1="84" y1="296" x2="168" y2="286"/>
        <line class="pd-blade" x1="252" y1="286" x2="336" y2="296"/>
        <ellipse class="pd-solid pd-ink" cx="126" cy="292" rx="8" ry="3.8"/>
        <ellipse class="pd-solid pd-ink" cx="294" cy="292" rx="8" ry="3.8"/>
        <text class="pd-lbl" x="214" y="368" text-anchor="middle">Starling 2 Max</text>
      </g>

      <!-- numbered markers = leader-line anchors -->
      <g class="pd-mk" data-layer="strategy" data-anchor="strategy"><circle cx="160" cy="50" r="10"/><text x="160" y="50.5">1</text></g>
      <g class="pd-mk" data-layer="safety" data-anchor="safety"><circle cx="382" cy="268" r="10"/><text x="382" y="268.5">2</text></g>
      <g class="pd-mk" data-layer="flight" data-anchor="flight"><circle cx="70" cy="378" r="10"/><text x="70" y="378.5">3</text></g>
      <g class="pd-mk" data-layer="drones" data-anchor="drones"><line x1="338" y1="298" x2="362" y2="326" stroke="var(--muted)"/><circle cx="368" cy="334" r="10"/><text x="368" y="334.5">4</text></g>
    </svg>
  </figure>
</div>

<div class="pd-pwrap">
  <div class="pd-pbar">
    <h3 class="pd-ph">The partners</h3>
    <p class="pd-status" aria-live="polite"></p>
  </div>
  <ul class="pd-plist"></ul>
</div>
<script is:inline define:vars={{ D, LOGO, LAB, OPTS }}>
(function () {
  var root = (document.currentScript && document.currentScript.closest('section.pd')) || document.querySelector('section.pd');
  if (!root) return;
  var P = D.partners_in_display_order, L = D.layers;
  var q = function (s, el) { return (el || root).querySelector(s); };
  var qa = function (s, el) { return Array.prototype.slice.call((el || root).querySelectorAll(s)); };
  var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c]; }); };
  var who = function (lid) { return P.filter(function (p) { return p.work[lid]; }); };
  var layersOf = function (p) { return L.filter(function (l) { return p.work[l.id]; }); };
  var listWords = function (a) { return a.length < 2 ? a.join('') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1]; };
  var uid = 'pd' + Math.random().toString(36).slice(2, 7);
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  q('[data-pd=eyebrow]').textContent = D.section.eyebrow;
  q('[data-pd=title]').textContent = D.section.title;
  q('[data-pd=intro]').textContent = D.section.intro;
  q('[data-pd=fund]').textContent = D.sponsor.note;

  var chev = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>';
  var bracket = '<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 4.5V1h3.5M9.5 1H13v3.5M13 9.5V13H9.5M4.5 13H1V9.5"/></svg>';
  var tick = '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.2l2.4 2.4 4.6-5"/></svg>';
  var wellHTML = function (p) {
    return '<span class="pd-well"><img src="' + LOGO[p.id] + '" alt="' + esc(p.institution) + ' logo"><span class="pd-wdiv" aria-hidden="true"></span><img src="' + LAB[p.id] + '" alt="' + esc(p.lab) + ' logo"></span>';
  };

  /* callouts */
  var stage = q('.pd-stage');
  var cardId = uid + '-card';
  L.forEach(function (l) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'pd-co pd-co--' + l.id;
    b.dataset.layer = l.id;
    b.setAttribute('aria-expanded', 'false');
    b.setAttribute('aria-controls', cardId);
    b.innerHTML =
      '<span class="pd-co-head"><span class="pd-num" aria-hidden="true">' + (l.n ? l.n : bracket) + '</span>' +
      '<span class="pd-co-title">' + esc(l.title) + '</span>' +
      (l.n ? '' : '<span class="pd-co-tag">All layers</span>') + '</span>' +
      '<span class="pd-co-desc">' + esc(l.desc) + '</span>' +
      '<span class="pd-chips"><span class="pd-sr">Partners: </span>' + who(l.id).map(function (p) { return '<span class="pd-chip" data-p="' + p.id + '">' + esc(p.short) + '</span>'; }).join('') + '</span>' +
      '<span class="pd-cue"><span class="pd-cue-t">Who works on this</span>' + chev + '</span>';
    stage.appendChild(b);
  });

  var card = document.createElement('div');
  card.className = 'pd-card';
  card.id = cardId;
  card.setAttribute('role', 'region');
  card.hidden = true;
  stage.appendChild(card);

  /* partners */
  var plist = q('.pd-plist');
  P.forEach(function (p) {
    var n = layersOf(p).length;
    var li = document.createElement('li');
    li.className = 'pd-pcard';
    li.dataset.p = p.id;
    li.innerHTML =
      '<button type="button" class="pd-pbtn" aria-pressed="false" data-p="' + p.id + '">' + wellHTML(p) +
      '<span class="pd-pname">' + esc(p.short) + '</span>' +
      '<span class="pd-plab"><b>' + esc(p.lab) + '</b><br>' + esc(p.role) + '</span>' +
      '<span class="pd-tog"><span class="pd-box" aria-hidden="true">' + tick + '</span><span class="pd-tog-t">Highlight their ' + n + ' layer' + (n > 1 ? 's' : '') + '</span></span></button>' +
      '<div class="pd-pfoot"><a class="pd-more" href="' + esc(p.href) + '">See more →<span class="pd-sr"> about ' + esc(p.short) + '</span></a></div>';
    plist.appendChild(li);
  });

  var state = {layer: 'strategy', partner: null};

  function renderCard() {
    if (!state.layer) { card.hidden = true; return; }
    var l = L.filter(function (x) { return x.id === state.layer; })[0];
    var ps = who(l.id);
    var btn = q('.pd-co--' + l.id);
    btn.insertAdjacentElement('afterend', card);
    card.setAttribute('aria-label', l.title + ': who works on this');
    card.innerHTML =
      '<div><p class="pd-card-k">' + (l.n ? 'Layer ' + l.n : 'Spans all layers') + ' · ' + ps.length + ' partner' + (ps.length > 1 ? 's' : '') + '</p>' +
      '<p class="pd-card-t">' + esc(l.title) + '</p><p class="pd-card-d">' + esc(l.desc) + '</p></div>' +
      '<ul class="pd-ents" style="--pd-n:' + ps.length + '">' + ps.map(function (p) {
        return '<li class="pd-ent' + (state.partner === p.id ? ' is-match' : '') + '">' + wellHTML(p) +
          '<p class="pd-ent-n">' + esc(p.short) + ' <span>· ' + esc(p.lab) + '</span></p>' +
          '<p class="pd-ent-w">' + esc(p.work[l.id]) + '</p>' +
          '<a class="pd-more" href="' + esc(p.href) + '">See more →<span class="pd-sr"> about ' + esc(p.short) + '</span></a></li>';
      }).join('') + '</ul>';
    card.hidden = false;
  }

  function render() {
    var partner = state.partner && P.filter(function (p) { return p.id === state.partner; })[0];
    root.classList.toggle('has-partner', !!partner);
    qa('.pd-co').forEach(function (b) {
      var id = b.dataset.layer, open = id === state.layer;
      b.classList.toggle('is-open', open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      q('.pd-cue-t', b).textContent = open ? 'Hide partners' : 'Who works on this';
      b.classList.toggle('is-match', !!(partner && partner.work[id]));
      qa('.pd-chip', b).forEach(function (c) { c.classList.toggle('is-match', !!partner && c.dataset.p === partner.id); });
    });
    qa('.pd-ill .pd-g').forEach(function (g) { g.classList.toggle('is-on', g.dataset.layer === state.layer); });
    qa('.pd-ill .pd-mk').forEach(function (g) {
      g.classList.toggle('is-on', g.dataset.layer === state.layer);
      g.classList.toggle('is-match', !!(partner && partner.work[g.dataset.layer]));
    });
    qa('.pd-pcard').forEach(function (c) {
      var on = !!partner && c.dataset.p === partner.id, n = layersOf(P.filter(function (p) { return p.id === c.dataset.p; })[0]).length;
      c.classList.toggle('is-on', on);
      q('.pd-pbtn', c).setAttribute('aria-pressed', on ? 'true' : 'false');
      q('.pd-tog-t', c).textContent = on ? 'Highlighting ' + n + ' layer' + (n > 1 ? 's' : '') : 'Highlight their ' + n + ' layer' + (n > 1 ? 's' : '');
    });
    var st = q('.pd-status');
    if (partner) {
      st.innerHTML = '<strong>' + esc(partner.short) + '</strong> works on ' + esc(listWords(layersOf(partner).map(function (l) { return l.title; }))) + '. <button type="button" class="pd-clear">Clear</button>';
    } else {
      st.textContent = 'Select a partner to highlight the layers they work on.';
    }
    renderCard();
    draw();
  }

  root.addEventListener('click', function (e) {
    var co = e.target.closest('.pd-co'), pb = e.target.closest('.pd-pbtn'), cl = e.target.closest('.pd-clear');
    if (co && root.contains(co)) {
      state.layer = state.layer === co.dataset.layer ? null : co.dataset.layer;
      render();
      if (state.layer && card.getBoundingClientRect().bottom > window.innerHeight) {
        card.scrollIntoView({block: 'nearest', behavior: reduce ? 'auto' : 'smooth'});
      }
    } else if (pb && root.contains(pb)) {
      state.partner = state.partner === pb.dataset.p ? null : pb.dataset.p;
      render();
    } else if (cl && root.contains(cl)) {
      var was = state.partner;
      state.partner = null;
      render();
      var back = q('.pd-pbtn[data-p="' + was + '"]');
      if (back) back.focus();
    }
  });

  /* leader lines + integration frame (desktop only) */
  var lines = q('.pd-lines');
  var NS = 'http://www.w3.org/2000/svg';
  function el(tag, attrs) { var n = document.createElementNS(NS, tag); for (var k in attrs) n.setAttribute(k, attrs[k]); return n; }
  function draw() {
    if (getComputedStyle(lines).display === 'none') return;
    var sr = stage.getBoundingClientRect();
    var W = sr.width, H = sr.height;
    lines.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
    while (lines.firstChild) lines.removeChild(lines.firstChild);
    var partner = state.partner && P.filter(function (p) { return p.id === state.partner; })[0];
    ['strategy', 'safety', 'flight', 'drones'].forEach(function (id) {
      var b = q('.pd-co--' + id).getBoundingClientRect();
      var m = q('.pd-mk[data-anchor=' + id + '] circle').getBoundingClientRect();
      var left = b.left + b.width / 2 < sr.left + W / 2;
      var sx = (left ? b.right : b.left) - sr.left, sy = b.top - sr.top + 26;
      var mx = m.left + m.width / 2 - sr.left, my = m.top + m.height / 2 - sr.top;
      var kx = sx + (left ? 22 : -22);
      var on = id === state.layer, match = !!(partner && partner.work[id]);
      var cls = 'pd-ld' + (on ? ' is-on' : '') + (match ? ' is-match' : '');
      lines.appendChild(el('path', {d: 'M' + sx + ' ' + sy + 'H' + kx + 'L' + mx + ' ' + my, 'class': cls}));
      lines.appendChild(el('circle', {cx: sx, cy: sy, r: 2.6, 'class': cls}));
    });
    var ib = q('.pd-co--integration').getBoundingClientRect();
    var x0 = 14, y0 = 14, x1 = W - 14, y1 = ib.top - sr.top + 26, c = 22;
    lines.setAttribute('class', 'pd-lines' + (state.layer === 'integration' || (partner && partner.work.integration) ? ' is-int' : ''));
    lines.appendChild(el('path', {'class': 'pd-frame-edge', d: 'M' + x0 + ' ' + y0 + 'H' + x1 + 'V' + y1 + 'H' + x0 + 'Z'}));
    lines.appendChild(el('path', {'class': 'pd-frame-corner', d:
      'M' + x0 + ' ' + (y0 + c) + 'V' + y0 + 'H' + (x0 + c) +
      'M' + (x1 - c) + ' ' + y0 + 'H' + x1 + 'V' + (y0 + c) +
      'M' + x1 + ' ' + (y1 - c) + 'V' + y1 + 'H' + (x1 - c) +
      'M' + (x0 + c) + ' ' + y1 + 'H' + x0 + 'V' + (y1 - c)}));
  }

  render();
  if (window.ResizeObserver) new ResizeObserver(function () { draw(); }).observe(stage);
  else window.addEventListener('resize', draw);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
})();

/* ── Site modes ──────────────────────────────────────────────────────────
   OPTS.mode === 'explain': a label selects the same layer in the connection
     diagram (selector OPTS.target) and scrolls to OPTS.scrollTo.
   OPTS.mode === 'partner': light up OPTS.partner's layers, nothing else. */
(function () {
  var root = document.currentScript && document.currentScript.closest('section.pd');
  if (!root) return;
  root.classList.add('pd--site', 'pd--' + (OPTS.mode || 'explain'));
  root.querySelectorAll('.pd-co.is-open').forEach(function (b) { b.click(); });
  if (OPTS.mode === 'partner' && OPTS.partner) {
    var btn = root.querySelector('.pd-pbtn[data-p="' + OPTS.partner + '"]');
    if (btn && btn.getAttribute('aria-pressed') !== 'true') btn.click();
    return;
  }
  root.addEventListener('click', function (e) {
    var co = e.target.closest('.pd-co'); if (!co) return;
    var target = OPTS.target && document.querySelector(OPTS.target);
    var lb = target && target.querySelector('[data-sel="l:' + co.dataset.layer + '"]');
    if (lb && lb.getAttribute('aria-pressed') !== 'true') lb.click();
    if (co.classList.contains('is-open')) co.click();
    var to = OPTS.scrollTo && document.querySelector(OPTS.scrollTo);
    if (to) to.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  });
})();
</script>
</section>

<style is:global>
.pd{font-family:var(--font-body);color:var(--text);line-height:1.55}
.pd *,.pd *::before,.pd *::after{box-sizing:border-box}
.pd .pd-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* header */
.pd .pd-head{max-width:760px;margin:0 0 28px}
.pd .pd-eyebrow{font:500 13px/1.2 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 12px}
.pd .pd-title{font:700 clamp(30px,5vw,44px)/1.08 var(--font-display);letter-spacing:-.01em;margin:0 0 14px;color:var(--text)}
.pd .pd-intro{margin:0 0 16px;color:var(--muted);font-size:17px;max-width:64ch}
.pd .pd-fund{display:inline-flex;align-items:center;gap:10px;margin:0;font:500 12px/1 var(--font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.pd .pd-fund::before{content:"";width:22px;height:1px;background:var(--muted)}

/* stage */
.pd .pd-stage{position:relative;display:grid;
  grid-template-columns:minmax(0,1fr) minmax(360px,430px) minmax(0,1fr);
  grid-template-areas:"strat fig safe" "flight fig drones" "integ integ integ" "card card card";
  column-gap:36px;row-gap:18px;padding:44px 44px 36px;
  background-color:var(--surface);
  background-image:radial-gradient(circle,var(--grid) 1.3px,transparent 1.7px);
