---
/**
 * The annotated drone: a labelled line drawing that explains what each layer
 * of the system is. Drawing on the left, the numbered callouts in one column on the
 * right (top to bottom, like the stack), Integration as a bracket spanning them.
 *
 * mode "explain" (home page): callouts are buttons. Selecting one lights that
 *   layer. With `target`, it also tells the connection diagram on the same page
 *   (a `sys:select` event on document) and moves to it; selections made in the
 *   connection diagram light the drone too. With `partnersHref` (and no
 *   `target`), a click lights the layer locally only and each callout carries a
 *   "Who works on it" link to `${partnersHref}#layer-<id>`.
 * mode "partner" (partner pages): static. The partner's layers are lit and the
 *   callouts show the partner's own `work:` line for each.
 * mode "compact" (home page): static and short. The drawing (no dot grid, no leader
 *   lines) beside six plain rows: number, layer title and the partners on it.
 *
 * Content comes from content/programme/stack.md (layers) and each partner's
 * `work:` lines in content/partners/*.md. Styles are prefixed and global.
 */
import type { SystemData } from '../lib/system';
interface Props {
  data: SystemData;
  mode?: 'explain' | 'partner' | 'compact';
  /** explain mode: CSS selector of the connection diagram to drive */
  target?: string;
  /** explain mode: element to scroll to after a callout is selected (desktop) */
  scrollTo?: string;
  /** explain mode: page holding the connection diagram; callouts link to `${partnersHref}#layer-<id>` */
  partnersHref?: string;
  /** partner mode: partner id to light up */
  partner?: string;
}
const { data, mode = 'explain', target, scrollTo, partnersHref, partner } = Astro.props;
const uid = 'pd' + Math.random().toString(36).slice(2, 8);
const id = (s: string) => `${uid}-${s}`;
const explain = mode === 'explain';
const compact = mode === 'compact';
/* the "Who works on it" link replaces the in-button cue when the diagram is on another page */
const linkOut = explain && !!partnersHref && !target;

const numbered = data.layers.filter((l) => l.n != null).sort((a, b) => (a.n ?? 0) - (b.n ?? 0));
const layers = [...numbered, ...data.layers.filter((l) => l.n == null)];
const lastN = numbered.length ? numbered[numbered.length - 1].n : '';
const spans = `Spans layers 1–${lastN}`;
const range = `${numbered.length ? numbered[0].n : 1}–${lastN}`;
/* marker positions in the drawing, keyed by layer id; the numbers come from stack.md */
const MK: Record<string, [number, number]> = {
  strategy: [300, 72],
  safety: [433, 237],
  flight: [562, 297],
  localisation: [348, 368],
  drones: [250, 412],
};
/* what the drawing shows for each layer, for the drawing's text alternative */
const SHOWS: Record<string, string> = {
  strategy: 'the drone and two teammates are linked peer to peer by dashed lines and share one plan; there is no central controller',
  safety: 'a dashed ring around the drone, and a third teammate kept a safe distance away',
  flight: 'dotted waypoints that become a solid flown line arriving just below the drone, labelled AirStack: plan to flight',
  localisation: "the drone's own camera and a position fix beneath it",
  drones: 'the Starling 2 Max airframe',
};
const intLayer = data.layers.find((l) => l.n == null);
const illLabel = [
  'Line drawing of a quadcopter drone and its teammates.',
  ...numbered.filter((l) => SHOWS[l.id]).map((l) => `${l.n}, ${l.title}: ${SHOWS[l.id]}.`),
  intLayer ? `Corner marks around the drawing stand for ${intLayer.title}, which spans layers 1 to ${lastN}.` : '',
].filter(Boolean).join(' ');

const P = data.partners_in_display_order;
const pt = mode === 'partner' ? P.find((p) => p.id === partner) : undefined;
const whoOn = (layer: string) => P.filter((p) => p.work[layer]).map((p) => p.short).join(' · ');
const work = (pt?.work ?? {}) as Record<string, string | undefined>;
const lit = layers.filter((l) => !!work[l.id]).map((l) => l.id);
const listWords = (a: string[]) => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}`);

const rootClass = ['pd', `pd--${mode}`, lit.length ? 'has-sel' : '', ...lit.map((l) => `lit-${l}`)].filter(Boolean).join(' ');
const on = (layer: string) => (lit.includes(layer) ? ' is-on' : '');

const OPTS = {
  mode,
  target: target ?? null,
  scrollTo: scrollTo ?? null,
  partnersHref: partnersHref ?? null,
  lit,
  /* the numbered layers in stack order, for the leader lines */
  num: numbered.map((l) => l.id),
  /* which layers each partner works on, for selections made in the connection diagram */
  pw: Object.fromEntries(P.map((p) => [p.id, Object.keys(p.work)])),
};
const label = explain
  ? 'Annotated drone: what each layer of the system does'
  : compact
    ? 'Annotated drone: the layers of the system and who works on each'
    : `Annotated drone: the layers ${pt?.short ?? ''} works on`;
---

<div class={rootClass} role="group" aria-label={label}>
  {pt && <p class="pd-sr">{pt.short} works on {listWords(layers.filter((l) => work[l.id]).map((l) => l.title))}.</p>}
  <div class="pd-stage">
    {!compact && <svg class="pd-lines" aria-hidden="true" focusable="false"></svg>}

    <figure class="pd-fig">
      <svg class="pd-ill" viewBox="0 0 600 440" role="img" aria-label={illLabel}>
        <defs>
          <marker id={id('arr')} viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
            <path class="pd-arrow" d="M2 1.5L7.5 5 2 8.5" />
          </marker>
          <!-- the airframe, centred on 0 0; drawn once and reused for the teammates -->
          <g id={id('air')}>
            <g transform="translate(-210 -270)">
              <ellipse class="pd-a-disc" cx="140" cy="236" rx="46" ry="18" />
              <ellipse class="pd-a-disc" cx="280" cy="236" rx="46" ry="18" />
              <ellipse class="pd-a-disc" cx="122" cy="296" rx="50" ry="20" />
              <ellipse class="pd-a-disc" cx="298" cy="296" rx="50" ry="20" />
              <line class="pd-a-tube-o" x1="196" y1="258" x2="140" y2="238" /><line class="pd-a-tube-o" x1="224" y1="258" x2="280" y2="238" />
              <line class="pd-a-tube-o" x1="192" y1="276" x2="122" y2="298" /><line class="pd-a-tube-o" x1="228" y1="276" x2="298" y2="298" />
              <line class="pd-a-tube-i" x1="196" y1="258" x2="140" y2="238" /><line class="pd-a-tube-i" x1="224" y1="258" x2="280" y2="238" />
              <line class="pd-a-tube-i" x1="192" y1="276" x2="122" y2="298" /><line class="pd-a-tube-i" x1="228" y1="276" x2="298" y2="298" />
              <path class="pd-a-t2 pd-a-ink pd-a-fine" d="M133.5 236v5a6.5 2.6 0 0 0 13 0v-5" /><ellipse class="pd-a-t1 pd-a-ink pd-a-fine" cx="140" cy="236" rx="6.5" ry="2.6" />
              <path class="pd-a-t2 pd-a-ink pd-a-fine" d="M273.5 236v5a6.5 2.6 0 0 0 13 0v-5" /><ellipse class="pd-a-t1 pd-a-ink pd-a-fine" cx="280" cy="236" rx="6.5" ry="2.6" />
              <path class="pd-a-blade" d="M98 236.5Q119 231 140 233.5Q161 236 182 231.5Q161 238.5 140 235.8Q119 233.5 98 236.5Z" />
              <path class="pd-a-blade" d="M238 231.5Q259 236 280 233.5Q301 231 322 236.5Q301 233.5 280 235.8Q259 238.5 238 231.5Z" />
              <path class="pd-a-ink pd-a-fine" d="M200 280l-3 22M220 280l3 22" />
              <rect class="pd-a-t2 pd-a-ink pd-body" x="180" y="258" width="60" height="28" rx="8" />
              <rect class="pd-a-t1 pd-a-ink pd-body" x="178" y="246" width="64" height="24" rx="11" />
              <ellipse class="pd-a-solid pd-a-ink pd-a-fine" cx="210" cy="254" rx="9" ry="3.6" />
              <path class="pd-a-ink pd-a-fine" d="M201 254v3a9 3.6 0 0 0 18 0v-3" />
              <rect class="pd-a-solid pd-a-ink pd-a-fine" x="191" y="272" width="38" height="10" rx="5" />
              <circle class="pd-a-inkfill" cx="198" cy="277" r="1.9" /><circle class="pd-a-inkfill" cx="222" cy="277" r="1.9" />
              <circle class="pd-a-solid pd-a-ink pd-a-fine" cx="210" cy="277" r="3" /><circle class="pd-a-inkfill" cx="210" cy="277" r="1.2" />
              <rect class="pd-a-t2 pd-a-ink pd-a-fine" x="192" y="286" width="36" height="7" rx="2" />
              <path class="pd-a-ink" d="M190 284l-8 30M230 284l8 30M174 314h16M230 314h16" />
              <path class="pd-a-t2 pd-a-ink pd-a-fine" d="M115 296v6a7 2.8 0 0 0 14 0v-6" /><ellipse class="pd-a-t1 pd-a-ink pd-a-fine" cx="122" cy="296" rx="7" ry="2.8" />
              <path class="pd-a-t2 pd-a-ink pd-a-fine" d="M291 296v6a7 2.8 0 0 0 14 0v-6" /><ellipse class="pd-a-t1 pd-a-ink pd-a-fine" cx="298" cy="296" rx="7" ry="2.8" />
              <path class="pd-a-blade" d="M76 299Q99 292 122 293.5Q145 295 168 290Q145 298 122 296.2Q99 295 76 299Z" />
              <path class="pd-a-blade" d="M252 290Q275 295 298 293.5Q321 292 344 299Q321 295 298 296.2Q275 298 252 290Z" />
            </g>
          </g>
        </defs>

        <!-- Integration: corner crop marks; the edge shows only when lit -->
        <g class={`pd-g pd-int${on('integration')}`} data-layer="integration">
          <rect class="pd-int-edge" x="4" y="4" width="592" height="432" rx="2" />
          <path class="pd-crop" d="M4 28V4h24M572 4h24v24M596 412v24h-24M28 436H4v-24" />
        </g>

        <!-- Safety, back half of the ring (behind the drone) -->
        <g class={`pd-g${on('safety')}`} data-layer="safety">
          <ellipse class="pd-ringfill" cx="300" cy="276" rx="164" ry="66" />
          <path class="pd-ring" pathLength="380" d="M136 276A164 66 0 0 1 464 276" />
        </g>

        <!-- Strategy: three peers linked to each other, sharing one plan -->
        <g class={`pd-g${on('strategy')}`} data-layer="strategy">
          <path class="pd-link" d="M216 118H384M188 136L288 240M412 136L312 240" />
          <g class="pd-plan">
            <path d="M300 157L290 173H310Z" />
            <circle cx="300" cy="157" r="3" /><circle cx="290" cy="173" r="3" /><circle cx="310" cy="173" r="3" />
          </g>
          <text class="pd-lbl" x="300" y="194" text-anchor="middle">shared plan</text>
          <use class="pd-mate" href={`#${id('air')}`} transform="translate(170 120) scale(.32)" />
          <use class="pd-mate" href={`#${id('air')}`} transform="translate(430 120) scale(.32)" />
        </g>

        <!-- Safety: a teammate kept outside the ring -->
        <g class={`pd-g${on('safety')}`} data-layer="safety">
          <use class="pd-mate" href={`#${id('air')}`} transform="translate(62 300) scale(.32)" />
          <path class="pd-dim" d="M105 292V258M162 290V258M105 266H162M101 270l8-8M158 270l8-8" />
          <text class="pd-lbl pd-lbl-sm" x="134" y="252" text-anchor="middle">safe distance</text>
        </g>

        <!-- Drones: the airframe -->
        <g class={`pd-g pd-air${on('drones')}`} data-layer="drones">
          <ellipse class="pd-shadow" cx="300" cy="362" rx="44" ry="17.6" />
          <use class="pd-main" href={`#${id('air')}`} transform="translate(300 270)" />
          <path class="pd-tick" d="M266 317L254 401" />
          <circle class="pd-tickdot" cx="266" cy="317" r="2" />
          <text class="pd-lbl pd-lbl-air" x="232" y="416" text-anchor="end">Starling 2 Max</text>
        </g>

        <!-- Localisation: the drone's own camera looking forward-down, and the position fix it gives -->
        <g class={`pd-g${on('localisation')}`} data-layer="localisation">
          <path class="pd-link" d="M300 297L266 362M300 297L334 362" />
          <path class="pd-link" d="M266 362Q300 371 334 362" />
          <circle class="pd-dim" cx="300" cy="380" r="4.5" />
          <path class="pd-dim" d="M290 380h20M300 370v20" />
          <text class="pd-lbl pd-lbl-sm" x="300" y="402" text-anchor="middle">own camera</text>
        </g>

        <!-- Flight: dotted waypoints smoothing into a flown line -->
        <g class={`pd-g${on('flight')}`} data-layer="flight">
          <path class="pd-wp" d="M592 282C556 296 528 340 474 348" />
          <path class="pd-flown" d="M474 348C420 356 372 352 340 332" marker-end={`url(#${id('arr')})`} />
          <path id={id('fp')} class="pd-none" d="M340 332C372 352 420 356 474 348C528 340 556 296 592 282" />
          <text class="pd-lbl pd-lbl-path" dy="-7"><textPath href={`#${id('fp')}`} startOffset="14%">AirStack: plan → flight</textPath></text>
        </g>

        <!-- Safety, front half of the ring (over the drone) -->
        <g class={`pd-g${on('safety')}`} data-layer="safety">
          <path class="pd-ring" pathLength="380" d="M464 276A164 66 0 0 1 136 276" />
        </g>

        {explain && (
          <g class="pd-hits" aria-hidden="true">
            <path class="pd-hit" data-layer="strategy" d="M120 92H480V146L330 246H270L120 146Z" />
            <ellipse class="pd-hit pd-hit-ring" data-layer="safety" cx="300" cy="276" rx="164" ry="66" />
            <rect class="pd-hit" data-layer="safety" x="12" y="250" width="160" height="70" />
            <path class="pd-hit pd-hit-path" data-layer="flight" d="M592 282C556 296 528 340 474 348C420 356 372 352 340 332" />
            <rect class="pd-hit" data-layer="drones" x="176" y="218" width="248" height="100" />
            <!-- after drones so it sits on top: covers the whole camera wedge, which starts inside the drones rect -->
            <path class="pd-hit" data-layer="localisation" d="M300 293L260 365V408H340V365Z" />
            <path class="pd-hit" data-layer="integration" d="M0 0h40v40H0ZM560 0h40v40h-40ZM560 400h40v40h-40ZM0 400h40v40H0Z" />
          </g>
        )}

        <!-- numbered markers: leader-line anchors; numbers from stack.md, positions by layer id -->
        {numbered.filter((l) => MK[l.id]).map((l) => (
          <g class={`pd-mk${on(l.id)}`} data-layer={l.id}><circle cx={MK[l.id][0]} cy={MK[l.id][1]} r="11" /><text x={MK[l.id][0]} y={MK[l.id][1] + 0.5}>{l.n}</text></g>
        ))}
      </svg>
    </figure>

    {compact ? (
    <ol class="pd-rows">
      {layers.map((l) => {
        const span = l.n == null;
        return (
          <li class={`pd-row${span ? ' pd-row--span' : ''}`}>
            <span class="pd-num" aria-hidden="true">{span ? range : l.n}</span>
            <span class="pd-row-title">
              {l.title}
              {span && <span class="pd-row-tag">spans {range}</span>}
            </span>
            <span class="pd-row-who">{whoOn(l.id)}</span>
          </li>
        );
      })}
    </ol>
    ) : (
    <ol class="pd-cos">
      {layers.map((l) => {
        const span = l.n == null;
        const w = work[l.id];
        const head = (
          <span class="pd-co-head">
            <span class="pd-num" aria-hidden="true">
              {span ? (
                <svg viewBox="0 0 14 14"><path d="M1 4.5V1h3.5M9.5 1H13v3.5M13 9.5V13H9.5M4.5 13H1V9.5" /></svg>
              ) : (
                l.n
              )}
            </span>
            <span class="pd-co-title" id={id('t-' + l.id)}>{l.title}</span>
            {span && <span class="pd-co-tag" id={id('s-' + l.id)}>{spans}</span>}
            {explain && (linkOut
              ? <span class="pd-cue pd-cue--ph" aria-hidden="true">Who works on it <span class="pd-cue-a">→</span></span>
              : <span class="pd-cue" aria-hidden="true">Show partners <span class="pd-cue-a">↓</span></span>)}
          </span>
        );
        return explain ? (
          <li class={`pd-item${linkOut ? ' pd-item--link' : ''}`}>
            <button
              type="button"
              class={`pd-co pd-co--${l.id}`}
              data-layer={l.id}
              aria-labelledby={id('t-' + l.id)}
              aria-describedby={span ? `${id('d-' + l.id)} ${id('s-' + l.id)}` : id('d-' + l.id)}
            >
              {head}
              <span class="pd-co-desc" id={id('d-' + l.id)}>{l.desc}</span>
              <span class="pd-co-who">{whoOn(l.id)}</span>
            </button>
            {linkOut && (
              <a class="pd-cue pd-cue-link" href={`${partnersHref}#layer-${l.id}`} data-layer={l.id} aria-label={`Who works on ${l.title}`}>
                Who works on it <span class="pd-cue-a" aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ) : (
          <li class={`pd-co pd-co--${l.id}${w ? ' is-on' : ''}`} data-layer={l.id}>
            {head}
            {w ? (
              <>
                <span class="pd-co-work">{w}</span>
                <span class="pd-co-desc pd-co-desc--sm">{l.desc}</span>
              </>
            ) : (
              <span class="pd-co-desc">{l.desc}</span>
            )}
          </li>
        );
      })}
    </ol>
    )}
  </div>

  <script is:inline define:vars={{ OPTS }}>
  (function () {
    var root = document.currentScript && document.currentScript.closest('.pd');
    if (!root || OPTS.mode === 'compact') return;
    var explain = OPTS.mode !== 'partner';
    var stage = root.querySelector('.pd-stage');
    var lines = root.querySelector('.pd-lines');
    var NUM = OPTS.num || [];
    var ALL = NUM.concat('integration');
    var state = { layer: null, partner: null };
    var hoverPeek = null, focusPeek = null;
    var qa = function (s) { return Array.prototype.slice.call(root.querySelectorAll(s)); };
    var co = function (id) { return root.querySelector('.pd-co[data-layer="' + id + '"]'); };

    function litSet() {
      if (!explain) return OPTS.lit || [];
      if (state.layer) return [state.layer];
      if (state.partner && OPTS.pw[state.partner]) return OPTS.pw[state.partner];
      return [];
    }
    function render() {
      var L = litSet(), peek = hoverPeek || focusPeek;
      root.classList.toggle('has-sel', L.length > 0);
      ALL.forEach(function (id) {
        root.classList.toggle('lit-' + id, L.indexOf(id) >= 0);
        root.classList.toggle('peek-' + id, peek === id);
      });
      qa('[data-layer]').forEach(function (el) {
        var id = el.getAttribute('data-layer');
        el.classList.toggle('is-on', L.indexOf(id) >= 0);
        el.classList.toggle('is-peek', peek === id);
      });
      draw();
    }

    /* leader lines and the Integration bracket (desktop layout only) */
    var NS = 'http://www.w3.org/2000/svg';
    function el(tag, attrs) { var n = document.createElementNS(NS, tag); for (var k in attrs) n.setAttribute(k, attrs[k]); return n; }
    function draw() {
      while (lines.firstChild) lines.removeChild(lines.firstChild);
      var sr = stage.getBoundingClientRect();
      if (!sr.width || !sr.height) return;
      if (getComputedStyle(lines).display === 'none') return;
      lines.setAttribute('viewBox', '0 0 ' + sr.width + ' ' + sr.height);
      var L = litSet(), peek = hoverPeek || focusPeek;
      var cls = function (id, base) { return base + (L.indexOf(id) >= 0 ? ' is-on' : '') + (peek === id ? ' is-peek' : ''); };
      NUM.forEach(function (id) {
        var c = co(id), mk = root.querySelector('.pd-mk[data-layer="' + id + '"] circle');
        if (!c || !mk) return;
        var b = c.getBoundingClientRect(), n = c.querySelector('.pd-num').getBoundingClientRect(), m = mk.getBoundingClientRect();
        var sx = b.left - sr.left, sy = n.top + n.height / 2 - sr.top;
        var mx = m.left + m.width / 2 - sr.left, my = m.top + m.height / 2 - sr.top, r = m.width / 2;
        var kx = sx - 18, dx = kx - mx, dy = sy - my, d = Math.sqrt(dx * dx + dy * dy) || 1;
        lines.appendChild(el('path', { 'class': cls(id, 'pd-ld'), d: 'M' + (mx + dx / d * r) + ' ' + (my + dy / d * r) + 'L' + kx + ' ' + sy + 'H' + (sx - 4) }));
        lines.appendChild(el('circle', { 'class': cls(id, 'pd-ldot'), cx: sx - 4, cy: sy, r: 2.5 }));
      });
      var c1 = NUM.length && co(NUM[0]), c5 = NUM.length && co(NUM[NUM.length - 1]), ci = co('integration');
      if (c1 && c5 && ci) {
        var a = c1.getBoundingClientRect(), z = c5.getBoundingClientRect(), g = ci.getBoundingClientRect();
        var xr = a.right - sr.left, x = xr + 14, t = a.top - sr.top + 8, e = z.bottom - sr.top - 8, im = g.top + g.height / 2 - sr.top;
        lines.appendChild(el('path', { 'class': cls('integration', 'pd-brk'),
          d: 'M' + (x - 7) + ' ' + t + 'H' + x + 'V' + im + 'H' + (xr + 4) + 'M' + (x - 7) + ' ' + e + 'H' + x }));
        lines.appendChild(el('circle', { 'class': cls('integration', 'pd-ldot'), cx: xr + 4, cy: im, r: 2.5 }));
      }
    }

    if (window.ResizeObserver) new ResizeObserver(function () { draw(); }).observe(stage);
    else window.addEventListener('resize', draw);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
    render();
    if (!explain) return;

    /* ── explain mode ───────────────────────────────────────────────── */
    var mq = function (q) { return !!(window.matchMedia && matchMedia(q).matches); };
    function inView(n) {
      var r = n.getBoundingClientRect();
      return r.top >= 72 && r.bottom <= (window.innerHeight || document.documentElement.clientHeight);
    }
    function whenSettled(scrolled, fn) {
      if (!scrolled) return fn();
      var done = false, go = function () { if (done) return; done = true; window.removeEventListener('scrollend', go); fn(); };
      window.addEventListener('scrollend', go);
      setTimeout(go, 900);
    }
    function echo(btn, reduce) {
      btn.classList.remove('pc-echo', 'pc-echo-static');
      if (reduce) {
        btn.classList.add('pc-echo-static');
        btn.addEventListener('blur', function off() { btn.classList.remove('pc-echo-static'); btn.removeEventListener('blur', off); });
        return;
      }
      void btn.offsetWidth;
      btn.classList.add('pc-echo');
      btn.addEventListener('animationend', function off() { btn.classList.remove('pc-echo'); btn.removeEventListener('animationend', off); });
    }
    function activate(id) {
      state.layer = id; state.partner = null;
      render();
      /* the connection diagram is on another page: light the layer here only */
      if (OPTS.partnersHref && !OPTS.target) return;
      document.dispatchEvent(new CustomEvent('sys:select', { detail: { layer: id, partner: null, source: 'drone' } }));
      var tgt = OPTS.target && document.querySelector(OPTS.target);
      var btn = tgt && tgt.querySelector('[data-sel="l:' + id + '"]');
      /* phones: the connection diagram is stacked, so go straight to the layer; desktop: to the heading */
      var phone = mq('(max-width: 820px)');
      var dest = (phone ? btn : OPTS.scrollTo && document.querySelector(OPTS.scrollTo)) || btn;
      var reduce = mq('(prefers-reduced-motion: reduce)');
      var scrolled = false;
      /* scroll only if the destination (and the layer it leads to) is not already in view */
      if (dest && !(inView(dest) && (!btn || inView(btn)))) {
        dest.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: phone ? 'center' : 'start' });
        scrolled = !reduce;
      }
      if (btn) {
        btn.focus({ preventScroll: true });
        whenSettled(scrolled, function () { echo(btn, reduce); });
      }
    }

    root.addEventListener('click', function (e) {
      var t = e.target.closest('.pd-co, .pd-hit');
      if (t && root.contains(t)) activate(t.getAttribute('data-layer'));
    });
    root.addEventListener('mouseover', function (e) {
      var t = e.target.closest && e.target.closest('.pd-co, .pd-hit');
      var id = t && root.contains(t) ? t.getAttribute('data-layer') : null;
      if (id !== hoverPeek) { hoverPeek = id; render(); }
    });
    root.addEventListener('mouseleave', function () { if (hoverPeek) { hoverPeek = null; render(); } });
    root.addEventListener('focusin', function (e) {
      var t = e.target.closest('.pd-co, .pd-cue-link');
      focusPeek = t ? t.getAttribute('data-layer') : null; render();
    });
    root.addEventListener('focusout', function () { focusPeek = null; render(); });

    /* one shared selection with the connection diagram */
    document.addEventListener('sys:select', function (e) {
      var d = e.detail || {};
      if (d.source === 'drone') return;
      state.layer = d.layer || null; state.partner = d.partner || null;
      render();
    });

    /* the safety ring drifts only while on screen */
    if (window.IntersectionObserver) {
      new IntersectionObserver(function (es) { es.forEach(function (en) { root.classList.toggle('is-vis', en.isIntersecting); }); }).observe(stage);
    }
  })();
  </script>
</div>

<style is:global>
