---
/**
 * "Who works on each layer": partners on the left, layers on the right, a line
 * for each layer a partner works on. Select a partner or a layer to trace it.
 *
 * Content comes from content/programme/stack.md (layers) and each partner's
 * `work:` lines in content/partners/*.md. Styles are prefixed and global so the
 * script can build markup at runtime.
 *
 * Shares one selection with the annotated drone through a `sys:select` event on
 * document: it dispatches {layer, partner, source:'links'} whenever its own
 * selection changes, and follows events from other sources without re-dispatching.
 *
 * Opened with `#layer-<id>` in the address (the drone on another page links
 * here), it selects that layer on load and scrolls it into view.
 */
import type { SystemData } from '../lib/system';
interface Props {
  data: SystemData;
}
const { data, ...opts } = Astro.props;
const D = {
  section: data.section,
  layers: data.layers,
  partners_in_display_order: data.partners_in_display_order,
  sponsor: data.sponsor,
};
const LOGO = data.logos;
const LAB = data.labs;
const OPTS = opts;
---

<section class="pc" aria-labelledby="pc-title" data-opts={JSON.stringify(OPTS)}>
<header class="pc-head">
  <p class="pc-eyebrow" data-pc="eyebrow"></p>
  <h2 class="pc-title" id="pc-title" data-pc="title"></h2>
  <p class="pc-intro" data-pc="intro"></p>
  <p class="pc-meta"><span class="pc-fund" data-pc="fund"></span><span class="pc-how">Select a partner or a layer to trace who does what.</span></p>
</header>

<figure class="pc-fig">
  <div class="pc-body">
    <p class="pc-colhead pc-ph" id="pc-ph">Partners</p>
    <p class="pc-colhead pc-lh" id="pc-lh">Layers of the system</p>
    <svg class="pc-wires" aria-hidden="true" focusable="false"></svg>
    <ol class="pc-partners" aria-labelledby="pc-ph"></ol>
    <ol class="pc-layers" aria-labelledby="pc-lh"></ol>
    <div class="pc-cap" id="pc-cap" aria-live="polite"></div>
  </div>
</figure>
<script is:inline define:vars={{ D, LOGO, LAB, OPTS }}>
(function(){
  var root = (document.currentScript && document.currentScript.closest('section.pc')) || document.querySelector('section.pc');
  if (!root) return;
  var $ = function(s){ return root.querySelector(s); };

  /* glyphs echo the drone drawing: peers in a triangle, a ring round a dot,
     dotted-to-solid path, a camera wedge over a position cross, a small quad,
     corner crop marks */
  var ICON = {
    strategy:'<path d="M12 5.5 5.5 17.5h13Z" stroke-dasharray="2 2.2"/><circle cx="12" cy="5" r="2.3"/><circle cx="5" cy="18" r="2.3"/><circle cx="19" cy="18" r="2.3"/>',
    safety:'<ellipse cx="12" cy="12" rx="9.5" ry="9.5" stroke-dasharray="2.6 2.4"/><circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>',
    flight:'<path d="M3 19.5c1.5-.8 2.6-1.8 3.6-3" stroke-dasharray="0 3"/><path d="M8.5 14c2-2.6 4.4-4.6 10.5-6.5"/><path d="m15.8 5.4 3.4 2-2.2 3.2"/>',
    localisation:'<path d="M12 2.5 6 12.5M12 2.5l6 10" stroke-dasharray="2 2.2"/><circle cx="12" cy="17.5" r="2.6"/><path d="M12 13v9M7.5 17.5h9"/>',
    drones:'<rect x="9.5" y="9.5" width="5" height="5" rx="1.2"/><path d="m9.5 9.5-2.2-2.2m9.4 0-2.2 2.2m-5 5-2.2 2.2m9.4 0-2.2-2.2"/><circle cx="6" cy="6" r="2.8"/><circle cx="18" cy="6" r="2.8"/><circle cx="6" cy="18" r="2.8"/><circle cx="18" cy="18" r="2.8"/>',
    integration:'<path d="M3 8V3h5M16 3h5v5M21 16v5h-5M8 21H3v-5"/>'
  };

  var esc = function(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
  var P = D.partners_in_display_order;
  /* Numbered layers in order, then Integration below a rule, as on the drone. */
  var NUMBERED = D.layers.filter(function(l){ return l.n != null; }).sort(function(a,b){ return a.n - b.n; });
  var LAYERS = NUMBERED.concat(D.layers.filter(function(l){ return l.n == null; }));
  var SPANS = 'Spans layers 1–' + (NUMBERED.length ? NUMBERED[NUMBERED.length - 1].n : '');
  var layerById = {}; D.layers.forEach(function(l){ layerById[l.id] = l; });
  var partnerById = {}; P.forEach(function(p){ partnerById[p.id] = p; });
  var LINKS = [];
  P.forEach(function(p){ LINKS.push.apply(LINKS, LAYERS.filter(function(l){ return p.work[l.id]; }).map(function(l){ return {p:p.id, l:l.id}; })); });
  var layerLabel = function(l){ return l.n == null ? SPANS : 'Layer ' + l.n; };
  var partnersOn = function(lid){ return P.filter(function(p){ return p.work[lid]; }); };

  /* header */
  $('[data-pc="eyebrow"]').textContent = D.section.eyebrow;
  $('[data-pc="title"]').textContent = D.section.title;
  $('[data-pc="intro"]').textContent = D.section.intro;
  $('[data-pc="fund"]').textContent = D.sponsor.note;

  var well = function(p){
    return '<span class="pc-well"><img class="pc-li" src="' + LOGO[p.id] + '" alt="' + esc(p.institution) + ' logo"><span class="pc-rule" aria-hidden="true"></span><img class="pc-ll" src="' + LAB[p.id] + '" alt="' + esc(p.lab) + ' logo"></span>';
  };
  var hint = '<span class="pc-hint" aria-hidden="true"><span class="pc-h-off">Select</span><span class="pc-h-on">Selected</span></span>';

  /* partner nodes */
  $('.pc-partners').innerHTML = P.map(function(p){
    return '<li class="pc-node pc-pnode" data-p="' + p.id + '">' +
      '<button type="button" class="pc-btn pc-pbtn" aria-pressed="false" aria-controls="pc-cap" data-sel="p:' + p.id + '">' +
        well(p) +
        '<span class="pc-ptext"><span class="pc-ptop"><span class="pc-pname">' + esc(p.short) + '</span>' + hint + '</span><span class="pc-plab">' + esc(p.lab) + '</span><span class="pc-prole">' + esc(p.role) + '</span></span>' +
      '</button>' +
      '<a class="pc-more" href="' + esc(p.href) + '" aria-label="See more about ' + esc(p.short) + '">See more →</a>' +
    '</li>';
  }).join('');

  /* layer nodes */
  $('.pc-layers').innerHTML = LAYERS.map(function(l, i){
    var who = partnersOn(l.id);
    var span = l.n == null;
    return (span && i > 0 ? '<li class="pc-sep" aria-hidden="true"></li>' : '') +
      '<li class="pc-node pc-lnode' + (span ? ' pc-span' : '') + '" data-l="' + l.id + '">' +
      '<button type="button" class="pc-btn pc-lbtn" aria-pressed="false" aria-controls="pc-cap" data-sel="l:' + l.id + '">' +
        '<span class="pc-icon" aria-hidden="true"><svg viewBox="0 0 24 24">' + ICON[l.id] + '</svg></span>' +
        '<span><span class="pc-ltop"><span class="pc-lhead">' +
          (span ? '<span class="pc-ltitle">' + esc(l.title) + '</span><span class="pc-lnum">' + esc(SPANS) + '</span>'
                : '<span class="pc-lnum">Layer ' + l.n + ' ·</span> <span class="pc-ltitle">' + esc(l.title) + '</span>') +
        '</span>' + hint + '</span>' +
        '<span class="pc-lcount">' + who.length + ' partner' + (who.length === 1 ? '' : 's') + '</span>' +
        '<span class="pc-tags"><span class="pc-tags-sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Partners: </span>' +
          who.map(function(p){ return '<span class="pc-tag" data-p="' + p.id + '">' + esc(p.short) + '</span>'; }).join('') +
        '</span></span>' +
      '</button>' +
      '<div class="pc-lnote"></div>' +
    '</li>';
  }).join('');

  var svg = $('.pc-wires'), body = $('.pc-body'), cap = $('.pc-cap');
  var NS = 'http://www.w3.org/2000/svg';
  var sel = null; /* {t:'p'|'l', id} */
  var narrow = window.matchMedia('(max-width:820px)');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  var isOn = function(k){ return sel && ((sel.t === 'p' && k.p === sel.id) || (sel.t === 'l' && k.l === sel.id)); };

  function draw(animate){
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    if (narrow.matches) return;
    var b = body.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + b.width + ' ' + b.height);
    var rect = {};
    root.querySelectorAll('.pc-pnode, .pc-lnode').forEach(function(n){
      rect[n.dataset.p || n.dataset.l] = n.querySelector('.pc-btn').getBoundingClientRect();
    });
    /* fan out endpoints so links sharing a node don't overlap */
    var SP = 11, ends = {};
    var fan = function(key, list){ list.forEach(function(k, i){ (ends[k.p + k.l] = ends[k.p + k.l] || {})[key] = (i - (list.length - 1) / 2) * SP; }); };
    P.forEach(function(p){ fan('a', LINKS.filter(function(k){ return k.p === p.id; })); });
    LAYERS.forEach(function(l){ fan('b', LINKS.filter(function(k){ return k.l === l.id; })); });
    var gw = document.createElementNS(NS, 'g'), gd = document.createElementNS(NS, 'g');
    LINKS.forEach(function(k){
      var a = rect[k.p], z = rect[k.l];
      var x1 = a.right - b.left, y1 = a.top + a.height / 2 - b.top + ends[k.p + k.l].a;
      var x2 = z.left - b.left, y2 = z.top + z.height / 2 - b.top + ends[k.p + k.l].b;
      var dx = (x2 - x1) * 0.55;
      var st = sel ? (isOn(k) ? ' pc-on' : ' pc-off') : '';
      var path = document.createElementNS(NS, 'path');
      path.setAttribute('d', 'M' + x1 + ' ' + y1 + 'C' + (x1 + dx) + ' ' + y1 + ' ' + (x2 - dx) + ' ' + y2 + ' ' + x2 + ' ' + y2);
      path.setAttribute('class', 'pc-wire' + st + (animate && isOn(k) && !reduce.matches ? ' pc-anim' : ''));
      path.setAttribute('pathLength', '1');
      gw.appendChild(path);
      [[x1, y1], [x2, y2]].forEach(function(pt){
        var c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', pt[0]); c.setAttribute('cy', pt[1]); c.setAttribute('r', 3.2);
        c.setAttribute('class', 'pc-dot' + st);
        gd.appendChild(c);
      });
    });
    /* draw selected links last so they sit on top */
    Array.prototype.slice.call(gw.querySelectorAll('.pc-on')).forEach(function(n){ gw.appendChild(n); });
    svg.appendChild(gw); svg.appendChild(gd);
  }

  var item = function(k, v, more){
    return '<li class="pc-item"><span class="pc-itemk">' + k + '</span><span class="pc-itemv">' + esc(v) + '</span>' + (more || '') + '</li>';
  };

  function caption(){
    cap.classList.toggle('pc-cap-layer', !!sel && sel.t === 'l');
    if (!sel){
      cap.innerHTML = '<div class="pc-caprow"><p class="pc-capk">How to read this figure</p></div>' +
        '<div class="pc-empty">' +
          '<p><b>' + P.length + ' partners, ' + D.layers.length + ' layers, ' + LINKS.length + ' links</b>Each line joins a partner to a layer it works on.</p>' +
          '<p><b>Select a partner</b>to highlight its links and read what it contributes on each layer.</p>' +
          '<p><b>Select a layer</b>to see which partners work on it and how.</p>' +
        '</div>';
      return;
    }
    var reset = '<button type="button" class="pc-reset" data-reset>Show all links ✕</button>';
    if (sel.t === 'p'){
      var p = partnerById[sel.id];
      var rows = LAYERS.filter(function(l){ return p.work[l.id]; });
      cap.innerHTML = '<div class="pc-caprow"><p class="pc-capk">' + esc(p.short) + ' works on ' + rows.length + ' of ' + LAYERS.length + ' layers</p>' + reset + '</div>' +
        '<div class="pc-capgrid"><div>' +
          '<div class="pc-who">' + well(p) + '<div><p class="pc-capname">' + esc(p.institution) + '</p><p class="pc-capsub">' + esc(p.lab) + '</p></div></div>' +
          '<p class="pc-capdesc">' + esc(p.role) + ' · ' + esc(p.lead) + '</p>' +
          '<a class="pc-more pc-capmore" href="' + esc(p.href) + '" aria-label="See more about ' + esc(p.short) + '">See more →</a>' +
        '</div><ul class="pc-items">' +
          rows.map(function(l){ return item(esc(l.title) + ' <small>' + esc(layerLabel(l).toUpperCase()) + '</small>', p.work[l.id]); }).join('') +
        '</ul></div>';
    } else {
      var l = layerById[sel.id], who = partnersOn(l.id);
      var list = '<ul class="pc-items">' + who.map(function(p){
        return item(esc(p.short), p.work[l.id], '<a class="pc-more" href="' + esc(p.href) + '" aria-label="See more about ' + esc(p.short) + '">See more →</a>');
      }).join('') + '</ul>';
      cap.innerHTML = '<div class="pc-caprow"><p class="pc-capk">' + who.length + ' partner' + (who.length === 1 ? '' : 's') + ' on ' + esc(l.title) + '</p>' + reset + '</div>' +
        '<div class="pc-capgrid"><div><p class="pc-capname">' + esc(l.title) + '</p><p class="pc-capsub">' + esc(layerLabel(l)) + '</p><p class="pc-capdesc">' + esc(l.desc) + '</p></div>' + list + '</div>';
    }
  }

  function announce(){
    document.dispatchEvent(new CustomEvent('sys:select', { detail: {
      layer: sel && sel.t === 'l' ? sel.id : null,
      partner: sel && sel.t === 'p' ? sel.id : null,
      source: 'links'
    }}));
  }

  function apply(animate){
    root.querySelectorAll('[data-sel]').forEach(function(btn){
      btn.setAttribute('aria-pressed', String(!!sel && btn.dataset.sel === sel.t + ':' + sel.id));
    });
    root.querySelectorAll('.pc-pnode').forEach(function(n){
      var on = !sel || (sel.t === 'p' ? n.dataset.p === sel.id : !!partnerById[n.dataset.p].work[sel.id]);
      n.classList.toggle('pc-dim', !on);
    });
    root.querySelectorAll('.pc-lnode').forEach(function(n){
      var on = !sel || (sel.t === 'l' ? n.dataset.l === sel.id : !!partnerById[sel.id].work[n.dataset.l]);
      n.classList.toggle('pc-dim', !on);
      n.querySelectorAll('.pc-tag').forEach(function(t){
        var hit = sel && ((sel.t === 'p' && t.dataset.p === sel.id) || (sel.t === 'l' && n.dataset.l === sel.id));
        t.classList.toggle('pc-tag-on', !!hit);
        t.classList.toggle('pc-tag-off', !!sel && !hit);
      });
      /* phone: a selected layer expands in place, so the answer appears where you tapped */
      var note = n.querySelector('.pc-lnote');
      if (sel && sel.t === 'l' && n.dataset.l === sel.id){
        note.innerHTML = '<ul class="pc-items">' + partnersOn(sel.id).map(function(p){
          return item(esc(p.short), p.work[sel.id], '<a class="pc-more" href="' + esc(p.href) + '" aria-label="See more about ' + esc(p.short) + '">See more →</a>');
        }).join('') + '</ul>';
      } else note.innerHTML = '';
    });
    caption();
    draw(animate);
  }

  root.addEventListener('click', function(e){
    var r = e.target.closest('[data-reset]');
    if (r && root.contains(r)){
      var back = sel && root.querySelector('[data-sel="' + sel.t + ':' + sel.id + '"]');
      sel = null; apply(false); announce(); if (back) back.focus(); return;
    }
    var b = e.target.closest('[data-sel]');
    if (!b || !root.contains(b)) return;
    var parts = b.dataset.sel.split(':');
    sel = (sel && sel.t === parts[0] && sel.id === parts[1]) ? null : {t:parts[0], id:parts[1]};
    apply(true);
    announce();
  });
  root.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && sel){
      var back = root.querySelector('[data-sel="' + sel.t + ':' + sel.id + '"]');
      sel = null; apply(false); announce(); if (back) back.focus();
    }
  });

  /* follow selections made elsewhere (the drone); never re-dispatch */
  document.addEventListener('sys:select', function(e){
    var d = e.detail || {};
    if (d.source === 'links') return;
    var next = d.layer && layerById[d.layer] ? {t:'l', id:d.layer} : d.partner && partnerById[d.partner] ? {t:'p', id:d.partner} : null;
    var same = (!next && !sel) || (next && sel && next.t === sel.t && next.id === sel.id);
    sel = next;
    apply(!same);
  });

  var raf = 0;
  var redraw = function(){ cancelAnimationFrame(raf); raf = requestAnimationFrame(function(){ draw(false); }); };
  if ('ResizeObserver' in window){
    var ro = new ResizeObserver(redraw);
    ro.observe(body);
    root.querySelectorAll('.pc-btn').forEach(function(n){ ro.observe(n); });
  } else window.addEventListener('resize', redraw);
  if (narrow.addEventListener) narrow.addEventListener('change', redraw);
  root.querySelectorAll('img').forEach(function(img){ if (!img.complete) img.addEventListener('load', redraw); });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(redraw);

  /* #layer-<id> (from the drone's "Who works on it" link) selects that layer; an unknown
     id selects nothing. No element carries that id, so the browser does not jump; we
     scroll once laid out. */
  var h = /^#layer-([a-z]+)$/.exec(location.hash);
  if (h && layerById[h[1]]) sel = {t:'l', id:h[1]};
  apply(false);
  if (sel){
    announce();
    var go = function(){
      var b = root.querySelector('[data-sel="l:' + h[1] + '"]');
      if (b) b.scrollIntoView({block:'center'});
    };
    if (document.readyState === 'complete') go(); else window.addEventListener('load', go, {once:true});
  }
})();

</script>
</section>

<style is:global>
.pc{--pc-gap:14px;color:var(--text);font-family:var(--font-body)}
.pc *{box-sizing:border-box}
.pc .pc-head{max-width:760px;margin:0 0 28px}
.pc .pc-eyebrow{font:500 13px/1.4 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
.pc .pc-title{font:700 clamp(30px,4.2vw,42px)/1.08 var(--font-display);margin:0 0 14px;letter-spacing:-.005em}
.pc .pc-intro{margin:0 0 16px;color:var(--text);font-size:17px;line-height:1.6}
.pc .pc-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin:0;font:500 13px/1.4 var(--font-mono);color:var(--muted)}
.pc .pc-fund{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border:1px solid var(--border);border-radius:999px;background:var(--surface);color:var(--text)}
.pc .pc-how{font-family:var(--font-body);font-size:14px}

/* ---------- figure ---------- */
.pc .pc-fig{position:relative;margin:0;padding:22px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}
.pc .pc-body{position:relative;display:grid;grid-template-columns:minmax(0,440px) minmax(90px,1fr) minmax(0,390px);grid-template-areas:"ph . lh" "p . l" "c c c";column-gap:0;row-gap:10px}
.pc .pc-colhead{font:500 12px/1.4 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0}
.pc .pc-ph{grid-area:ph}.pc .pc-lh{grid-area:lh}
.pc .pc-wires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:0}
.pc .pc-partners,.pc .pc-layers{list-style:none;margin:0;padding:0;position:relative;z-index:1}
/* both columns fill the same row height, so six layer cards span the four partner cards */
.pc .pc-partners{grid-area:p;display:flex;flex-direction:column;justify-content:space-between;gap:var(--pc-gap)}
.pc .pc-layers{grid-area:l;display:flex;flex-direction:column;justify-content:space-between;gap:10px}
.pc .pc-pnode,.pc .pc-lnode{flex:1 1 0;display:flex;flex-direction:column}
.pc .pc-pnode > .pc-btn,.pc .pc-lnode > .pc-btn{flex:1}
.pc .pc-sep{height:0;border-top:1px solid var(--border);margin:4px 0 2px}

/* shared node/button look */
.pc .pc-node{position:relative;transition:opacity .25s ease}
.pc .pc-btn{all:unset;box-sizing:border-box;display:grid;width:100%;cursor:pointer;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);box-shadow:0 1px 0 var(--border);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease,background-color .18s ease;-webkit-tap-highlight-color:transparent}
@media (hover:hover){.pc .pc-btn:hover{transform:translateY(-2px);border-color:var(--muted);box-shadow:0 6px 16px -10px var(--text)}}
.pc .pc-btn:focus-visible{outline:2px solid var(--text);outline-offset:3px}
.pc .pc-btn[aria-pressed="true"]{border-color:var(--text);box-shadow:inset 0 0 0 1px var(--text);background:color-mix(in srgb,var(--text) 5%,var(--surface))}
/* Dimmed = muted label and a greyed logo, not a see-through card: opacity turned the white logo wells into grey slabs in dark. */
.pc .pc-node.pc-dim .pc-btn{color:var(--muted)}
.pc .pc-node.pc-dim .pc-well img{filter:grayscale(1);opacity:.5}
.pc .pc-node.pc-dim .pc-pname,.pc .pc-node.pc-dim .pc-ltitle{color:var(--muted)}
@media (hover:hover){.pc .pc-node.pc-dim:hover .pc-well img{filter:none;opacity:1}}
.pc .pc-node.pc-dim:focus-within .pc-well img{filter:none;opacity:1}
/* echo ring when the annotated drone hands focus to a layer here */
.pc .pc-btn.pc-echo{animation:pc-echo .7s cubic-bezier(.2,.7,.2,1)}
.pc .pc-btn.pc-echo-static{box-shadow:inset 0 0 0 1px var(--text),0 0 0 4px color-mix(in srgb,var(--text) 18%,transparent)}
@keyframes pc-echo{
  from{box-shadow:inset 0 0 0 1px var(--text),0 0 0 4px color-mix(in srgb,var(--text) 18%,transparent)}
  to{box-shadow:inset 0 0 0 1px var(--text),0 0 0 4px color-mix(in srgb,var(--text) 0%,transparent)}
}

/* select hint */
.pc .pc-hint{display:inline-flex;align-items:center;gap:6px;font:500 12px/1 var(--font-mono);letter-spacing:.04em;color:var(--muted)}
.pc .pc-hint::before{content:"";width:9px;height:9px;border-radius:50%;border:1.5px solid currentColor;box-sizing:border-box}
.pc .pc-btn:hover .pc-hint{color:var(--text)}
.pc .pc-btn[aria-pressed="true"] .pc-hint{color:var(--text)}
.pc .pc-btn[aria-pressed="true"] .pc-hint::before{background:currentColor}
.pc .pc-hint .pc-h-on{display:none}
.pc .pc-btn[aria-pressed="true"] .pc-hint .pc-h-on{display:inline}
