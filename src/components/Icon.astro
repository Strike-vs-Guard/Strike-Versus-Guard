---
/** Simple line icons, drawn in the current text colour. */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 28 } = Astro.props;
const paths: Record<string, string> = {
  strategy:
    '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M8 7.5l3 8M16 7.5l-3 8M8.5 6h7"/>',
  safety: '<path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  flight: '<path d="M3 17c4-8 8-11 18-12"/><path d="M15 4l6 1-2 5.5"/><circle cx="6" cy="19" r="1.5"/>',
  drones:
    '<circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><path d="M8.2 8.2l7.6 7.6M15.8 8.2l-7.6 7.6"/>',
  integration: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 16l9 5 9-5"/>',
  anywhere: '<circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c2.5 2.5 3.5 5 3.5 8s-1 5.5-3.5 8c-2.5-2.5-3.5-5-3.5-8s1-5.5 3.5-8z"/>',
  agile: '<path d="M13 3L5 13h6l-1 8 8-10h-6z"/>',
  hetero: '<rect x="3" y="14" width="11" height="5" rx="1.5"/><circle cx="6" cy="20.5" r="1.3"/><circle cx="11" cy="20.5" r="1.3"/><circle cx="15" cy="5" r="1.8"/><circle cx="21" cy="5" r="1.8"/><path d="M15 5h6M18 5v4M16 9h4"/>',
  sim: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M7 13l3-4 3 2 4-5"/>',
  decentral: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="17" r="2.2"/><circle cx="19" cy="17" r="2.2"/><path d="M10.8 7l-4.6 8M13.2 7l4.6 8M7.2 17h9.6"/>',
  selfplay: '<path d="M4 9a8 8 0 0 1 14-3l2 2"/><path d="M20 4v4h-4"/><path d="M20 15a8 8 0 0 1-14 3l-2-2"/><path d="M4 20v-4h4"/>',
};
const body = paths[name] ?? paths.drones;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={body}
/>
